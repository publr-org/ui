const AVATAR_SIZE_NAMES = Object.keys(AVATAR_SIZES) as AvatarSize[];
const SIZE_ROW_WRAPPER = "flex items-center gap-4";

export const variants = [
  {
    label: "Derived initials",
    description: "The name is all an avatar needs; initials derive from it.",
    usage: `<Avatar name="Olivia Martin" />`,
    notes: ["“Olivia Martin” renders OM on the one neutral muted surface."],
    Demo: () => <Avatar name="Olivia Martin" />,
    node: { component: "Avatar", props: { name: "Olivia Martin" } },
  },
  {
    label: "Image over initials",
    description: "A portrait absolutely covers the derived initials.",
    usage: `<Avatar name="Olivia Martin">
  <AvatarImage src="/img/olivia.jpg" />
</Avatar>`,
    notes: [
      "CSS layering shows the image when it exists and the initials otherwise.",
      "alt stays empty when a visible name sits beside the avatar.",
    ],
    Demo: () => (
      <Avatar name="Olivia Martin">
        <AvatarImage src={DEMO_PORTRAIT} />
      </Avatar>
    ),
    node: {
      component: "Avatar",
      props: { name: "Olivia Martin" },
      children: [{ component: "AvatarImage", props: { src: DEMO_PORTRAIT } }],
    },
  },
  {
    label: "Presence badge",
    description: "AvatarBadge pins a decorative dot to the avatar corner.",
    usage: `<Avatar name="Olivia Martin">
  <AvatarBadge />
</Avatar>`,
    notes: [
      "The badge is aria-hidden and last in the part order.",
      "The success surface is the shipped treatment; restyle through classes when needed.",
    ],
    Demo: () => (
      <Avatar name="Olivia Martin">
        <AvatarBadge />
      </Avatar>
    ),
    node: {
      component: "Avatar",
      props: { name: "Olivia Martin" },
      children: [{ component: "AvatarBadge", props: {} }],
    },
  },
  {
    label: "Named sizes",
    description: "sm, md, and lg scale the container and its initials together.",
    usage: AVATAR_SIZE_NAMES.map((size) => `<Avatar size="${size}" name="Olivia Martin" />`).join(
      "\n",
    ),
    notes: ["24, 32, and 40 pixels; the initials typography follows the named size."],
    Demo: () => (
      <div class={SIZE_ROW_WRAPPER}>
        {AVATAR_SIZE_NAMES.map((size) => (
          <Avatar size={size} name="Olivia Martin" />
        ))}
      </div>
    ),
    node: {
      fragment: true,
      wrapper: SIZE_ROW_WRAPPER,
      children: AVATAR_SIZE_NAMES.map((size): DemoNode => ({
        component: "Avatar",
        props: { size, name: "Olivia Martin" },
      })),
    },
  },
] satisfies ComponentDemoVariant[];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
): readonly ComponentCanvasChildInstance[] => {
  const value = values[name];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

export const canvas = {
  controls: [
    { name: "name", type: "text", default: "Olivia Martin" },
    { name: "email", type: "text", default: "" },
    {
      name: "size",
      type: "select",
      default: "md",
      options: AVATAR_SIZE_NAMES,
    },
    { name: "classes", type: "text", default: "" },
    {
      name: "children",
      type: "children",
      default: [],
      options: [
        {
          name: "image",
          label: "AvatarImage",
          type: "group",
          controls: [
            { name: "image.src", label: "src", type: "text", default: DEMO_PORTRAIT },
            { name: "image.alt", label: "alt", type: "text", default: "" },
            { name: "image.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "badge",
          label: "AvatarBadge",
          type: "group",
          controls: [{ name: "badge.classes", label: "classes", type: "text", default: "" }],
        },
      ],
    },
  ],
  node: (values) => ({
    component: "Avatar",
    props: {
      name: String(values.name),
      ...(values.email ? { email: String(values.email) } : {}),
      size: String(values.size) as AvatarSize,
      classes: String(values.classes),
    },
    children: childValues(values, "children").map((child): DemoNode => {
      if (child.type === "image") {
        return {
          component: "AvatarImage",
          props: {
            src: stringValue(values, "image.src", child.id),
            alt: stringValue(values, "image.alt", child.id),
            classes: stringValue(values, "image.classes", child.id),
          },
        };
      }
      return {
        component: "AvatarBadge",
        props: { classes: stringValue(values, "badge.classes", child.id) },
      };
    }),
  }),
} satisfies ComponentCanvas;
