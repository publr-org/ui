import { Accordion, type AccordionProps } from "../../../src/components/Accordion/Accordion.ptsx";
import { Button } from "../../../src/components/Button/Button.ptsx";
import { AccordionContent } from "../../../src/components/Accordion/AccordionContent.ptsx";
import { AccordionItem } from "../../../src/components/Accordion/AccordionItem.ptsx";
import { AccordionTrigger } from "../../../src/components/Accordion/AccordionTrigger.ptsx";
import type {
  ComponentCanvas,
  ComponentCanvasChildInstance,
  ComponentDemoMeta,
  ComponentDemoVariant,
  DemoNode,
} from "../../gallery-types";

const usage = `<Accordion defaultValue={["item-1"]}>
  <AccordionItem value="item-1">
    <AccordionTrigger>Is it accessible?</AccordionTrigger>
    <AccordionContent>
      Yes. It adheres to the WAI-ARIA design pattern.
    </AccordionContent>
  </AccordionItem>
</Accordion>`;

export const meta = {
  name: "accordion",
  label: "Accordion",
  source: "src/components/Accordion/Accordion.ptsx",
  kind: "primitive",
  group: "Essentials",
  description: "A portable compound disclosure list with controlled and uncontrolled value state.",
  tags: ["accordion", "disclosure", "button", "panel", "interactive"],
  usage,
  preview: "inspector",
  previewLabel: "Accessible disclosure items",
  docs: {
    purpose: [
      "Accordion groups related disclosure items with single-open or multiple-open behavior.",
      "Its compound parts keep item identity, trigger semantics, and disclosed content explicit.",
    ],
    useWhen: [
      "Several related sections should be independently expanded and collapsed.",
      "Content can be understood from a concise trigger label.",
    ],
    avoidWhen: [
      "Only one disclosure exists; native details may be sufficient.",
      "Changing sections should replace a single panel rather than reveal content in place; use Tabs.",
    ],
    rules: [
      {
        title: "Give every item a stable value",
        description:
          "AccordionItem.value is the identity used by value, defaultValue, and onValueChange.",
      },
      {
        title: "Compose Trigger before Content",
        description: "Each item contains one AccordionTrigger followed by its AccordionContent.",
      },
      {
        title: "Adopt a trigger deliberately",
        description:
          "AccordionTrigger asChild merges disclosure behavior onto exactly one Element child; that child must provide appropriate interactive semantics.",
      },
      {
        title: "defaultValue is initial state",
        description:
          "Omit it to start with every item closed. When supplied, it chooses the initially open items and the Accordion owns later uncontrolled interaction.",
      },
      {
        title: "value is controlled state",
        description:
          "When value is supplied, update it from onValueChange. Until then, the rendered panels remain aligned with the supplied array.",
      },
    ],
    accessibility: [
      "By default AccordionTrigger renders a native button with aria-expanded and aria-controls linked to its panel.",
      "With asChild, the adopted trigger element must remain keyboard accessible; Button is the normal choice.",
      "Use concise trigger text that identifies the content it reveals.",
      "The chevron is decorative and hidden from assistive technology by Icon.",
    ],
    composition: [
      "Accordion accepts AccordionItem children.",
      "AccordionItem composes AccordionTrigger and AccordionContent in that order.",
      "Trigger and Content accept visible Publr JSX children rather than title or body shorthand props.",
    ],
    agentNotes: [
      "Use values that are unique within one Accordion.",
      "Use multiple when more than one item may stay open.",
      "Do not pass value and defaultValue together; value selects controlled state.",
      "Listen to onValueChange for the complete array of currently open values.",
    ],
    props: [
