import { INPUT_MODES, INPUT_TYPES } from "../../../src/components/Input/Input.ptsx";
import type { ComponentCanvas, ComponentDemoMeta, DemoNode } from "../../gallery-types";

export const meta = {
  name: "input",
  label: "Input",
  source: "src/components/Input/Input.ptsx",
  kind: "primitive",
  group: "Forms",
  description: "A styled native single-line form control.",
  tags: ["input", "form", "field"],
  usage: `<Input id="email" name="email" type="email" placeholder="you@example.com" aria-label="Email address" />`,
  preview: "canvas",
  previewLabel: "Native form inputs",
  docs: {
    purpose: [
      "Input provides the shared visual and validation treatment for native single-line form controls.",
      "It stays dumb and parent-controlled; Field owns labels, descriptions, and errors.",
    ],
    useWhen: ["Collecting a single-line native form value.", "Composing a control inside Field."],
    avoidWhen: [
      "Collecting multiline content; use Textarea.",
      "Building checkbox or radio behavior; use their dedicated components.",
    ],
    rules: [
      {
        title: "Keep form composition outside",
        description: "Input does not accept label, description, or error-message props.",
      },
      {
        title: "Use semantic invalid state",
        description: "invalid owns the destructive border and aria-invalid state.",
      },
    ],
    accessibility: [
      "Associate Input with FieldLabel through id/htmlFor or provide another native accessible name.",
      "For an isolated control that cannot use FieldLabel, pass aria-label directly with native hyphenated syntax.",
      "Native type, required, disabled, readonly, constraints, and keyboard behavior are preserved.",
    ],
    composition: ["Use Field, FieldLabel, and FieldDescription for complete form rows."],
    agentNotes: [
      "Do not restore the former compact inspector readout under this name.",
      "Do not author Publr transport props; use values and callbacks directly.",
    ],
    props: [
      {
        name: "type",
        type: INPUT_TYPES.join(" | "),
        description: "Closed native input type set.",
        default: '"text"',
      },
      {
        name: "id",
        type: "string",
        description: "Optional identifier applied to the native input.",
      },
      {
        name: "name",
        type: "string",
        description: "Native form field name.",
      },
      {
        name: "value",
        type: "string",
        description: "Controlled native input value.",
      },
      {
        name: "placeholder",
        type: "string",
        description: "Native placeholder text.",
      },
      {
        name: "disabled",
        type: "boolean",
        description: "Native disabled state.",
        default: "false",
      },
      {
        name: "invalid",
        type: "boolean",
        description: "Semantic validation state and aria-invalid source.",
        default: "false",
      },
      {
        name: "required",
        type: "boolean",
        description: "Native required state.",
        default: "false",
      },
      {
        name: "readOnly",
        type: "boolean",
        description: "Native readonly state.",
        default: "false",
      },
      {
        name: "autocomplete",
        type: "string",
        description: "Native autocomplete hint.",
      },
      { name: "min", type: "string", description: "Native minimum constraint." },
      { name: "max", type: "string", description: "Native maximum constraint." },
      { name: "step", type: "string", description: "Native step constraint." },
      { name: "minLength", type: "number", description: "Native minimum length constraint." },
      { name: "maxLength", type: "number", description: "Native maximum length constraint." },
      {
        name: "inputMode",
        type: INPUT_MODES.join(" | "),
        description: "Closed native virtual-keyboard hint.",
      },
      {
        name: "classes",
        type: "string",
        description: "Additional classes merged into the native input.",
      },
      {
        name: "onInput",
        type: "(event: Event) => void",
        description: "Parent-owned native input callback.",
      },
      {
        name: "onChange",
        type: "(event: Event) => void",
        description: "Parent-owned native change callback.",
      },
    ],
  },
} satisfies ComponentDemoMeta;

// Declarative, so the DOM and ZSX targets render the same thing. The width cap
// is demo-only layout, so it lives on the wrapper the frame applies to both
// rather than inside the demo, where only one target would see it.
export const node = {
  component: "Input",
  props: {
    type: "email",
    name: "email",
    placeholder: "you@example.com",
    "aria-label": "Email address",
  },
  wrapper: "w-full max-w-sm",
} satisfies DemoNode;

export const canvas = {
  controls: [
    { name: "type", type: "select", default: "text", options: INPUT_TYPES },
    { name: "id", type: "text", default: "demo-input" },
    { name: "name", type: "text", default: "demoInput" },
    { name: "value", type: "text", default: "" },
    { name: "aria-label", label: "aria-label", type: "text", default: "Demo input" },
    { name: "placeholder", type: "text", default: "Type a value" },
    { name: "disabled", type: "boolean", default: false },
    { name: "invalid", type: "boolean", default: false },
    { name: "required", type: "boolean", default: false },
    { name: "readOnly", type: "boolean", default: false },
    { name: "autocomplete", type: "text", default: "" },
    { name: "min", type: "text", default: "" },
    { name: "max", type: "text", default: "" },
    { name: "step", type: "text", default: "" },
    { name: "minLength", type: "text", default: "" },
    { name: "maxLength", type: "text", default: "" },
    { name: "inputMode", type: "select", default: "text", options: INPUT_MODES },
    { name: "classes", type: "text", default: "", placeholder: "e.g. max-w-xs" },
  ],
  node: (values) => {
    const optionalString = (name: string) => {
      const value = String(values[name]);
      return value ? { [name]: value } : {};
    };
    const optionalNumber = (name: string) => {
      const value = String(values[name]);
      return value ? { [name]: Number(value) } : {};
    };
    return {
      component: "Input",
      props: {
        type: String(values.type) as (typeof INPUT_TYPES)[number],
        ...optionalString("id"),
        ...optionalString("name"),
        value: String(values.value),
        ...optionalString("aria-label"),
        ...optionalString("placeholder"),
        disabled: Boolean(values.disabled),
        invalid: Boolean(values.invalid),
        required: Boolean(values.required),
        readOnly: Boolean(values.readOnly),
        ...optionalString("autocomplete"),
        ...optionalString("min"),
        ...optionalString("max"),
        ...optionalString("step"),
        ...optionalNumber("minLength"),
        ...optionalNumber("maxLength"),
        ...optionalString("inputMode"),
        classes: String(values.classes),
      },
      wrapper: "w-full max-w-sm",
    };
  },
} satisfies ComponentCanvas;
