      props: {},
      children: [
        {
          component: "Icon",
          props: { name: "folder", size: "lg", classes: "text-muted-foreground" },
        },
      ],
    },
    { component: "EmptyTitle", props: { children: "No posts yet" } },
    {
      component: "EmptyDescription",
      props: { children: "Create your first post to get started." },
    },
    {
      component: "EmptyContent",
      props: {},
      children: [{ component: "Button", props: { children: "Create post" } }],
    },
  ],
};

