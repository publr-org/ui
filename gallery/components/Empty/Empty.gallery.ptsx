] satisfies ComponentDemoVariant[];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const numberValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): number =>
  Number(values[scopedValue(scope, name)] ?? 0);
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
): readonly ComponentCanvasChildInstance[] => {
  const value = values[name];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

export const canvas = {
  controls: [
    { name: "classes", type: "text", default: "" },
    {
      name: "children",
      type: "children",
      default: ["media", "title", "description", "content"],
      options: [
        {
          name: "media",
          label: "EmptyMedia",
          type: "group",
          controls: [
            { name: "media.icon", label: "icon", type: "text", default: "folder" },
            { name: "media.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "title",
          label: "EmptyTitle",
          labelControl: "title.children",
          type: "group",
          controls: [
            { name: "title.children", label: "children", type: "text", default: "No posts yet" },
            { name: "title.level", label: "level", type: "number", default: 3, min: 1, max: 6 },
            { name: "title.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "description",
          label: "EmptyDescription",
          labelControl: "description.children",
          type: "group",
          controls: [
            {
              name: "description.children",
              label: "children",
              type: "text",
              default: "Create your first post to get started.",
            },
            { name: "description.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "content",
          label: "EmptyContent",
          labelControl: "content.action",
          type: "group",
          controls: [
            { name: "content.action", label: "action", type: "text", default: "Create post" },
            { name: "content.classes", label: "classes", type: "text", default: "" },
          ],
        },
      ],
    },
  ],
  node: (values) => ({
    component: "Empty",
    props: { classes: String(values.classes) },
    wrapper: "w-full",
    children: childValues(values, "children").map((child): DemoNode => {
      if (child.type === "media") {
        return {
          component: "EmptyMedia",
          props: { classes: stringValue(values, "media.classes", child.id) },
          children: [
            {
              component: "Icon",
              props: {
                name: stringValue(values, "media.icon", child.id) || "folder",
                size: "lg",
                classes: "text-muted-foreground",
              },
            },
          ],
        };
      }
      if (child.type === "title") {
        return {
          component: "EmptyTitle",
          props: {
            children: stringValue(values, "title.children", child.id),
            level: numberValue(values, "title.level", child.id) || 3,
            classes: stringValue(values, "title.classes", child.id),
          },
        };
      }
      if (child.type === "description") {
        return {
          component: "EmptyDescription",
          props: {
            children: stringValue(values, "description.children", child.id),
            classes: stringValue(values, "description.classes", child.id),
          },
        };
      }
      return {
        component: "EmptyContent",
        props: { classes: stringValue(values, "content.classes", child.id) },
        children: [
          {
            component: "Button",
            props: { children: stringValue(values, "content.action", child.id) },
          },
        ],
      };
    }),
  }),
} satisfies ComponentCanvas;
