import { TreeItem } from "../../../src/components/TreeItem/TreeItem.ptsx";
import type { ComponentDemoMeta } from "../../gallery-types";

export const meta = {
  name: "tree-item",
  label: "TreeItem",
  source: "src/components/TreeItem/TreeItem.ptsx",
  kind: "composite",
  group: "Editor",
  description: "One row of a flattened tree: a toggle, an icon, the name, a tag and a quiet detail.",
  tags: ["tree", "outline", "list view", "editor"],
  usage: `<TreeItem id="b1" depth={0} label="Heading" icon="heading-level-1" detail="Welcome" />`,
  preview: "demo",
  previewLabel: "TreeItem as the editor uses it",
  docs: {
    purpose: ["Shows nested things as indented rows: a document's blocks, a design's structure."],
    useWhen: ["The caller flattens a tree and owns opening, selecting and dragging."],
    avoidWhen: ["A plain list of links; use FolderNav or ItemList."],
    rules: [{ title: "Default look only", description: "Pass data through props; never restyle it from the app." }],
    accessibility: ["The toggle is a button named Toggle children with aria-expanded; the row is a button."],
    composition: ["Built from Icon and Text; rows stack in the caller's list."],
    agentNotes: ["Do not restyle it from the app; change this component."],
    props: [
      { name: "id", type: "string", description: "The row's thing (data-tree-row).", required: true },
      { name: "depth", type: "number", description: "How deep it sits.", required: true },
      { name: "label", type: "string", description: "Its name.", required: true },
      { name: "icon", type: "IconName", description: "Its icon.", required: true },
      { name: "detail", type: "string", description: "A quiet detail after the name." },
      { name: "tag", type: "string", description: "A small uppercase tag." },
      { name: "identity", type: '"plain" | "pattern" | "part"', description: "Tints a row standing for a reusable unit.", default: "plain" },
      { name: "toggle", type: "boolean", description: "The disclosure column.", default: "true" },
    ],
  },
} satisfies ComponentDemoMeta;

export function Demo() {
  return (
    <div class="w-80">
      <TreeItem id="a" depth={0} label="Home hero" icon="pattern" identity="pattern" hasChildren expanded />
      <TreeItem id="b" depth={1} label="Heading" icon="heading-level-1" detail="Make your house a home" />
      <TreeItem id="c" depth={1} label="Paragraph" icon="paragraph" selected />
      <TreeItem id="d" depth={0} label="Stack" icon="stack" tag="Container" hasChildren />
      <TreeItem id="e" depth={0} label="Site footer" icon="pattern" identity="part" />
    </div>
  );
}
