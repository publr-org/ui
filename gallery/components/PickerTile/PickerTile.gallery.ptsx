export function Demo() {
  return (
    <div class="grid w-80 grid-cols-3">
      <PickerTile icon="heading" label="Heading" value="heading" />
      <PickerTile icon="paragraph" label="Paragraph" value="paragraph" />
      <PickerTile icon="list" label="List" value="list" />
      <PickerTile size="sm" icon="pattern" label="Pattern" value="pattern" />
      <PickerTile size="sm" icon="image" label="Image" value="image" />
      <PickerTile size="sm" icon="quote" label="Quote" value="quote" />
    </div>
