const usage = `<Drawer>
  <DrawerTrigger asChild>
    <Button hierarchy="secondary">Asset details</Button>
  </DrawerTrigger>
  <DrawerContent>
    <DrawerHeader>
      <DrawerTitle>sunset.jpg</DrawerTitle>
      <DrawerClose asChild>
        <Button hierarchy="tertiary" label="Close details">
          <Icon name="x-close" size="sm" />
        </Button>
      </DrawerClose>
    </DrawerHeader>
    <Text as="p" variant="body-sm" tone="muted" classes="p-4">
      1.2 MB · 3840 × 2160 · public
    </Text>
  </DrawerContent>
</Drawer>`;

