import {
  Select,
  SelectContent,
  SelectGroup,
  SelectItem,
  SelectLabel,
  SelectSeparator,
  SelectTrigger,
  SelectValue,
} from "../../../src/components/Select/Select.ptsx";
import type {
  ComponentCanvas,
  ComponentCanvasChildInstance,
  ComponentDemoMeta,
  ComponentDemoVariant,
  DemoNode,
} from "../../gallery-types";

export const meta = {
  name: "select",
  label: "Select",
  source: "src/components/Select/Select.ptsx",
  kind: "primitive",
  group: "Essentials",
  description:
    "A composable select with a portaled listbox, horizontal edge alignment, and collision handling.",
  tags: ["form", "listbox", "overlay", "keyboard"],
  usage: `<Select name="fruit" defaultValue="banana">
  <SelectTrigger>
    <SelectValue>Select a fruit</SelectValue>
  </SelectTrigger>
  <SelectContent>
    <SelectItem value="apple">Apple</SelectItem>
    <SelectItem value="banana">Banana</SelectItem>
  </SelectContent>
</Select>`,
  preview: "inspector",
  previewLabel: "Controlled listbox select",
  docs: {
    purpose: [
      "Select presents a closed set of options through a styled listbox rather than a native control, so option rows can carry grouping, labels, separators, and a selection indicator.",
      "It is controlled: the parent owns the current value and Select reports changes through onChange.",
    ],
    useWhen: [
      "A form field chooses exactly one value from a known list.",
      "The options need grouping, headings, or separators that a native select cannot express.",
    ],
    avoidWhen: [
      "A native select is sufficient; prefer native semantics when the options are a plain list.",
      "Multiple values must be selected, or options are loaded asynchronously by the component itself.",
    ],
    rules: [
      {
        title: "Parts are composed, not configured",
        description:
          "Compose SelectTrigger, SelectValue, SelectContent, SelectGroup, SelectLabel, SelectItem, and SelectSeparator as children rather than passing an options array.",
      },
      {
        title: "Selection is controlled",
        description:
          "Pass value and handle onChange. defaultValue seeds an uncontrolled form-only select.",
      },
      {
        title: "SelectValue is the placeholder",
        description:
          "Its text shows while nothing is selected and is replaced by the selected option's label.",
      },
      {
        title: "Trigger density is composed, not configured",
        description:
          "There is no size prop. Trigger content is composed, so typography comes from Text and density from the trigger's classes escape.",
      },
      {
        title: "Width is automatic until it is capped",
        description:
          "The trigger is as wide as its widest option, so choosing never resizes it. Cap it with a width class on SelectTrigger classes and the selected label truncates instead. The panel follows the trigger unless autoWidth sizes it from its own rows.",
      },
      {
        title: "Alignment is horizontal",
        description:
          "SelectContent align=left joins left edges and align=right joins right edges. The listbox prefers below, may flip above or across on collision, and stays within the viewport.",
      },
    ],
    accessibility: [
      'The trigger is a button carrying aria-haspopup="listbox" and a reactive aria-expanded.',
      "When no visible label names the trigger, pass aria-label directly; universal aria-* and data-* attributes are forwarded to the rendered root.",
      'The panel is role="listbox", option rows are role="option" with aria-selected, and disabled rows carry aria-disabled.',
      "Arrow keys, Home, End, Enter, Space, Escape, Tab, and single-character typeahead drive the list; leaving the component closes it.",
      "Pass id so an external label can target the submitted control.",
    ],
    composition: [
      "Option rows compose Text and Icon rather than repeating typography or drawing their own check mark.",
      'SelectGroup wraps rows in role="group"; SelectLabel heads a group and SelectSeparator divides them.',
    ],
    agentNotes: [
      "Never pass an options array; compose SelectItem children.",
      "Do not add loading or async behavior; the parent owns option data and state.",
      "Keep name set when the value must participate in a form submission.",
    ],
    props: [
      { name: "value", type: "string", description: "Controlled selected value." },
      {
        name: "defaultValue",
        type: "string",
        description: "Initial value when the select is left uncontrolled.",
        default: '""',
      },
      { name: "name", type: "string", description: "Form field name for the submitted value." },
      {
        name: "onChange",
        type: "(value: string) => void",
        description: "Selection notification.",
      },
      {
        name: "children",
        type: "[SelectTrigger, SelectContent]",
        description: "The trigger and the listbox content.",
        required: true,
      },
      { name: "id", type: "string", description: "Identifier applied to the submitted control." },
      { name: "classes", type: "string", description: "Classes merged into the select root." },
      {
        name: "autoWidth",
        type: "boolean",
        description:
          "Sizes the panel from its own rows. When false the panel is at least as wide as the trigger.",
        default: "false",
      },
      {
        name: "disabled",
        type: "boolean",
        description: "Disables the complete select, including its submitted form control.",
        default: "false",
      },
      { name: "SelectTrigger.id", type: "string", description: "Optional trigger identifier." },
      {
        name: "SelectTrigger.classes",
        type: "string",
        description:
          "Trigger escape for density and for capping the auto width, e.g. a compact filter-row trigger.",
      },
      {
        name: "SelectTrigger.asChild",
        type: "boolean",
        description: "Merges trigger behavior onto exactly one Element child.",
        default: "false",
      },
      {
        name: "SelectTrigger.label",
        type: "string",
        description: "Optional accessible name when no visible label names the trigger.",
      },
      {
        name: "SelectTrigger.children",
        type: "SelectValue",
        description: "The value/placeholder component composed inside the trigger.",
        required: true,
      },
      {
        name: "SelectValue.id",
        type: "string",
        description: "Optional identifier applied to the value text root.",
      },
      {
        name: "SelectValue.classes",
        type: "string",
        description: "Exceptional classes applied to the value text root.",
      },
      {
        name: "SelectValue.children",
        type: "string",
        description: "Placeholder text shown while nothing is selected.",
        required: true,
      },
      {
        name: "SelectContent.id",
        type: "string",
        description: "Optional identifier applied to the listbox panel.",
      },
      {
        name: "SelectContent.classes",
        type: "string",
        description: "Listbox panel escape for width and max height.",
      },
      {
        name: "SelectContent.align",
        type: '"left" | "right"',
        description: "Preferred matching trigger edge before collision handling.",
        default: '"left"',
      },
      {
        name: "SelectContent.children",
        type: "SelectItem | SelectGroup | SelectSeparator | readonly child[]",
        description: "Ordered listbox rows, groups, and separators.",
        required: true,
      },
      {
        name: "SelectItem.id",
        type: "string",
        description: "Optional identifier applied to the option row.",
      },
      {
        name: "SelectItem.value",
        type: "string",
        description: "Value submitted and reported when the row is chosen.",
        required: true,
      },
      {
        name: "SelectItem.disabled",
        type: "boolean",
        description: "Marks the row inert and aria-disabled.",
        default: "false",
      },
      {
        name: "SelectItem.classes",
        type: "string",
        description: "Exceptional classes applied to the option row.",
      },
      {
        name: "SelectItem.children",
        type: "string",
        description: "Visible option label.",
        required: true,
      },
      {
        name: "SelectGroup.id",
        type: "string",
        description: "Optional identifier applied to the option group.",
      },
      {
        name: "SelectGroup.classes",
        type: "string",
        description: "Exceptional classes applied to the option group.",
      },
      {
        name: "SelectGroup.children",
        type: "SelectLabel | SelectItem | SelectSeparator | readonly child[]",
        description: "Labelled option rows and optional separators in the group.",
        required: true,
      },
      {
        name: "SelectLabel.id",
        type: "string",
        description: "Optional identifier applied to the group label.",
      },
      {
