const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
): readonly ComponentCanvasChildInstance[] => {
  const value = values[name];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

export const canvas = {
  controls: [
    { name: "page", type: "text", default: "Content" },
    {
      name: "ancestors",
      type: "children",
      allowMultiple: true,
      default: ["ancestor"],
      options: [
        {
          name: "ancestor",
          label: "BreadcrumbLink",
          labelControl: "ancestor.label",
          type: "group",
          controls: [
            { name: "ancestor.label", label: "children", type: "text", default: "Dashboard" },
            { name: "ancestor.href", label: "href", type: "text", default: "#dashboard" },
          ],
        },
      ],
    },
  ],
  node: (values) =>
    trailNode(
      childValues(values, "ancestors").map((child) => ({
        label: stringValue(values, "ancestor.label", child.id),
        href: stringValue(values, "ancestor.href", child.id),
      })),
      String(values.page),
    ),
} satisfies ComponentCanvas;
