const trailNode = (links: Array<{ label: string; href: string }>, page: string): DemoNode => ({
  component: "Breadcrumb",
  props: {},
  children: [
    {
      component: "BreadcrumbList",
      props: {},
      children: [
        ...links.flatMap((link): DemoNode[] => [
          {
            component: "BreadcrumbItem",
            props: {},
            children: [
              { component: "BreadcrumbLink", props: { href: link.href, children: link.label } },
            ],
          },
          { component: "BreadcrumbSeparator", props: {} },
        ]),
        {
          component: "BreadcrumbItem",
          props: {},
          children: [{ component: "BreadcrumbPage", props: { children: page } }],
        },
      ],
    },
  ],
});

