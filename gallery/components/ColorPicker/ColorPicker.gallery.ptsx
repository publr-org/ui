export const node = { component: "ColorPicker", props: {}, wrapper: "w-60" } satisfies DemoNode;

export function Demo() {
  return (
    <div class="flex w-60 flex-col gap-3 rounded-lg bg-popover p-2 text-popover-foreground">
      <GradientStops stops={[{ at: 0, css: "#1779e6", index: 0 }, { at: 1, css: "rgba(23,121,230,0)", index: 1 }]} background="linear-gradient(to right, #1779e6, rgba(23,121,230,0))" selected={0} />
      <ColorPicker hue={212} saturation={0.9} brightness={0.9} alpha={1} hex="1779E6" />
    </div>
  );
}
