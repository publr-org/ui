const textNode = (
  children: string,
  props: Record<string, string | number | boolean> = {},
): DemoNode => ({
  component: "Text",
  props: { variant: "body-md", children, ...props },
});

const canonicalNode = (iconOnly = false): DemoNode => ({
  component: "DropdownMenu",
  wrapper: "flex min-h-0 w-full items-start justify-end",
  props: {},
  children: [
    {
      component: "DropdownMenuTrigger",
      props: { asChild: true },
      children: [
        {
          component: "Button",
          props: iconOnly ? { label: "Options" } : {},
          children: iconOnly
            ? [{ component: "Icon", props: { name: "more", size: "sm" } }]
            : [
                textNode("Actions"),
                { component: "Icon", props: { name: "chevron-down", size: "sm" } },
              ],
        },
      ],
    },
    {
      component: "DropdownMenuContent",
      props: { align: "right", classes: "w-52" },
      children: [
        {
          component: "DropdownMenuItem",
          props: {},
          children: [
            { component: "Icon", props: { name: "duplicate", size: "sm" } },
            textNode("Duplicate"),
            { component: "DropdownMenuShortcut", props: { children: "⌘D" } },
          ],
        },
        { component: "DropdownMenuSeparator", props: {} },
        {
          component: "DropdownMenuItem",
          props: { variant: "destructive" },
          children: [textNode("Delete")],
        },
      ],
    },
  ],
});

function DemoMenu({ iconOnly = false }: { iconOnly?: boolean }) {
  return (
    <div class="flex min-h-0 w-full items-start justify-end" data-dropdown-preview-layout>
      <DropdownMenu>
        <DropdownMenuTrigger asChild>
          <Button label={iconOnly ? "Options" : undefined}>
            {iconOnly ? (
              <Icon name="more" size="sm" />
            ) : (
              <>
                <Text variant="body-md">Actions</Text>
                <Icon name="chevron-down" size="sm" />
              </>
            )}
          </Button>
        </DropdownMenuTrigger>
        <DropdownMenuContent align="right" classes="w-52">
          <DropdownMenuItem>
            <Icon name="duplicate" size="sm" />
            Duplicate
            <DropdownMenuShortcut>⌘D</DropdownMenuShortcut>
          </DropdownMenuItem>
          <DropdownMenuSeparator />
          <DropdownMenuItem variant="destructive">Delete</DropdownMenuItem>
        </DropdownMenuContent>
      </DropdownMenu>
    </div>
  );
}

export const variants = [
  {
    label: "Text trigger",
    description: "The supplied API with a complete Button adopted as the real trigger.",
    usage,
    Demo: () => <DemoMenu />,
    node: canonicalNode(),
  },
  {
    label: "Icon-only trigger",
    description: "asChild preserves the accessible icon-only Button as the actual trigger.",
    usage: `<DropdownMenu>
  <DropdownMenuTrigger asChild>
    <Button label="Options"><Icon name="more" /></Button>
  </DropdownMenuTrigger>
  <DropdownMenuContent align="right">…</DropdownMenuContent>
</DropdownMenu>`,
    Demo: () => <DemoMenu iconOnly />,
    node: canonicalNode(true),
  },
] satisfies ComponentDemoVariant[];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const booleanValue = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): boolean => Boolean(values[scopedValue(scope, name)]);
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): readonly ComponentCanvasChildInstance[] => {
  const value = values[scopedValue(scope, name)];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

