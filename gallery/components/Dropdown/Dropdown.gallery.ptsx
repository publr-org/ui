          controls: [
            { name: "content.id", label: "id", type: "text", default: "" },
            { name: "content.classes", label: "classes", type: "text", default: "" },
            {
              name: "content.align",
              label: "align",
              type: "select",
              default: "right",
              options: ["left", "right"],
            },
            {
              name: "content.children",
              label: "children",
              type: "children",
              allowMultiple: true,
              default: [
                "item",
                "separator",
                {
                  type: "item",
                  values: {
                    "item.variant": "destructive",
                    "item.children": ["itemText"],
                    "itemText.children": "Delete",
                  },
                },
              ],
              options: [
                {
                  name: "item",
                  label: "DropdownMenuItem",
                  type: "group",
                  controls: [
                    { name: "item.id", label: "id", type: "text", default: "" },
                    { name: "item.classes", label: "classes", type: "text", default: "" },
                    {
                      name: "item.variant",
                      label: "variant",
                      type: "select",
                      default: "default",
                      options: ["default", "destructive"],
                    },
                    { name: "item.href", label: "href", type: "text", default: "" },
                    { name: "item.disabled", label: "disabled", type: "boolean", default: false },
                    {
                      name: "item.type",
                      label: "type",
                      type: "select",
                      default: "button",
                      options: ["button", "submit", "reset"],
                    },
                    {
                      name: "item.children",
                      label: "children",
                      type: "children",
                      default: ["itemIcon", "itemText", "shortcut"],
                      options: [
                        {
                          name: "itemIcon",
                          label: "Icon",
                          type: "group",
                          controls: [
                            {
                              name: "itemIcon.name",
                              label: "name",
                              type: "select",
                              default: "duplicate",
                              options: ICON_NAMES,
                            },
                            {
                              name: "itemIcon.size",
                              label: "size",
                              type: "select",
                              default: "md",
                              options: Object.keys(ICON_SIZES),
                            },
                            { name: "itemIcon.id", label: "id", type: "text", default: "" },
                            {
                              name: "itemIcon.classes",
                              label: "classes",
                              type: "text",
                              default: "",
                            },
                          ],
                        },
                        {
                          name: "itemText",
                          label: "Text",
                          type: "group",
                          controls: [
                            {
                              name: "itemText.children",
                              label: "children",
                              type: "text",
                              default: "Duplicate",
                            },
                            {
                              name: "itemText.variant",
                              label: "variant",
                              type: "select",
                              default: "body-md",
                              options: Object.keys(TEXT_VARIANTS),
                            },
                            {
                              name: "itemText.tone",
                              label: "tone",
                              type: "select",
                              default: "default",
                              options: Object.keys(TEXT_TONES),
                            },
                          ],
                        },
                        {
                          name: "shortcut",
                          label: "DropdownMenuShortcut",
                          type: "group",
                          controls: [
                            {
                              name: "shortcut.children",
                              label: "children",
                              type: "text",
                              default: "⌘D",
                            },
                            { name: "shortcut.id", label: "id", type: "text", default: "" },
                            {
                              name: "shortcut.classes",
                              label: "classes",
                              type: "text",
                              default: "",
                            },
                          ],
                        },
                      ],
                    },
                  ],
                },
                {
                  name: "separator",
                  label: "DropdownMenuSeparator",
                  type: "group",
                  controls: [
                    { name: "separator.id", label: "id", type: "text", default: "" },
                    { name: "separator.classes", label: "classes", type: "text", default: "" },
                  ],
                },
              ],
            },
          ],
        },
      ],
    },
  ],
  node: (values) => {
    const text = (scope: string, name: string) => stringValue(values, name, scope);
    const on = (scope: string, name: string) => booleanValue(values, name, scope);
    const children = (scope: string, name: string) => childValues(values, name, scope);

    const makeText = (instance: ComponentCanvasChildInstance, prefix: string): DemoNode =>
      textNode(text(instance.id, `${prefix}.children`), {
        variant: text(instance.id, `${prefix}.variant`) as TextVariant,
        tone: text(instance.id, `${prefix}.tone`) as TextTone,
      });

    const makeItem = (instance: ComponentCanvasChildInstance): DemoNode => {
      const itemChildren = children(instance.id, "item.children").flatMap((child): DemoNode[] => {
        if (child.type === "itemIcon") {
          return [
            {
              component: "Icon",
              props: {
                name: text(child.id, "itemIcon.name"),
                size: text(child.id, "itemIcon.size") as IconSize,
                id: text(child.id, "itemIcon.id"),
                classes: text(child.id, "itemIcon.classes"),
              },
            },
          ];
        }
        if (child.type === "itemText") return [makeText(child, "itemText")];
        if (child.type === "shortcut") {
          return [
            {
              component: "DropdownMenuShortcut",
              props: {
                children: text(child.id, "shortcut.children"),
                id: text(child.id, "shortcut.id"),
                classes: text(child.id, "shortcut.classes"),
              },
            },
          ];
        }
        return [];
      });
      const href = text(instance.id, "item.href");
      return {
        component: "DropdownMenuItem",
        props: {
          variant: text(instance.id, "item.variant"),
          id: text(instance.id, "item.id"),
          classes: text(instance.id, "item.classes"),
          ...(href
            ? { href }
            : {
                disabled: on(instance.id, "item.disabled"),
                type: text(instance.id, "item.type"),
              }),
        },
        children: itemChildren,
      };
    };

    const makeContent = (instance: ComponentCanvasChildInstance): DemoNode => ({
      component: "DropdownMenuContent",
      props: {
        align: text(instance.id, "content.align"),
        id: text(instance.id, "content.id"),
        classes: text(instance.id, "content.classes"),
      },
      children: children(instance.id, "content.children").flatMap((child): DemoNode[] => {
        if (child.type === "item") return [makeItem(child)];
        if (child.type === "separator") {
          return [
            {
              component: "DropdownMenuSeparator",
              props: {
                id: text(child.id, "separator.id"),
                classes: text(child.id, "separator.classes"),
              },
            },
          ];
        }
        return [];
      }),
    });

    const makeTrigger = (instance: ComponentCanvasChildInstance): DemoNode => {
      const button = children(instance.id, "trigger.children").find(
        (child) => child.type === "button",
      );
      const triggerChildren = button
        ? children(button.id, "button.children").flatMap((child): DemoNode[] => {
            if (child.type === "triggerText") {
              return [
                textNode(text(child.id, "triggerText.children"), {
                  as: text(child.id, "triggerText.as") as TextElement,
                  variant: text(child.id, "triggerText.variant") as TextVariant,
                  tone: text(child.id, "triggerText.tone") as TextTone,
                  id: text(child.id, "triggerText.id"),
                  classes: text(child.id, "triggerText.classes"),
                  style: text(child.id, "triggerText.style"),
                }),
              ];
            }
            if (child.type === "triggerIcon") {
              return [
                {
                  component: "Icon",
                  props: {
                    name: text(child.id, "triggerIcon.name"),
                    size: text(child.id, "triggerIcon.size") as IconSize,
                    id: text(child.id, "triggerIcon.id"),
                    classes: text(child.id, "triggerIcon.classes"),
                  },
                },
              ];
            }
            return [];
          })
        : [];
      const props = {
        asChild: Boolean(button) && on(instance.id, "trigger.asChild"),
        id: text(instance.id, "trigger.id"),
        classes: text(instance.id, "trigger.classes"),
      };
      return button && props.asChild
        ? {
            component: "DropdownMenuTrigger",
            props,
            children: [
              {
                component: "Button",
                props: {
                  label: text(button.id, "button.label"),
                  hierarchy: text(button.id, "button.hierarchy") as ButtonHierarchy,
                  intent: text(button.id, "button.intent") as ButtonIntent,
                  size: text(button.id, "button.size") as ButtonSize,
                  title: text(button.id, "button.title"),
                  disabled: on(button.id, "button.disabled"),
                  loading: on(button.id, "button.loading"),
                  id: text(button.id, "button.id"),
                  classes: text(button.id, "button.classes"),
                },
                children: triggerChildren,
              },
            ],
          }
        : { component: "DropdownMenuTrigger", props, children: triggerChildren };
    };

    return {
      component: "DropdownMenu",
      wrapper: "flex w-full items-start justify-end",
      props: { id: text("", "menu.id"), classes: text("", "menu.classes") },
      children: children("", "menu.children").flatMap((child): DemoNode[] =>
        child.type === "trigger"
          ? [makeTrigger(child)]
          : child.type === "content"
            ? [makeContent(child)]
            : [],
      ),
    };
  },
} satisfies ComponentCanvas;
