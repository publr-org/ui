import { BulkActions } from "../../../src/components/BulkActions/BulkActions.ptsx";
import { BulkActionsClear } from "../../../src/components/BulkActions/BulkActionsClear.ptsx";
import { BulkActionsItem } from "../../../src/components/BulkActions/BulkActionsItem.ptsx";
import { BulkActionsSeparator } from "../../../src/components/BulkActions/BulkActionsSeparator.ptsx";
import type { ComponentDemoMeta, ComponentDemoVariant, DemoNode } from "../../gallery-types";

const usage = `<DataTable>
  <BulkActions>
    <BulkActionsItem><Icon name="edit" size="xs" />Edit</BulkActionsItem>
    <BulkActionsItem><Icon name="duplicate" size="xs" />Duplicate</BulkActionsItem>
    <BulkActionsSeparator />
    <BulkActionsItem variant="destructive"><Icon name="trash" size="xs" />Delete</BulkActionsItem>
    <BulkActionsClear />
  </BulkActions>
  <Table>…rows with DataTableRowSelect…</Table>
</DataTable>`;

export const meta = {
  name: "bulk-actions",
