// The bar hides itself without a selection, so the standalone demo unhides it
// with classes — the wrapper the store would otherwise drive.
const CANONICAL_NODE: DemoNode = {
  component: "BulkActions",
  props: { classes: "flex!" },
  wrapper: "w-full",
  children: [
    { component: "BulkActionsItem", props: { children: "Edit" } },
    { component: "BulkActionsItem", props: { children: "Duplicate" } },
    { component: "BulkActionsSeparator", props: {} },
    { component: "BulkActionsItem", props: { variant: "destructive", children: "Delete" } },
    { component: "BulkActionsClear", props: {} },
  ],
};

export const variants = [
  {
    label: "Actions with separator and clear",
    description:
      "Edit and duplicate, a separator, the destructive delete, and the trailing clear control.",
    usage,
    notes: [
      'The demo unhides the bar with classes="flex!"; inside DataTable the store\'s $anySelected drives visibility.',
    ],
    Demo: () => (
      <BulkActions classes="flex!">
        <BulkActionsItem>Edit</BulkActionsItem>
        <BulkActionsItem>Duplicate</BulkActionsItem>
        <BulkActionsSeparator />
        <BulkActionsItem variant="destructive">Delete</BulkActionsItem>
        <BulkActionsClear />
      </BulkActions>
    ),
    node: CANONICAL_NODE,
  },
