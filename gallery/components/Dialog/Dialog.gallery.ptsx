const usage = `<Dialog>
  <DialogTrigger asChild>
    <Button hierarchy="secondary">Delete folder</Button>
  </DialogTrigger>
  <DialogContent>
    <DialogTitle>Delete folder</DialogTitle>
    <DialogDescription>
      Items inside move to the parent folder. This cannot be undone.
    </DialogDescription>
    <div class="mt-5 flex justify-end gap-2">
      <DialogClose asChild>
        <Button hierarchy="secondary">Cancel</Button>
      </DialogClose>
      <Button type="submit" intent="destructive">Delete</Button>
    </div>
  </DialogContent>
</Dialog>`;

