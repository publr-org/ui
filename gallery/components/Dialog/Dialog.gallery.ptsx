// ── Canvas: the full compound API as a recursively editable children tree ───

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const booleanValue = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): boolean => Boolean(values[scopedValue(scope, name)]);
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): readonly ComponentCanvasChildInstance[] => {
  const value = values[scopedValue(scope, name)];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

const buttonGroup = (scope: string, labelDefault: string): ComponentCanvasGroupControl => ({
  name: "button",
  label: "Button",
  type: "group",
  labelControl: `${scope}.text`,
  controls: [
    { name: `${scope}.text`, label: "text", type: "text", default: labelDefault },
    {
      name: `${scope}.hierarchy`,
      label: "hierarchy",
      type: "select",
      default: scope === "close" ? "secondary" : "primary",
      options: BUTTON_HIERARCHIES,
    },
    {
      name: `${scope}.intent`,
      label: "intent",
      type: "select",
      default: "neutral",
      options: BUTTON_INTENTS,
    },
    {
      name: `${scope}.size`,
      label: "size",
      type: "select",
      default: "md",
      options: BUTTON_SIZES,
    },
    { name: `${scope}.disabled`, label: "disabled", type: "boolean", default: false },
    { name: `${scope}.id`, label: "id", type: "text", default: "" },
    { name: `${scope}.classes`, label: "classes", type: "text", default: "" },
  ],
});

const textGroup: ComponentCanvasGroupControl = {
  name: "bodyText",
  label: "Text",
  type: "group",
  labelControl: "bodyText.children",
  controls: [
    {
      name: "bodyText.children",
      label: "text",
      type: "text",
      default: "Composed body copy.",
    },
    {
      name: "bodyText.variant",
      label: "variant",
      type: "select",
      default: "body-sm",
      options: Object.keys(TEXT_VARIANTS),
    },
    {
      name: "bodyText.tone",
      label: "tone",
      type: "select",
      default: "muted",
      options: Object.keys(TEXT_TONES),
    },
    { name: "bodyText.classes", label: "classes", type: "text", default: "mt-4" },
  ],
};

const dialogCanvasControls: readonly ComponentCanvasControl[] = [
  { name: "dialog.id", label: "id", type: "text", default: "" },
  { name: "dialog.classes", label: "classes", type: "text", default: "" },
  {
    name: "dialog.children",
    label: "children",
    type: "children",
    default: [
      { type: "trigger", values: { "trigger.children": ["button"] } },
      {
        type: "content",
        values: { "content.children": ["title", "description", "close"] },
      },
    ],
    options: [
      {
        name: "trigger",
        label: "DialogTrigger",
        type: "group",
        controls: [
          { name: "trigger.asChild", label: "asChild", type: "boolean", default: true },
          { name: "trigger.id", label: "id", type: "text", default: "" },
          { name: "trigger.classes", label: "classes", type: "text", default: "" },
          {
            name: "trigger.children",
            label: "children",
            type: "children",
            default: ["button"],
            options: [buttonGroup("trigger", "Open dialog")],
          },
        ],
      },
      {
        name: "content",
        label: "DialogContent",
        type: "group",
        controls: [
          { name: "content.id", label: "id", type: "text", default: "" },
          { name: "content.classes", label: "classes", type: "text", default: "" },
          {
            name: "content.children",
            label: "children",
            type: "children",
            allowMultiple: true,
            default: ["title", "description", "close"],
            options: [
              {
                name: "title",
                label: "DialogTitle",
                type: "group",
                labelControl: "title.children",
                controls: [
                  { name: "title.children", label: "text", type: "text", default: "Dialog title" },
                  { name: "title.id", label: "id", type: "text", default: "" },
                  { name: "title.classes", label: "classes", type: "text", default: "" },
                ],
              },
              {
                name: "description",
                label: "DialogDescription",
                type: "group",
                labelControl: "description.children",
                controls: [
                  {
                    name: "description.children",
                    label: "text",
                    type: "text",
                    default: "Supporting copy for the dialog body.",
                  },
                  { name: "description.id", label: "id", type: "text", default: "" },
                  { name: "description.classes", label: "classes", type: "text", default: "" },
                ],
              },
              textGroup,
              {
                name: "close",
                label: "DialogClose",
                type: "group",
                controls: [
                  { name: "close.asChild", label: "asChild", type: "boolean", default: true },
                  { name: "close.id", label: "id", type: "text", default: "" },
                  { name: "close.classes", label: "classes", type: "text", default: "mt-5" },
                  {
                    name: "close.children",
                    label: "children",
                    type: "children",
                    default: ["button"],
                    options: [buttonGroup("close", "Cancel")],
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
  },
];

const buttonNode = (
  values: Readonly<Record<string, unknown>>,
  instance: ComponentCanvasChildInstance,
  scope: string,
): DemoNode => ({
  component: "Button",
  props: {
    hierarchy: stringValue(values, `${scope}.hierarchy`, instance.id) as ButtonHierarchy,
    intent: stringValue(values, `${scope}.intent`, instance.id) as ButtonIntent,
    size: stringValue(values, `${scope}.size`, instance.id) as ButtonSize,
    disabled: booleanValue(values, `${scope}.disabled`, instance.id),
    id: stringValue(values, `${scope}.id`, instance.id),
    classes: stringValue(values, `${scope}.classes`, instance.id),
  },
  children: [textNode(stringValue(values, `${scope}.text`, instance.id))],
});

export const canvas = {
  controls: dialogCanvasControls,
  node: (values) => {
    const makeTrigger = (instance: ComponentCanvasChildInstance): DemoNode => {
      const button = childValues(values, "trigger.children", instance.id).find(
        (child) => child.type === "button",
      );
      return {
        component: "DialogTrigger",
        props: {
          asChild: Boolean(button) && booleanValue(values, "trigger.asChild", instance.id),
          id: stringValue(values, "trigger.id", instance.id),
          classes: stringValue(values, "trigger.classes", instance.id),
        },
        children: button
          ? [buttonNode(values, button, "trigger")]
          : [textNode(stringValue(values, "trigger.text", instance.id) || "Open dialog")],
      };
    };

    const makeContent = (instance: ComponentCanvasChildInstance): DemoNode => ({
      component: "DialogContent",
      props: {
        id: stringValue(values, "content.id", instance.id),
        classes: stringValue(values, "content.classes", instance.id),
      },
      children: childValues(values, "content.children", instance.id).flatMap(
        (child): DemoNode[] => {
          if (child.type === "title") {
            return [
              {
                component: "DialogTitle",
                props: {
                  children: stringValue(values, "title.children", child.id),
                  id: stringValue(values, "title.id", child.id),
                  classes: stringValue(values, "title.classes", child.id),
                },
              },
            ];
          }
          if (child.type === "description") {
            return [
              {
                component: "DialogDescription",
                props: {
                  children: stringValue(values, "description.children", child.id),
                  id: stringValue(values, "description.id", child.id),
                  classes: stringValue(values, "description.classes", child.id),
                },
              },
            ];
          }
          if (child.type === "bodyText") {
            return [
              {
                component: "Text",
                props: {
                  as: "p",
                  variant: stringValue(values, "bodyText.variant", child.id) as TextVariant,
                  tone: stringValue(values, "bodyText.tone", child.id) as TextTone,
                  classes: stringValue(values, "bodyText.classes", child.id),
                  children: stringValue(values, "bodyText.children", child.id),
                },
              },
            ];
          }
          if (child.type === "close") {
            const button = childValues(values, "close.children", child.id).find(
              (grandchild) => grandchild.type === "button",
            );
            return [
              {
                component: "DialogClose",
                props: {
                  asChild: Boolean(button) && booleanValue(values, "close.asChild", child.id),
                  id: stringValue(values, "close.id", child.id),
                  classes: stringValue(values, "close.classes", child.id),
                },
                children: button ? [buttonNode(values, button, "close")] : [textNode("Cancel")],
              },
            ];
          }
          return [];
        },
      ),
    });

    return {
      component: "Dialog",
      wrapper: "flex w-full items-start justify-center",
      props: {
        id: stringValue(values, "dialog.id"),
        classes: stringValue(values, "dialog.classes"),
      },
      children: childValues(values, "dialog.children").flatMap((child): DemoNode[] =>
        child.type === "trigger"
          ? [makeTrigger(child)]
          : child.type === "content"
            ? [makeContent(child)]
            : [],
      ),
    };
  },
} satisfies ComponentCanvas;
