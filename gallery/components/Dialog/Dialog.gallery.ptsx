    <div class="flex min-h-0 w-full items-start justify-center">
      <Dialog>
        <DialogTrigger asChild>
          <Button hierarchy="secondary">
            <Text variant="body-md">Delete folder</Text>
          </Button>
        </DialogTrigger>
        <DialogContent>
          <DialogTitle>Delete folder</DialogTitle>
          <DialogDescription>
            Items inside move to the parent folder. This cannot be undone.
          </DialogDescription>
          <DialogClose asChild classes="mt-5 mr-2">
            <Button hierarchy="secondary">
              <Text variant="body-md">Cancel</Text>
            </Button>
          </DialogClose>
          <Button intent="destructive" classes="mt-5">
            <Text variant="body-md">Delete</Text>
          </Button>
        </DialogContent>
      </Dialog>
    </div>
  );
}

