const link = (page: string, active = false): DemoNode => ({
  component: "PaginationItem",
  props: {},
  children: [
    {
      component: "PaginationLink",
      props: active
        ? { isActive: true, children: page }
        : { href: `?page=${page}`, children: page },
    },
  ],
});

const CANONICAL_NODE: DemoNode = {
  component: "Pagination",
  props: {},
  wrapper: "w-full",
  children: [
    {
      component: "PaginationContent",
      props: {},
      children: [
        {
          component: "PaginationItem",
          props: {},
          children: [{ component: "PaginationPrevious", props: { href: "?page=4" } }],
        },
        link("1"),
        {
          component: "PaginationItem",
          props: {},
          children: [{ component: "PaginationEllipsis", props: {} }],
        },
        link("4"),
        link("5", true),
        link("6"),
        {
          component: "PaginationItem",
          props: {},
          children: [{ component: "PaginationEllipsis", props: {} }],
        },
        link("20"),
        {
          component: "PaginationItem",
          props: {},
          children: [{ component: "PaginationNext", props: { href: "?page=6" } }],
        },
      ],
    },
  ],
};

