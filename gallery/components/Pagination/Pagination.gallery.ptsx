import { Pagination } from "../../../src/components/Pagination/Pagination.ptsx";
import { PaginationContent } from "../../../src/components/Pagination/PaginationContent.ptsx";
import { PaginationEllipsis } from "../../../src/components/Pagination/PaginationEllipsis.ptsx";
import { PaginationItem } from "../../../src/components/Pagination/PaginationItem.ptsx";
import { PaginationLink } from "../../../src/components/Pagination/PaginationLink.ptsx";
import { PaginationNext } from "../../../src/components/Pagination/PaginationNext.ptsx";
import { PaginationPrevious } from "../../../src/components/Pagination/PaginationPrevious.ptsx";
import type { ComponentDemoMeta, ComponentDemoVariant, DemoNode } from "../../gallery-types";

const usage = `<Pagination>
  <PaginationContent>
    <PaginationItem><PaginationPrevious /></PaginationItem>
    <PaginationItem><PaginationLink href="?page=1">1</PaginationLink></PaginationItem>
    <PaginationItem><PaginationEllipsis /></PaginationItem>
    <PaginationItem><PaginationLink href="?page=4">4</PaginationLink></PaginationItem>
    <PaginationItem><PaginationLink isActive={true}>5</PaginationLink></PaginationItem>
    <PaginationItem><PaginationLink href="?page=6">6</PaginationLink></PaginationItem>
    <PaginationItem><PaginationEllipsis /></PaginationItem>
    <PaginationItem><PaginationLink href="?page=20">20</PaginationLink></PaginationItem>
    <PaginationItem><PaginationNext href="?page=6" /></PaginationItem>
  </PaginationContent>
</Pagination>`;

export const meta = {
  name: "pagination",
  label: "Pagination",
  source: "src/components/Pagination/Pagination.ptsx",
  kind: "composite",
