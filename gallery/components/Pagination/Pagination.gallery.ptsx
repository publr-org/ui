      {
        title: "Absent href IS the disabled state",
        description:
          "PaginationPrevious/Next without href render a non-interactive aria-disabled span; there is no separate disabled prop.",
      },
      {
        title: "URLs preserve the view's filters",
        description:
          "Build hrefs from the page's filter-preserving base (search, status, type) and always drop the page param from that base.",
