  usage,
  preview: "toolbar",
  previewLabel: "Windowed pages with ellipsis",
  docs: {
    purpose: [
      "Pagination renders page navigation as real links the server builds — a nav landmark with previous/next controls, page links, and ellipsis for windowed page lists.",
      "It is purely presentational: the page (or its data loader) owns page math, windowing, and URL construction, including preserved filters.",
    ],
    useWhen: ["A server-paged list needs page navigation.", "Page URLs are known at render time."],
    avoidWhen: [
      "Client-side paging of already-loaded rows — that is DataTable/store territory.",
      "Infinite scrolling or load-more patterns.",
    ],
    rules: [
      {
        title: "The current page is not a link",
        description:
          'PaginationLink with isActive renders a span with aria-current="page"; navigating to the page you are on is not an action.',
