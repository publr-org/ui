const entryRowNode = ([id, title, type, status]: EntryRow): DemoNode => ({
  component: "DataTableRow",
  props: { rowId: id, searchText: `${title} ${type} ${status}`.toLowerCase() },
  children: [
    {
      component: "TableCell",
      props: { classes: "w-12" },
      children: [{ component: "DataTableRowSelect", props: {} }],
    },
    { component: "TableCell", props: { classes: "font-medium", children: title } },
    { component: "DataTableCell", props: { column: "type", children: type } },
    { component: "DataTableCell", props: { column: "status" }, children: [statusNode(status)] },
  ],
});

function statusNode(status: string): DemoNode {
  return {
    component: "Status",
    props: { tone: status === "Published" ? "success" : "neutral", children: status },
  };
}

const CANONICAL_NODE: DemoNode = {
  component: "DataTable",
  props: {},
  wrapper: "w-full",
  children: [
    {
      component: "DataTableFilter",
      props: { placeholder: "Filter entries…", classes: "m-3 max-w-xs" },
    },
    {
      component: "Table",
      props: {},
      children: [
        {
          component: "TableHeader",
          props: {},
          children: [
            {
              component: "TableRow",
              props: {},
              children: [
                {
                  component: "TableHead",
                  props: { classes: "w-12" },
                  children: [{ component: "DataTableSelectAll", props: {} }],
                },
                { component: "TableHead", props: { children: "Title" } },
                { component: "DataTableHead", props: { column: "type", children: "Type" } },
                { component: "DataTableHead", props: { column: "status", children: "Status" } },
              ],
            },
          ],
        },
        { component: "TableBody", props: {}, children: ENTRIES.map(entryRowNode) },
      ],
    },
  ],
};

export const variants = [
  {
    label: "Selection and quick filter",
    description:
      "The canonical entries list: tri-state select-all, per-row selection, and an instant filter over the rendered rows.",
    usage,
    notes: [
      "Type in the filter to narrow rows; select rows to see the tri-state select-all.",
      "Bulk bars and counts are call-site markup bound to the store vocabulary.",
    ],
    Demo: () => (
      <DataTable>
        <DataTableFilter placeholder="Filter entries…" classes="m-3 max-w-xs" />
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead classes="w-12">
                <DataTableSelectAll />
              </TableHead>
              <TableHead>Title</TableHead>
              <DataTableHead column="type">Type</DataTableHead>
              <DataTableHead column="status">Status</DataTableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {ENTRIES.map((entry) => (
              <DataTableRow rowId={entry[0]} searchText={`${entry[1]} ${entry[2]} ${entry[3]}`.toLowerCase()}>
                <TableCell classes="w-12">
                  <DataTableRowSelect />
                </TableCell>
                <TableCell classes="font-medium">{entry[1]}</TableCell>
                <DataTableCell column="type">{entry[2]}</DataTableCell>
                <DataTableCell column="status">
                  <Status tone={entry[3] === "Published" ? "success" : "neutral"}>{entry[3]}</Status>
                </DataTableCell>
              </DataTableRow>
            ))}
          </TableBody>
        </Table>
      </DataTable>
    ),
    node: CANONICAL_NODE,
  },
] satisfies ComponentDemoVariant[];

const canvasEntryRow = ([id, title, type, status]: EntryRow, rowSelectLabel: string): DemoNode => ({
  component: "DataTableRow",
  props: { rowId: id, searchText: `${title} ${type} ${status}`.toLowerCase() },
  children: [
    {
      component: "TableCell",
      props: { classes: "w-12" },
      children: [{ component: "DataTableRowSelect", props: { label: rowSelectLabel } }],
    },
    { component: "TableCell", props: { classes: "font-medium", children: title } },
    { component: "DataTableCell", props: { column: "type", children: type } },
    { component: "DataTableCell", props: { column: "status" }, children: [statusNode(status)] },
  ],
});

export const canvas = {
  controls: [
    { name: "classes", type: "text", default: "" },
    {
      name: "filter.placeholder",
      label: "filter placeholder",
      type: "text",
      default: "Filter entries…",
    },
    { name: "filter.label", label: "filter label", type: "text", default: "Filter rows" },
    { name: "filter.value", label: "filter value", type: "text", default: "" },
    {
      name: "selectAll.label",
      label: "select-all label",
      type: "text",
      default: "Select all rows",
    },
    { name: "rowSelect.label", label: "row-select label", type: "text", default: "Select row" },
  ],
  node: (values) => ({
    component: "DataTable",
    props: { classes: String(values.classes) },
    wrapper: "w-full",
    children: [
      {
        component: "DataTableFilter",
        props: {
          placeholder: String(values["filter.placeholder"]),
          label: String(values["filter.label"]),
          ...(String(values["filter.value"]) ? { value: String(values["filter.value"]) } : {}),
          classes: "m-3 max-w-xs",
        },
      },
      {
        component: "Table",
        props: {},
        children: [
          {
            component: "TableHeader",
            props: {},
            children: [
              {
                component: "TableRow",
                props: {},
                children: [
                  {
                    component: "TableHead",
                    props: { classes: "w-12" },
                    children: [
                      {
                        component: "DataTableSelectAll",
                        props: { label: String(values["selectAll.label"]) },
                      },
                    ],
                  },
                  { component: "TableHead", props: { children: "Title" } },
                  { component: "DataTableHead", props: { column: "type", children: "Type" } },
                  { component: "DataTableHead", props: { column: "status", children: "Status" } },
                ],
              },
            ],
          },
          {
            component: "TableBody",
            props: {},
            children: ENTRIES.map((entry) =>
              canvasEntryRow(entry, String(values["rowSelect.label"])),
            ),
          },
        ],
      },
    ],
  }),
} satisfies ComponentCanvas;
