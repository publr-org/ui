import { DataTable } from "../../../src/components/DataTable/DataTable.ptsx";
import { DataTableCell } from "../../../src/components/DataTable/DataTableCell.ptsx";
import { DataTableFilter } from "../../../src/components/DataTable/DataTableFilter.ptsx";
import { DataTableHead } from "../../../src/components/DataTable/DataTableHead.ptsx";
import { DataTableRow } from "../../../src/components/DataTable/DataTableRow.ptsx";
import { DataTableRowSelect } from "../../../src/components/DataTable/DataTableRowSelect.ptsx";
import { DataTableSelectAll } from "../../../src/components/DataTable/DataTableSelectAll.ptsx";
import { Status } from "../../../src/components/Status/Status.ptsx";
import { Table } from "../../../src/components/Table/Table.ptsx";
import { TableBody } from "../../../src/components/Table/TableBody.ptsx";
import { TableCell } from "../../../src/components/Table/TableCell.ptsx";
import { TableHead } from "../../../src/components/Table/TableHead.ptsx";
import { TableHeader } from "../../../src/components/Table/TableHeader.ptsx";
import { TableRow } from "../../../src/components/Table/TableRow.ptsx";
import type {
  ComponentCanvas,
  ComponentDemoMeta,
  ComponentDemoVariant,
  DemoNode,
} from "../../gallery-types";

const usage = `<DataTable>
  <div class="flex items-center gap-2 border-b border-border px-5 py-3">
    <DataTableFilter placeholder="Filter entries…" classes="max-w-xs" />
    <span class="ml-auto text-sm text-muted-foreground">
      <span :text="$selectedCount"></span> selected
    </span>
  </div>
  <Table>
    <TableHeader>
      <TableRow>
        <TableHead classes="w-12"><DataTableSelectAll /></TableHead>
        <TableHead>Title</TableHead>
        <DataTableHead column="status">Status</DataTableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      <DataTableRow rowId="1" searchText="hello world draft">
        <TableCell classes="w-12"><DataTableRowSelect /></TableCell>
        <TableCell>Hello world</TableCell>
        <DataTableCell column="status">Draft</DataTableCell>
      </DataTableRow>
    </TableBody>
  </Table>
</DataTable>`;

type EntryRow = readonly [id: string, title: string, type: string, status: string];

const ENTRIES: readonly EntryRow[] = [
  ["1", "Welcome to Publr", "Page", "Published"],
  ["2", "Autumn release notes", "Article", "Draft"],
  ["3", "Pricing overview", "Page", "Draft"],
  ["4", "Interview: design systems", "Article", "Published"],
];

export const meta = {
  name: "data-table",
  label: "DataTable",
  source: "src/components/DataTable/DataTable.ptsx",
  kind: "composite",
  group: "Essentials",
  description:
    "Server-rendered data tables with JSON filtering, search, sorting and history; composed tables also support selection and column visibility.",
  tags: ["table", "data", "selection", "filter", "columns", "list"],
  usage,
  preview: "canvas",
  previewLabel: "Filterable entries with row selection",
  docs: {
    purpose: [
      "DataTable adds interactive behavior — row selection with a tri-state select-all, an instant quick filter, and column hiding — to a composed Table without owning the table markup.",
      "Provide address, columns, rows and filters for a data-driven table. PTSX renders the initial page; PublrJS awaited fetches JSON and updates keyed rows and controls. See docs/data-table.md.",
    ],
    useWhen: [
      "An admin list needs row selection, an instant filter over the rendered page, or hideable columns.",
      "The rows are server-rendered and interactivity must attach to that existing markup.",
    ],
    avoidWhen: [
      "A plain read-only table — compose the Table family directly.",
      "Spreadsheet editing, virtualization, or arbitrary custom cell widgets require a specialized grid.",
    ],
    rules: [
      {
        title: "The quick filter narrows the rendered page only",
        description:
          "filterRows hides non-matching rows that are already on the page. Searching across all pages belongs to the page's server form and query.",
      },
      {
        title: "Select-all scope is the rendered page",
        description:
          "pageSelectionChanged selects or clears every row on the page, including rows the quick filter is currently hiding. Selection resets on server navigation.",
      },
      {
        title: "Hideable columns are opt-in",
        description:
          "Only columns rendered with DataTableHead/DataTableCell (a shared column key) can be hidden. Keep identity columns — selection, title — as plain TableHead/TableCell.",
      },
      {
        title: "Rows carry their own search text",
        description:
          "data-search comes from the rowId'd row's searchText prop. A row without searchText always matches, because it cannot be judged.",
      },
    ],
    accessibility: [
      "The selection controls are native checkboxes (Checkbox) with per-control aria-labels; the select-all mixed state is the real indeterminate property, never a stale aria-checked attribute.",
      "Filtered-out rows get the hidden display class and hidden columns the important hidden! class (it must beat responsive display utilities like md:table-cell); both remove the content from the accessibility tree.",
      "The filter is a native search input named by its label prop.",
    ],
    composition: [
      "Compose Table inside DataTable; put DataTableSelectAll in the header's selection TableHead and DataTableRowSelect in each row's selection TableCell.",
      'Compose BulkActions above the Table for the selection bar, and DataTableColumnToggle items inside a DropdownMenuContent for the column-visibility menu; counts are call-site bindings (:text="$selectedCount" / :text="$visibleCount").',
      "Action names resolve upward through nested stores, so a DropdownMenu column menu inside DataTable reaches toggleColumn without extra wiring.",
    ],
    agentNotes: [
      "The data-driven mode owns reactive rows, filter controls, search and sorting links. The endpoint owns query semantics and returns canonical addresses.",
      "Do not rewrite row visibility imperatively; DataTableRow's hidden-membership class binding (hiddenRowIds) is the only mechanism.",
      "The store emits datatableselectionchange (detail.selectedRowIds) from a revision-gated effect for composition outside the store.",
    ],
