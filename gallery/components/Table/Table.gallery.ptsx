type InvoiceRow = readonly [string, string, string, string];

const INVOICES: readonly InvoiceRow[] = [
  ["INV001", "Paid", "Credit Card", "$250.00"],
  ["INV002", "Pending", "PayPal", "$150.00"],
  ["INV003", "Unpaid", "Bank Transfer", "$350.00"],
];

const invoiceRowNode = ([invoice, status, method, amount]: InvoiceRow): DemoNode => ({
  component: "TableRow",
  props: {},
  children: [
    { component: "TableCell", props: { classes: "font-medium", children: invoice } },
    { component: "TableCell", props: { children: status } },
    { component: "TableCell", props: { children: method } },
    { component: "TableCell", props: { classes: "text-right", children: amount } },
  ],
});

const headerNode: DemoNode = {
  component: "TableHeader",
  props: {},
  children: [
    {
      component: "TableRow",
      props: {},
      children: [
        { component: "TableHead", props: { classes: "w-[100px]", children: "Invoice" } },
        { component: "TableHead", props: { children: "Status" } },
        { component: "TableHead", props: { children: "Method" } },
        { component: "TableHead", props: { classes: "text-right", children: "Amount" } },
      ],
    },
  ],
};

const CANONICAL_NODE: DemoNode = {
  component: "Table",
  props: {},
  wrapper: "w-full",
  children: [
    {
      component: "TableCaption",
      props: { children: "A list of your recent invoices." },
    },
    headerNode,
    { component: "TableBody", props: {}, children: INVOICES.map(invoiceRowNode) },
  ],
};

const InvoiceHeader = () => (
  <TableHeader>
    <TableRow>
      <TableHead classes="w-[100px]">Invoice</TableHead>
      <TableHead>Status</TableHead>
      <TableHead>Method</TableHead>
      <TableHead classes="text-right">Amount</TableHead>
    </TableRow>
  </TableHeader>
);

const InvoiceRows = () => (
  <>
    {INVOICES.map((row) => (
      <TableRow>
        <TableCell classes="font-medium">{row[0]}</TableCell>
        <TableCell>{row[1]}</TableCell>
        <TableCell>{row[2]}</TableCell>
        <TableCell classes="text-right">{row[3]}</TableCell>
      </TableRow>
    ))}
  </>
);

