  ComponentCanvas,
  ComponentCanvasChildDefault,
  ComponentCanvasChildInstance,
  ComponentCanvasGroupControl,
  ComponentDemoMeta,
  ComponentDemoVariant,
  DemoNode,
} from "../../gallery-types";

export const meta = {
  name: "table",
  label: "Table",
  source: "src/components/Table/Table.ptsx",
  kind: "composite",
  group: "Essentials",
  description:
    "Native data table composed from caption, header, body, footer, row, and cell parts.",
  tags: ["table", "data", "rows", "columns", "list"],
  usage: `<Table>
  <TableCaption>A list of your recent invoices.</TableCaption>
  <TableHeader>
    <TableRow>
      <TableHead classes="w-[100px]">Invoice</TableHead>
      <TableHead>Status</TableHead>
