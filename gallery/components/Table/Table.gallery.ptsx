      </Table>
    ),
    node: {
      component: "Table",
      props: {},
      wrapper: "w-full",
      children: [
        headerNode,
        { component: "TableBody", props: {}, children: INVOICES.map(invoiceRowNode) },
        {
          component: "TableFooter",
          props: {},
          children: [
            {
              component: "TableRow",
              props: {},
              children: [
                { component: "TableCell", props: { classes: "font-medium", children: "Total" } },
                { component: "TableCell", props: {} },
                { component: "TableCell", props: {} },
                { component: "TableCell", props: { classes: "text-right", children: "$750.00" } },
              ],
            },
          ],
        },
      ],
    },
  },
  {
    label: "Body only",
    description: "A headerless admin list keeps row semantics without column labels.",
    usage: `<Table>
  <TableBody>
    <TableRow>
      <TableCell classes="font-medium">INV001</TableCell>
      <TableCell>Paid</TableCell>
      <TableCell>Credit Card</TableCell>
      <TableCell classes="text-right">$250.00</TableCell>
    </TableRow>
  </TableBody>
</Table>`,
    notes: ["Omitted sections collapse; the last row drops its border."],
    Demo: () => (
      <Table classes="w-full">
        <TableBody>
          <InvoiceRows />
        </TableBody>
      </Table>
    ),
    node: {
      component: "Table",
      props: {},
      wrapper: "w-full",
      children: [{ component: "TableBody", props: {}, children: INVOICES.map(invoiceRowNode) }],
    },
  },
] satisfies ComponentDemoVariant[];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): readonly ComponentCanvasChildInstance[] => {
  const value = values[scopedValue(scope, name)];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

// The canvas composes the real anatomy recursively: Table accepts caption,
// header, body, and footer sections; sections accept TableRows; rows accept
// TableHead or TableCell cells. One shared row/cell option set keeps the
// duplicate control definitions across sections identical.
const headOption = {
  name: "head",
  label: "TableHead",
  labelControl: "head.children",
  type: "group",
  controls: [
    { name: "head.children", label: "children", type: "text", default: "Column" },
    { name: "head.classes", label: "classes", type: "text", default: "" },
  ],
} satisfies ComponentCanvasGroupControl;

const cellOption = {
  name: "cell",
  label: "TableCell",
  labelControl: "cell.children",
  type: "group",
  controls: [
    { name: "cell.children", label: "children", type: "text", default: "Cell" },
    { name: "cell.classes", label: "classes", type: "text", default: "" },
  ],
} satisfies ComponentCanvasGroupControl;

const rowOption = {
  name: "row",
  label: "TableRow",
  type: "group",
  controls: [
    { name: "row.classes", label: "classes", type: "text", default: "" },
    {
      name: "row.children",
      label: "children",
      type: "children",
      allowMultiple: true,
      default: ["cell", "cell", "cell", "cell"],
      options: [headOption, cellOption],
    },
  ],
} satisfies ComponentCanvasGroupControl;

const sectionOption = (
  name: "header" | "body" | "footer",
  label: string,
  rows: readonly ComponentCanvasChildDefault[],
) =>
  ({
    name,
    label,
    type: "group",
    controls: [
      { name: `${name}.classes`, label: "classes", type: "text", default: "" },
      {
        name: `${name}.children`,
        label: "children",
        type: "children",
        allowMultiple: true,
        default: rows,
        options: [rowOption],
      },
    ],
  }) satisfies ComponentCanvasGroupControl;

const headerRowDefault: ComponentCanvasChildDefault = {
  type: "row",
  values: {
    "row.children": [
      { type: "head", values: { "head.children": "Invoice", "head.classes": "w-[100px]" } },
      { type: "head", values: { "head.children": "Status" } },
      { type: "head", values: { "head.children": "Method" } },
      { type: "head", values: { "head.children": "Amount", "head.classes": "text-right" } },
    ],
  },
};

const invoiceRowDefault = ([
  invoice,
  status,
  method,
  amount,
]: InvoiceRow): ComponentCanvasChildDefault => ({
  type: "row",
  values: {
    "row.children": [
      { type: "cell", values: { "cell.children": invoice, "cell.classes": "font-medium" } },
      { type: "cell", values: { "cell.children": status } },
      { type: "cell", values: { "cell.children": method } },
      { type: "cell", values: { "cell.children": amount, "cell.classes": "text-right" } },
    ],
  },
});

export const canvas = {
  controls: [
    { name: "table.classes", label: "classes", type: "text", default: "" },
    {
      name: "table.children",
      label: "children",
      type: "children",
      default: [
        { type: "caption", values: { "caption.children": "A list of your recent invoices." } },
        { type: "header", values: { "header.children": [headerRowDefault] } },
        { type: "body", values: { "body.children": INVOICES.map(invoiceRowDefault) } },
      ],
      options: [
        {
          name: "caption",
          label: "TableCaption",
          labelControl: "caption.children",
          type: "group",
          controls: [
            {
              name: "caption.children",
              label: "children",
              type: "text",
              default: "A list of your recent invoices.",
            },
            { name: "caption.classes", label: "classes", type: "text", default: "" },
          ],
        },
        sectionOption("header", "TableHeader", [
          { type: "row", values: { "row.children": ["head", "head", "head", "head"] } },
        ]),
        sectionOption("body", "TableBody", ["row"]),
        sectionOption("footer", "TableFooter", ["row"]),
      ],
    },
  ],
  node: (values) => {
    const text = (scope: string, name: string) => stringValue(values, name, scope);
    const children = (scope: string, name: string) => childValues(values, name, scope);

    const rowNode = (row: ComponentCanvasChildInstance): DemoNode => ({
      component: "TableRow",
      props: { classes: text(row.id, "row.classes") },
      children: children(row.id, "row.children").map((cell): DemoNode => ({
        component: cell.type === "head" ? "TableHead" : "TableCell",
        props: {
          children: text(cell.id, `${cell.type}.children`),
          classes: text(cell.id, `${cell.type}.classes`),
        },
      })),
    });

    const sectionComponent = {
      header: "TableHeader",
      body: "TableBody",
      footer: "TableFooter",
    } as const;

    return {
      component: "Table",
      props: { classes: text("", "table.classes") },
      wrapper: "w-full",
      children: children("", "table.children").map((section): DemoNode => {
        if (section.type === "caption") {
          return {
            component: "TableCaption",
            props: {
              children: text(section.id, "caption.children"),
              classes: text(section.id, "caption.classes"),
            },
          };
        }
        const component =
          sectionComponent[section.type as keyof typeof sectionComponent] ?? "TableBody";
        return {
          component,
          props: { classes: text(section.id, `${section.type}.classes`) },
          children: children(section.id, `${section.type}.children`).map(rowNode),
        };
      }),
    };
  },
} satisfies ComponentCanvas;
