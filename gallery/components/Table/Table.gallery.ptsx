    purpose: [
      "Table renders real tabular data with native <table> semantics: rows of records that share a column structure.",
      "The parts mirror the native anatomy — Table, TableCaption, TableHeader, TableBody, TableFooter, TableRow, TableHead, TableCell — and each part owns its chrome, so any section may be omitted.",
      "The root wraps the table in a fixed overflow container so wide tables scroll horizontally instead of breaking the page.",
    ],
    useWhen: [
      "Records share columns that readers compare across rows — admin lists, invoices, entries, reports.",
      "Column headers carry meaning and assistive technology should announce cell/header relationships.",
    ],
    avoidWhen: [
      "The layout is a grid of unrelated content; compose native elements with layout utilities instead.",
      "There is exactly one column; that is a list, not a table.",
      "The view has no rows to show; render Empty instead of an empty body.",
    ],
    rules: [
      {
        title: "Parts compose in native order",
        description:
          "TableCaption, then TableHeader, TableBody, and optionally TableFooter inside Table; rows hold TableHead cells in the header and TableCell cells elsewhere. The caption element renders below the rows via caption-bottom.",
      },
      {
        title: "Sections own separators, rows own hover",
        description:
          "TableHeader and TableFooter draw the section borders; TableRow draws the between-row border, drops it on the last row of a section, and owns the hover fill.",
      },
      {
        title: "Column layout is caller classes",
        description:
          "Width (w-[100px]) and alignment (text-right) are layout, passed through classes on TableHead and the matching TableCell.",
      },
      {
        title: "Cells compose components",
        description:
