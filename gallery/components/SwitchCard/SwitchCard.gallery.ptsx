      { name: "tone", type: "StatusTone", description: "Its dot's colour, and its outline's when current.", default: "neutral" },
      { name: "current", type: "boolean", description: "The one you are in.", default: "false" },
      { name: "size", type: "\"default\" | \"small\"", description: "Small for nested cards.", default: "default" },
      { name: "depth", type: "\"0\" | \"1\" | \"2\" | \"3\"", description: "How many levels in it hangs under the card above.", default: "\"0\"" },
      { name: "onClick", type: "(event) => void", description: "Goes there." },
