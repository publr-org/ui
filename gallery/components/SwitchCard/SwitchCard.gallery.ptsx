  usage: `<SwitchCard title="Acme" description="Your workspace" icon_name="globe" tone="success" current />
<SwitchCard title="Website" description="Live" icon_name="stack" tone="success" size="small" depth="1" />`,
  preview: "demo",
  previewLabel: "Workspaces with their projects nested under each",
  docs: {
    purpose: [
      "Lists places to switch to (workspaces and their projects) where the current one stands out and children hang under their parent.",
    ],
    useWhen: ["A short list of destinations, one of them the current one, nested a few levels deep."],
    avoidWhen: [
      "The destination is a page link with a description; that is LinkCard.",
      "The choice is a form value; that is ChoiceCard.",
