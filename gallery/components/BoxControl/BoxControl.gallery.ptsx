} satisfies ComponentDemoMeta;

export const node = {
  component: "BoxControlNext",
  props: {
    title: "Padding",
    label: "Padding value",
    defaultValue: "0.5rem",
  },
  children: [
    {
      component: "BoxControlIcon",
      props: {},
      children: [{ component: "SelectedSidesIcon", props: { left: true, size: "xl" } }],
    },
    {
      component: "BoxControlRangeScalePicker",
      props: {},
      children: OPTIONS.map((option) => ({
        component: "BoxControlRangeScalePickerOption",
        props: { value: option.value, children: option.label },
      })),
    },
    {
      component: "BoxControlRangePicker",
      props: { min: 0, max: 100, step: 1, label: "Custom padding" },
    },
  ],
} satisfies DemoNode;

export function Demo() {
  return (
    <BoxControl title="Padding" label="Padding value" defaultValue="0.5rem">
      <BoxControlIcon>
        <SelectedSidesIcon left size="xl" />
      </BoxControlIcon>
      <BoxControlRangeScalePicker>
        {OPTIONS.map((option) => (
          <BoxControlRangeScalePickerOption value={option.value}>
            {option.label}
          </BoxControlRangeScalePickerOption>
        ))}
      </BoxControlRangeScalePicker>
      <BoxControlRangePicker min={0} max={100} step={1} label="Custom padding" />
    </BoxControl>
  );
}

export const canvas = {
  controls: [
    { name: "id", type: "text", default: "", placeholder: "Optional root id" },
    { name: "classes", type: "text", default: "", placeholder: "e.g. max-w-md" },
    { name: "title", type: "text", default: "Padding" },
    { name: "label", type: "text", default: "Padding value" },
    {
      name: "defaultValue",
      label: "defaultValue",
      type: "box-value",
      default: "0.5rem",
      namedDefault: "0.5rem",
      arbitraryDefault: [50, "px"],
      unitOptions: CSS_UNITS,
    },
    { name: "disabled", type: "boolean", default: false },
    {
      name: "icon",
      labelControl: "iconComponent",
      type: "group",
      controls: [
        {
          name: "iconComponent",
          label: "component",
          type: "select",
          default: "SelectedSidesIcon",
          options: ["SelectedSidesIcon", "SelectedCornersIcon"],
        },
        { name: "iconId", label: "id", type: "text", default: "" },
        { name: "iconClasses", label: "classes", type: "text", default: "" },
        {
          name: "iconSize",
          label: "size",
          type: "select",
          default: "xl",
          options: ["xs", "sm", "md", "lg", "xl"],
        },
        {
          name: "iconTop",
          label: "top",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedSidesIcon" },
        },
        {
          name: "iconRight",
          label: "right",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedSidesIcon" },
        },
        {
          name: "iconBottom",
          label: "bottom",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedSidesIcon" },
        },
        {
          name: "iconLeft",
          label: "left",
          type: "boolean",
          default: true,
          visibleWhen: { control: "iconComponent", equals: "SelectedSidesIcon" },
        },
        {
          name: "iconTopLeft",
          label: "topLeft",
          type: "boolean",
          default: true,
          visibleWhen: { control: "iconComponent", equals: "SelectedCornersIcon" },
        },
        {
          name: "iconTopRight",
          label: "topRight",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedCornersIcon" },
        },
        {
          name: "iconBottomRight",
          label: "bottomRight",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedCornersIcon" },
        },
        {
          name: "iconBottomLeft",
          label: "bottomLeft",
          type: "boolean",
          default: false,
          visibleWhen: { control: "iconComponent", equals: "SelectedCornersIcon" },
        },
      ],
    },
    {
      name: "rangeScalePicker",
      label: "BoxControlRangeScalePicker",
      type: "group",
      controls: [
        {
          name: "rangeScalePickerOptions",
          label: "children",
          type: "options",
          default: OPTIONS,
        },
      ],
    },
    {
      name: "rangePicker",
      label: "BoxControlRangePicker",
      type: "group",
      controls: [
        { name: "rangePickerMin", label: "min", type: "number", default: 0 },
        { name: "rangePickerMax", label: "max", type: "number", default: 100 },
        {
          name: "rangePickerStep",
          label: "step",
          type: "number",
          default: 1,
          min: 0.01,
          step: 0.01,
        },
        { name: "rangePickerLabel", label: "label", type: "text", default: "Custom padding" },
      ],
    },
  ],
  node: (values) => {
    const defaultValue = Array.isArray(values.defaultValue)
      ? [Number(values.defaultValue[0]), String(values.defaultValue[1])]
      : String(values.defaultValue);
    const options =
      Array.isArray(values.rangeScalePickerOptions) && values.rangeScalePickerOptions.length >= 2
        ? values.rangeScalePickerOptions
        : OPTIONS;
    const isCorners = String(values.iconComponent) === "SelectedCornersIcon";
    const iconProps = {
      id: String(values.iconId) || undefined,
      classes: String(values.iconClasses),
      size: String(values.iconSize),
      ...(isCorners
        ? {
            topLeft: Boolean(values.iconTopLeft),
            topRight: Boolean(values.iconTopRight),
            bottomRight: Boolean(values.iconBottomRight),
            bottomLeft: Boolean(values.iconBottomLeft),
          }
        : {
            top: Boolean(values.iconTop),
            right: Boolean(values.iconRight),
            bottom: Boolean(values.iconBottom),
            left: Boolean(values.iconLeft),
          }),
    };
    return {
      component: "BoxControlNext",
      props: {
        id: String(values.id) || undefined,
        classes: String(values.classes),
        title: String(values.title),
        label: String(values.label),
        defaultValue,
        disabled: Boolean(values.disabled),
      },
      children: [
        {
          component: "BoxControlIcon",
          props: {},
          children: [
            {
              component: isCorners ? "SelectedCornersIcon" : "SelectedSidesIcon",
              props: iconProps,
            },
          ],
        },
        {
          component: "BoxControlRangeScalePicker",
          props: {},
          children: options.map((option) => ({
            component: "BoxControlRangeScalePickerOption",
            props: { value: option.value, children: option.label },
          })),
        },
        {
          component: "BoxControlRangePicker",
          props: {
            min: Number(values.rangePickerMin),
            max: Number(values.rangePickerMax),
            step: Number(values.rangePickerStep),
            label: String(values.rangePickerLabel),
          },
        },
      ],
    };
  },
} satisfies ComponentCanvas;
