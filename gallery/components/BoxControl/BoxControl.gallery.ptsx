import { CSS_UNITS } from "../../../src/components/UnitControl/UnitControl.ptsx";
import {
  BoxControl,
  BoxControlIcon,
  BoxControlRangePicker,
  BoxControlRangeScalePicker,
  BoxControlRangeScalePickerOption,
} from "../../../src/components/BoxControl/BoxControl.next.ptsx";
import { SelectedSidesIcon } from "../../../src/components/SelectedSidesIcon/SelectedSidesIcon.ptsx";
import type { ComponentCanvas, ComponentDemoMeta, DemoNode } from "../../gallery-types";

const OPTIONS = [
  { label: "None", value: "" },
  { label: "2XS", value: "0.25rem" },
  { label: "XS", value: "0.5rem" },
  { label: "S", value: "0.75rem" },
  { label: "M", value: "1rem" },
  { label: "L", value: "1.5rem" },
  { label: "XL", value: "2rem" },
] as const;

const referenceUsage = `<BoxControl
  id="padding-control"
  title="Padding"
  label="Padding value"
  defaultValue="0.5rem"
  onSelectionChange={selectSides}
  onClose={closeControl}
  onInput={previewPadding}
  onChange={commitPadding}
>
  <BoxControlIcon>
    <SelectedSidesIcon left size="xl" />
  </BoxControlIcon>
  <BoxControlRangeScalePicker>
    <BoxControlRangeScalePickerOption value="">None</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="0.25rem">2XS</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="0.5rem">XS</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="0.75rem">S</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="1rem">M</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="1.5rem">L</BoxControlRangeScalePickerOption>
    <BoxControlRangeScalePickerOption value="2rem">XL</BoxControlRangeScalePickerOption>
  </BoxControlRangeScalePicker>
  <BoxControlRangePicker min={0} max={100} step={1} label="Custom padding" />
</BoxControl>`;

export const meta = {
  name: "box-control",
  label: "Box control",
  source: "src/components/BoxControl/BoxControl.next.ptsx",
  portableName: "BoxControlNext",
  kind: "composite",
  group: "Editor",
  description: "Side selection and named/arbitrary value editing inside StyleControl.",
  tags: ["inspector", "box", "sides", "tokens"],
  usage: referenceUsage,
  preview: "inspector",
  previewLabel: "Padding side and value control",
  docs: {
    purpose: [
      "BoxControl specializes StyleControl for side-based padding, margin, and border-width editing.",
      "It owns side or corner selection and synchronization while BoxValueControl owns named and arbitrary CSS values.",
    ],
    useWhen: ["One box-model value can target any combination of sides or corners."],
    avoidWhen: ["Editing a value without side selection; use BoxValueControl directly."],
    rules: [
      {
        title: "The icon is the selection seed",
        description:
          "BoxControlIcon accepts either SelectedSidesIcon or SelectedCornersIcon. That composed icon's props initialize the same local selection shown by BoxValueControl; there is no parallel selection prop.",
      },
      {
        title: "Opposite sync follows orientation",
        description:
          "Top/Bottom uses the sync icon rotated 90 degrees; Left/Right uses its horizontal orientation. The action selects the matching pair.",
      },
      {
        title: "All sides is exclusive",
        description:
          "Sync all selects all four sides or corners and clears the opposite-pair pressed state. The opposite-pair action remains available from all sides and switches to Left, Right.",
      },
      {
        title: "Value composition stays typed",
        description:
          "Named options and arbitrary range bounds are authored with BoxControlRangeScalePicker and BoxControlRangePicker children.",
      },
    ],
    accessibility: [
      "Every icon-only action has an accessible label and title.",
      "Pressed state identifies the active synchronization mode.",
      "label names every native value editor rendered by BoxValueControl.",
      "StyleControlCloseTrigger preserves the shared close-button semantics.",
    ],
    composition: [
      "BoxControl renders StyleControlActions and StyleControlContent internally.",
      "BoxControlIcon follows BoxValueControlIcon composition exactly: it wraps one SelectedSidesIcon or SelectedCornersIcon, including that component's size and root props.",
      "BoxControl derives its reactive indicator from that authored child and passes it through BoxValueControlIcon.",
      "Compose BoxControlIcon first, the named-scale child second, and the arbitrary-range child third.",
    ],
    agentNotes: [
      "Do not expose Icon names or raw action slots; BoxControl owns its three concrete header actions.",
      "Do not flatten named options into a public options prop; keep configuration children in authored PJSX.",
    ],
    props: [
      { name: "title", type: "string", description: "StyleControl header title.", required: true },
      {
        name: "label",
        type: "string",
        description: "Accessible name for the value editors.",
        required: true,
      },
      {
        name: "defaultValue",
        type: "string | readonly [number, CssUnit]",
        description: "Initial BoxValueControl value and mode.",
        required: true,
      },
      {
        name: "disabled",
        type: "boolean",
        description: "Disables selection and value actions.",
        default: "false",
      },
      {
        name: "onSelectionChange",
        type: "(event: CustomEvent<BoxControlSelection>) => void",
        description: "Reports the selected side, pair, or all-sides value in event.detail.",
      },
      {
        name: "onClose",
        type: "(event: MouseEvent) => void",
        description: "Close-trigger callback.",
      },
      {
        name: "onInput",
        type: "(value: BoxValue) => void",
        description: "Value preview callback.",
      },
      {
        name: "onChange",
        type: "(value: BoxValue) => void",
        description: "Value commit callback.",
      },
      {
        name: "children",
        type: "[BoxControlIcon, BoxControlRangeScalePicker, BoxControlRangePicker]",
        description: "Geometry selection, named-scale options, and arbitrary-range configuration.",
        required: true,
      },
      { name: "id", type: "string", description: "Identifier applied to the BoxControl root." },
      { name: "classes", type: "string", description: "Additional root composition classes." },
      {
        name: "BoxControlIcon.children",
        type: "SelectedSidesIcon | SelectedCornersIcon",
        description: "One composed geometry icon that initializes BoxControl selection.",
        required: true,
      },
      {
        name: "SelectedSidesIcon.id",
        type: "string",
        description: "Identifier applied to the side icon root.",
      },
      {
        name: "SelectedSidesIcon.classes",
        type: "string",
        description: "Additional side icon composition classes.",
      },
      {
        name: "SelectedSidesIcon.size",
        type: '"xs" | "sm" | "md" | "lg" | "xl"',
        description: "Side icon size.",
        default: '"md"',
      },
      {
        name: "SelectedSidesIcon.top",
        type: "boolean",
        description: "Selects the top side.",
        default: "false",
      },
      {
        name: "SelectedSidesIcon.right",
        type: "boolean",
        description: "Selects the right side.",
        default: "false",
      },
      {
        name: "SelectedSidesIcon.bottom",
        type: "boolean",
        description: "Selects the bottom side.",
        default: "false",
      },
      {
        name: "SelectedSidesIcon.left",
        type: "boolean",
        description: "Selects the left side.",
        default: "false",
      },
      {
        name: "SelectedCornersIcon.id",
        type: "string",
