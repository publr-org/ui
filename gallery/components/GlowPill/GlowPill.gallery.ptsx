export function Demo() {
  return (
    <div class="flex w-full max-w-xl flex-col gap-4">
      <GlowPill
        text="Add a recipes section with ingredients and steps"
        detail="Sends in a moment. Enter sends now, Esc cancels."
        glowing
        filled="40%"
        actions={<CloseButton label="Cancel" />}
      />
      <GlowPill text="Created content type Recipe" detail="Working… 0:12" glowing />
      <GlowPill text="Added a Recipes section with 3 drafts." detail="Done" actions={<CloseButton label="Close" />} />
    </div>
  );
}
