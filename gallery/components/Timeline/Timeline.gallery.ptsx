type Activity = readonly [actor: string, verb: string, object: string, time: string];

const ACTIVITIES: readonly Activity[] = [
  ["hi", "created", "Untitled", "13 hours ago"],
  ["hi", "updated", "ABCD [kv:dupa] [kv:test]", "1 week ago"],
  ["hi", "published", "Test", "2 weeks ago"],
];

const itemNode = ([actor, verb, object, time]: Activity): DemoNode => ({
  component: "TimelineItem",
  props: {},
  children: [
    { component: "Avatar", props: { size: "md", name: actor } },
    {
      component: "TimelineContent",
      props: {},
      children: [
        {
          component: "TimelineHeader",
          props: {},
          children: [
            {
              component: "Text",
              props: {
                as: "p",
                variant: "body-sm",
                tone: "muted",
                classes: "min-w-0 flex-1",
                children: `${actor} ${verb}`,
              },
            },
            { component: "TimelineTime", props: { children: time } },
          ],
        },
        {
          component: "Link",
          props: {
            href: "#",
            tone: "default",
            variant: "body-md",
            classes: "mt-1 block",
            children: object,
          },
        },
      ],
    },
  ],
});

const CANONICAL_NODE: DemoNode = {
  component: "Timeline",
  props: {},
  wrapper: "w-full max-w-md",
  children: ACTIVITIES.map(itemNode),
};

const DemoEntry = ({
  actor,
  verb,
  object,
  time,
}: {
  actor: string;
  verb: string;
  object: string;
  time: string;
}) => (
  <TimelineItem>
    <Avatar size="md" name={actor} />
    <TimelineContent>
      <TimelineHeader>
        <Text as="p" variant="body-sm" tone="muted" classes="min-w-0 flex-1">
          <strong class="font-semibold text-foreground">{actor}</strong> {verb}
        </Text>
        <TimelineTime>{time}</TimelineTime>
      </TimelineHeader>
      <Link href="#" tone="default" variant="body-md" classes="mt-1 block">
        {object}
      </Link>
    </TimelineContent>
  </TimelineItem>
);

export const variants = [
  {
    label: "Activity feed",
    description: "The canonical actor-action-object feed with the connector rail.",
    usage: meta.usage,
    notes: ["Every item draws the rail; the last item hides it via group-last — no is-last data."],
    Demo: () => (
      <Timeline classes="w-full max-w-md">
        {ACTIVITIES.map((activity) => (
          <DemoEntry actor={activity[0]} verb={activity[1]} object={activity[2]} time={activity[3]} />
        ))}
      </Timeline>
    ),
    node: CANONICAL_NODE,
  },
  {
    label: "Single entry",
    description: "A one-item feed renders no rail at all.",
    usage: `<Timeline>
  <TimelineItem>
    <Avatar size="md" name="hi" />
    <TimelineContent>
      <TimelineHeader>
        <Text as="p" variant="body-sm" tone="muted" classes="min-w-0 flex-1">
          <strong class="font-semibold text-foreground">hi</strong> created
        </Text>
        <TimelineTime>13 hours ago</TimelineTime>
      </TimelineHeader>
      <Link href="#" tone="default" variant="body-md" classes="mt-1 block">
        Untitled
      </Link>
    </TimelineContent>
  </TimelineItem>
</Timeline>`,
    notes: ["group-last hides the rail when the item is the only child."],
    Demo: () => (
      <Timeline classes="w-full max-w-md">
        <DemoEntry actor="hi" verb="created" object="Untitled" time="13 hours ago" />
      </Timeline>
    ),
    node: {
      component: "Timeline",
      props: {},
      wrapper: "w-full max-w-md",
      children: [itemNode(ACTIVITIES[0]!)],
    },
  },
] satisfies ComponentDemoVariant[];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): readonly ComponentCanvasChildInstance[] => {
  const value = values[scopedValue(scope, name)];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

// The canvas mirrors the API recursively: Timeline accepts items; an item
// accepts its Avatar marker and TimelineContent; content accepts the
// TimelineHeader and the object Link; the header accepts the description
// Text and TimelineTime.
const textOption = {
  name: "text",
  label: "Text",
  labelControl: "text.children",
  type: "group",
  controls: [
    { name: "text.children", label: "children", type: "text", default: "hi created" },
    { name: "text.classes", label: "classes", type: "text", default: "min-w-0 flex-1" },
  ],
} satisfies ComponentCanvasGroupControl;

const timeOption = {
  name: "time",
  label: "TimelineTime",
  labelControl: "time.children",
  type: "group",
  controls: [
    { name: "time.children", label: "children", type: "text", default: "just now" },
    { name: "time.classes", label: "classes", type: "text", default: "" },
  ],
} satisfies ComponentCanvasGroupControl;

const headerOption = {
  name: "header",
  label: "TimelineHeader",
  type: "group",
  controls: [
    { name: "header.classes", label: "classes", type: "text", default: "" },
    {
      name: "header.children",
      label: "children",
      type: "children",
      default: ["text", "time"],
      options: [textOption, timeOption],
    },
  ],
} satisfies ComponentCanvasGroupControl;

const linkOption = {
  name: "link",
  label: "Link",
  labelControl: "link.children",
  type: "group",
  controls: [
    { name: "link.children", label: "children", type: "text", default: "Untitled" },
    { name: "link.href", label: "href", type: "text", default: "#" },
  ],
} satisfies ComponentCanvasGroupControl;

const contentOption = {
  name: "content",
  label: "TimelineContent",
  type: "group",
  controls: [
    { name: "content.classes", label: "classes", type: "text", default: "" },
    {
      name: "content.children",
      label: "children",
      type: "children",
      default: ["header", "link"],
      options: [headerOption, linkOption],
    },
  ],
} satisfies ComponentCanvasGroupControl;

const avatarOption = {
  name: "avatar",
  label: "Avatar",
  labelControl: "avatar.name",
  type: "group",
  controls: [{ name: "avatar.name", label: "name", type: "text", default: "hi" }],
} satisfies ComponentCanvasGroupControl;

const itemOption = {
  name: "item",
  label: "TimelineItem",
  type: "group",
  controls: [
    { name: "item.classes", label: "classes", type: "text", default: "" },
    {
      name: "item.children",
      label: "children",
      type: "children",
      default: ["avatar", "content"],
      options: [avatarOption, contentOption],
    },
  ],
} satisfies ComponentCanvasGroupControl;

const itemDefault = ([actor, verb, object, time]: Activity): ComponentCanvasChildDefault => ({
  type: "item",
  values: {
    "item.children": [
      { type: "avatar", values: { "avatar.name": actor } },
      {
        type: "content",
        values: {
          "content.children": [
            {
              type: "header",
              values: {
                "header.children": [
                  { type: "text", values: { "text.children": `${actor} ${verb}` } },
                  { type: "time", values: { "time.children": time } },
                ],
              },
            },
            { type: "link", values: { "link.children": object } },
          ],
        },
      },
    ],
  },
});

export const canvas = {
  controls: [
    { name: "timeline.classes", label: "classes", type: "text", default: "" },
    {
      name: "timeline.children",
      label: "children",
      type: "children",
      allowMultiple: true,
      default: ACTIVITIES.map(itemDefault),
      options: [itemOption],
    },
  ],
  node: (values) => {
    const text = (scope: string, name: string) => stringValue(values, name, scope);
    const children = (scope: string, name: string) => childValues(values, name, scope);

    const headerNode = (header: ComponentCanvasChildInstance): DemoNode => ({
      component: "TimelineHeader",
      props: { classes: text(header.id, "header.classes") },
      children: children(header.id, "header.children").map((part): DemoNode =>
        part.type === "time"
          ? {
              component: "TimelineTime",
              props: {
                children: text(part.id, "time.children"),
                classes: text(part.id, "time.classes"),
              },
            }
          : {
              component: "Text",
              props: {
                as: "p",
                variant: "body-sm",
                tone: "muted",
                classes: text(part.id, "text.classes"),
                children: text(part.id, "text.children"),
              },
            },
      ),
    });

    const contentNode = (content: ComponentCanvasChildInstance): DemoNode => ({
      component: "TimelineContent",
      props: { classes: text(content.id, "content.classes") },
      children: children(content.id, "content.children").map((part): DemoNode =>
        part.type === "header"
          ? headerNode(part)
          : {
              component: "Link",
              props: {
                href: text(part.id, "link.href") || "#",
                tone: "default",
                variant: "body-md",
                classes: "mt-1 block",
                children: text(part.id, "link.children"),
              },
            },
      ),
    });

    return {
      component: "Timeline",
      props: { classes: text("", "timeline.classes") },
      wrapper: "w-full max-w-md",
      children: children("", "timeline.children").map((item): DemoNode => ({
        component: "TimelineItem",
        props: { classes: text(item.id, "item.classes") },
        children: children(item.id, "item.children").map((part): DemoNode =>
          part.type === "avatar"
            ? {
                component: "Avatar",
                props: { size: "md", name: text(part.id, "avatar.name") },
              }
            : contentNode(part),
        ),
      })),
    };
  },
} satisfies ComponentCanvas;
