import { TimelineItem } from "../../../src/components/Timeline/TimelineItem.ptsx";
import { TimelineTime } from "../../../src/components/Timeline/TimelineTime.ptsx";
import type {
  ComponentCanvas,
  ComponentCanvasChildDefault,
  ComponentCanvasChildInstance,
  ComponentCanvasGroupControl,
  ComponentDemoMeta,
  ComponentDemoVariant,
  DemoNode,
} from "../../gallery-types";

export const meta = {
  name: "timeline",
  label: "Timeline",
  source: "src/components/Timeline/Timeline.ptsx",
  kind: "composite",
  group: "Essentials",
  description:
    "Chronological event feed composed from item, content, header, and time parts with a component-owned connector rail.",
  tags: ["timeline", "activity", "feed", "history", "events"],
  usage: `<Timeline>
  <TimelineItem>
    <Avatar size="md" name="Olivia Martin" />
    <TimelineContent>
      <TimelineHeader>
        <Text as="p" variant="body-sm" tone="muted" classes="min-w-0 flex-1">
          <strong class="font-semibold text-foreground">Olivia</strong> created
        </Text>
