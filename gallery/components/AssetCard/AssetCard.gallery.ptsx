export const canvas = {
  controls: [
    { name: "title", type: "text", default: "cover-final.jpg" },
    { name: "meta", type: "text", default: "3.2 MB · 2400 × 1600" },
    {
      name: "aspect",
      type: "select",
      default: "square",
      options: ["square", "landscape"],
    },
  ],
  node: (values) => ({
    component: "AssetCard",
    props: { classes: "w-56" },
    children: [
      {
        component: "AssetCardSelect",
        props: {},
        children: [{ component: "Checkbox", props: { value: "canvas" } }],
      },
      {
        component: "AssetCardPreview",
        props: { aspect: String(values.aspect) },
        children: [
          {
            component: "Icon",
            props: { name: "image", size: "lg", classes: "text-muted-foreground" },
          },
        ],
      },
      {
        component: "AssetCardTitle",
        props: { children: String(values.title), classes: "mt-2 px-2.5" },
      },
      {
        component: "AssetCardMeta",
        props: { children: String(values.meta), classes: "mb-2 px-2.5" },
      },
    ],
  }),
} satisfies ComponentCanvas;
