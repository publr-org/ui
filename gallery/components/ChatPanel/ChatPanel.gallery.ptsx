  description: "A conversation in a corner of the window, over whatever page is open.",
  tags: ["chat", "assistant", "conversation", "floating", "corner"],
  usage: `<ChatPanel title="Add a recipes section" status={<Status tone="accent">Working</Status>} footer={…}>…</ChatPanel>`,
  preview: "demo",
