export function Demo() {
  return (
    <ChatPanel
      title="Add a recipes section"
      status={<Status tone="accent" label="plain">Working… 0:12</Status>}
      actions={<CloseButton label="Close" />}
      footer={
        <div class="flex flex-col gap-2">
          <Textarea name="reply" rows={2} placeholder="Reply…" />
          <div class="flex justify-end">
            <Button hierarchy="primary" size="sm">Send</Button>
          </div>
        </div>
      }
    >
      <div class="flex flex-col gap-3 p-4">
        <MessageBubble>Add a recipes section with ingredients and steps</MessageBubble>
        <Text as="p" variant="body-sm">Created content type Recipe</Text>
      </div>
    </ChatPanel>
  );
}
