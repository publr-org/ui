  docs: {
    purpose: ["Lets a person talk to an assistant without leaving the page the assistant works on."],
    useWhen: ["A conversation follows the person from page to page."],
    avoidWhen: ["A conversation that is the page itself; lay it out in the page."],
    rules: [
      { title: "The caller places it", description: "Fixed at the bottom right, over the page." },
      { title: "The caller scrolls it", description: "The conversation is the caller's element, which keeps to its newest line." },
