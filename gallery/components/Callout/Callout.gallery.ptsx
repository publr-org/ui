export function Demo() {
  return (
    <div class="flex w-[40rem] flex-col gap-3">
      <Callout
        tone="success"
        title="You approved these changes"
        actions={<Button hierarchy="secondary">Withdraw approval</Button>}
      >
        Deploy when you are ready, or keep working with your agent.
      </Callout>
      <Callout tone="warning" title="Changes requested">Waiting for your agent.</Callout>
      <Callout tone="info" title="Nothing to deploy">Everything is on Production already.</Callout>
      <Callout tone="error" title="The deploy failed">Production changed since; review again.</Callout>
    </div>
