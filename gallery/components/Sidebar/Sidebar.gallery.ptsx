const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const booleanValue = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): boolean => Boolean(values[scopedValue(scope, name)]);
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
): readonly ComponentCanvasChildInstance[] => {
  const value = values[name];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

export const canvas = {
  controls: [
    {
      name: "items",
      type: "children",
      allowMultiple: true,
      default: ["eyebrow", "item", "item"],
      options: [
        {
          name: "eyebrow",
          label: "SidebarNavEyebrow",
          labelControl: "eyebrow.children",
          type: "group",
          controls: [
            { name: "eyebrow.children", label: "children", type: "text", default: "Workspace" },
            { name: "eyebrow.first", label: "first", type: "boolean", default: false },
          ],
        },
        {
          name: "item",
          label: "SidebarNavItem",
          labelControl: "item.children",
          type: "group",
          controls: [
            { name: "item.children", label: "children", type: "text", default: "Overview" },
            { name: "item.href", label: "href", type: "text", default: "#overview" },
            { name: "item.active", label: "active", type: "boolean", default: false },
          ],
        },
      ],
    },
  ],
  node: (values) => ({
    fragment: true,
    wrapper: "w-52 px-2",
    children: childValues(values, "items").map((child): DemoNode => {
      if (child.type === "eyebrow") {
        return {
          component: "SidebarNavEyebrow",
          props: {
            children: stringValue(values, "eyebrow.children", child.id),
            first: booleanValue(values, "eyebrow.first", child.id),
          },
        };
      }
      return {
        component: "SidebarNavItem",
        props: {
          children: stringValue(values, "item.children", child.id),
          href: stringValue(values, "item.href", child.id),
          active: booleanValue(values, "item.active", child.id),
        },
      };
    }),
  }),
} satisfies ComponentCanvas;
