  previewLabel: "Form field composition",
  docs: {
    purpose: [
      "Field supplies the vertical rhythm and the label, description, and error relationship every form row needs.",
      "Controls stay dumb and unwrapped; Field composes around them without knowing their shape.",
    ],
    useWhen: [
      "Giving any form control a visible label, help text, or validation message.",
      "Building a form row from Input, Textarea, Select, RangePicker, or RangeScalePicker.",
    ],
    avoidWhen: [
      "Labelling an inspector style row; use StyleControl, which owns its own header.",
      "Grouping unrelated sections of a page; compose Heading with ordinary layout utilities.",
