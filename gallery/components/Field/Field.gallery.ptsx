  <FieldLabel htmlFor="opacity">Opacity</FieldLabel>
  <RangePicker id="opacity" value={state.value} min={0} max={100} step={1} onInput={sync} onChange={sync} />
  <FieldDescription>Applies to the selected block only.</FieldDescription>
</Field>`,
    Demo: RangeDemo,
    node: rangeNode,
  },
  {
    label: "Invalid",
    description: "FieldError announces the message; the control still owns its own invalid state.",
    notes: [
      'FieldError renders role="alert" so the message is announced when it appears.',
      "Pass invalid to the control as well; Field does not propagate validation state.",
    ],
    usage: `<Field>
  <FieldLabel htmlFor="email">Email</FieldLabel>
  <Input id="email" name="email" type="email" invalid={true} />
  <FieldError>Please enter a valid email address.</FieldError>
</Field>`,
    Demo: ErrorDemo,
    node: errorNode,
  },
  {
    label: "Custom typography",
    description: "Compose Text inside a part to override its bare-text default.",
    notes: ["There is no size prop; the nearer Text element wins."],
    usage: `<FieldLabel htmlFor="title">
  <Text variant="body-md">Title</Text>
</FieldLabel>`,
    Demo: TypographyDemo,
    node: typographyNode,
  },
];

const scopedValue = (scope: string, name: string) => (scope ? `${scope}::${name}` : name);
const stringValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): string =>
  String(values[scopedValue(scope, name)] ?? "");
const numberValue = (values: Readonly<Record<string, unknown>>, name: string, scope = ""): number =>
  Number(values[scopedValue(scope, name)] ?? 0);
const booleanValue = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): boolean => Boolean(values[scopedValue(scope, name)]);
const childValues = (
  values: Readonly<Record<string, unknown>>,
  name: string,
  scope = "",
): readonly ComponentCanvasChildInstance[] => {
  const value = values[scopedValue(scope, name)];
  return Array.isArray(value)
    ? value.filter(
        (item): item is ComponentCanvasChildInstance =>
          Boolean(item) && typeof item === "object" && "id" in item && "type" in item,
      )
    : [];
};

export const canvas = {
  controls: [
    { name: "field.id", label: "id", type: "text", default: "" },
    { name: "field.classes", label: "classes", type: "text", default: "" },
    {
      name: "field.children",
      label: "children",
      type: "children",
      allowMultiple: true,
      default: ["label", "input", "description"],
      options: [
        {
          name: "label",
          label: "FieldLabel",
          labelControl: "label.children",
          type: "group",
          controls: [
            { name: "label.children", label: "children", type: "text", default: "Email" },
            { name: "label.htmlFor", label: "htmlFor", type: "text", default: "email" },
            { name: "label.id", label: "id", type: "text", default: "" },
            { name: "label.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "input",
          label: "Input",
          type: "group",
          controls: [
            {
              name: "input.type",
              label: "type",
              type: "select",
              default: "email",
              options: [
                "text",
                "email",
                "password",
                "search",
                "tel",
                "url",
                "number",
                "file",
                "date",
                "datetime-local",
              ],
            },
            { name: "input.id", label: "id", type: "text", default: "email" },
            { name: "input.name", label: "name", type: "text", default: "email" },
            { name: "input.value", label: "value", type: "text", default: "" },
            {
              name: "input.placeholder",
              label: "placeholder",
              type: "text",
              default: "you@example.com",
            },
            { name: "input.disabled", label: "disabled", type: "boolean", default: false },
            { name: "input.invalid", label: "invalid", type: "boolean", default: false },
            { name: "input.required", label: "required", type: "boolean", default: false },
            { name: "input.readOnly", label: "readOnly", type: "boolean", default: false },
            { name: "input.autocomplete", label: "autocomplete", type: "text", default: "" },
            { name: "input.min", label: "min", type: "text", default: "" },
            { name: "input.max", label: "max", type: "text", default: "" },
            { name: "input.step", label: "step", type: "text", default: "" },
            { name: "input.minLength", label: "minLength", type: "text", default: "" },
            { name: "input.maxLength", label: "maxLength", type: "text", default: "" },
            {
              name: "input.inputMode",
              label: "inputMode",
              type: "select",
              default: "text",
              options: INPUT_MODES,
            },
            { name: "input.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "textarea",
          label: "Textarea",
          type: "group",
          controls: [
            { name: "textarea.id", label: "id", type: "text", default: "message" },
            { name: "textarea.name", label: "name", type: "text", default: "message" },
            { name: "textarea.value", label: "value", type: "text", default: "" },
            {
              name: "textarea.placeholder",
              label: "placeholder",
              type: "text",
              default: "Write a message",
            },
            { name: "textarea.disabled", label: "disabled", type: "boolean", default: false },
            { name: "textarea.invalid", label: "invalid", type: "boolean", default: false },
            { name: "textarea.required", label: "required", type: "boolean", default: false },
            { name: "textarea.readOnly", label: "readOnly", type: "boolean", default: false },
            {
              name: "textarea.autocomplete",
              label: "autocomplete",
              type: "text",
              default: "",
            },
            { name: "textarea.minLength", label: "minLength", type: "text", default: "" },
            { name: "textarea.maxLength", label: "maxLength", type: "text", default: "" },
            { name: "textarea.rows", label: "rows", type: "number", default: 5, min: 1 },
            { name: "textarea.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "rangePicker",
          label: "RangePicker",
          type: "group",
          controls: [
            { name: "rangePicker.id", label: "id", type: "text", default: "opacity" },
            { name: "rangePicker.classes", label: "classes", type: "text", default: "" },
            { name: "rangePicker.value", label: "value", type: "number", default: 35 },
            { name: "rangePicker.min", label: "min", type: "number", default: 0 },
            { name: "rangePicker.max", label: "max", type: "number", default: 100 },
            { name: "rangePicker.step", label: "step", type: "number", default: 1 },
            { name: "rangePicker.label", label: "label", type: "text", default: "Opacity" },
            {
              name: "rangePicker.disabled",
              label: "disabled",
              type: "boolean",
              default: false,
            },
          ],
        },
        {
          name: "description",
          label: "FieldDescription",
          labelControl: "description.children",
          type: "group",
          controls: [
            {
              name: "description.children",
              label: "children",
              type: "text",
              default: "We'll never share your email.",
            },
            { name: "description.id", label: "id", type: "text", default: "" },
            { name: "description.classes", label: "classes", type: "text", default: "" },
          ],
        },
        {
          name: "error",
          label: "FieldError",
          labelControl: "error.children",
          type: "group",
          controls: [
            {
              name: "error.children",
              label: "children",
              type: "text",
              default: "Please enter a valid email address.",
            },
            { name: "error.id", label: "id", type: "text", default: "" },
            { name: "error.classes", label: "classes", type: "text", default: "" },
          ],
        },
      ],
    },
  ],

  node: (values) => {
    const text = (scope: string, name: string) => stringValue(values, name, scope);
    const number = (scope: string, name: string) => numberValue(values, name, scope);
    const on = (scope: string, name: string) => booleanValue(values, name, scope);
    const optionalText = (scope: string, name: string) => {
      const value = text(scope, name);
      return value ? { [name.split(".").at(-1)!]: value } : {};
    };
    const optionalNumber = (scope: string, name: string) => {
      const value = text(scope, name);
      return value ? { [name.split(".").at(-1)!]: Number(value) } : {};
    };
    const nodes = childValues(values, "field.children").flatMap((child): DemoNode[] => {
      if (child.type === "label") {
        return [
          {
            component: "FieldLabel",
            props: {
              htmlFor: text(child.id, "label.htmlFor"),
              id: text(child.id, "label.id"),
              classes: text(child.id, "label.classes"),
              children: text(child.id, "label.children"),
            },
          },
        ];
      }
      if (child.type === "input") {
        return [
          {
            component: "Input",
            props: {
              type: text(child.id, "input.type"),
              ...optionalText(child.id, "input.id"),
              ...optionalText(child.id, "input.name"),
              ...optionalText(child.id, "input.value"),
              ...optionalText(child.id, "input.placeholder"),
              disabled: on(child.id, "input.disabled"),
              invalid: on(child.id, "input.invalid"),
              required: on(child.id, "input.required"),
              readOnly: on(child.id, "input.readOnly"),
              ...optionalText(child.id, "input.autocomplete"),
              ...optionalText(child.id, "input.min"),
              ...optionalText(child.id, "input.max"),
              ...optionalText(child.id, "input.step"),
              ...optionalNumber(child.id, "input.minLength"),
              ...optionalNumber(child.id, "input.maxLength"),
              ...optionalText(child.id, "input.inputMode"),
              classes: text(child.id, "input.classes"),
            },
          },
        ];
      }
      if (child.type === "textarea") {
        return [
          {
            component: "Textarea",
            props: {
              ...optionalText(child.id, "textarea.id"),
              ...optionalText(child.id, "textarea.name"),
              ...optionalText(child.id, "textarea.value"),
              ...optionalText(child.id, "textarea.placeholder"),
              disabled: on(child.id, "textarea.disabled"),
              invalid: on(child.id, "textarea.invalid"),
              required: on(child.id, "textarea.required"),
              readOnly: on(child.id, "textarea.readOnly"),
              ...optionalText(child.id, "textarea.autocomplete"),
              ...optionalNumber(child.id, "textarea.minLength"),
              ...optionalNumber(child.id, "textarea.maxLength"),
              rows: number(child.id, "textarea.rows"),
              classes: text(child.id, "textarea.classes"),
            },
          },
        ];
      }
      if (child.type === "rangePicker") {
        return [
          {
            component: "RangePicker",
            props: {
              id: text(child.id, "rangePicker.id"),
              classes: text(child.id, "rangePicker.classes"),
              value: number(child.id, "rangePicker.value"),
              min: number(child.id, "rangePicker.min"),
              max: number(child.id, "rangePicker.max"),
              step: number(child.id, "rangePicker.step"),
              label: text(child.id, "rangePicker.label"),
              disabled: on(child.id, "rangePicker.disabled"),
            },
          },
        ];
      }
      if (child.type === "description") {
        return [
          {
            component: "FieldDescription",
            props: {
              id: text(child.id, "description.id"),
              classes: text(child.id, "description.classes"),
              children: text(child.id, "description.children"),
            },
          },
        ];
      }
      if (child.type === "error") {
        return [
          {
            component: "FieldError",
            props: {
              id: text(child.id, "error.id"),
              classes: text(child.id, "error.classes"),
              children: text(child.id, "error.children"),
            },
          },
        ];
      }
      return [];
    });

    return {
      component: "Field",
      props: {
        id: stringValue(values, "field.id"),
        classes: stringValue(values, "field.classes"),
      },
      children: nodes,
      wrapper: "w-full max-w-sm",
    };
  },
} satisfies ComponentCanvas;
