function InputDemo() {
  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-email">Email</FieldLabel>
        <Input id="field-email" name="email" type="email" placeholder="you@example.com" />
        <FieldDescription>We'll never share your email.</FieldDescription>
      </Field>
    </div>
  );
}

function TextareaDemo() {
  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-bio">Biography</FieldLabel>
        <Textarea id="field-bio" name="bio" placeholder="Tell us about yourself" />
        <FieldDescription>Plain text, no formatting.</FieldDescription>
      </Field>
    </div>
  );
}

function SelectDemo() {
  const state = reactive({ fruit: "apple" });

  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-fruit">Fruit</FieldLabel>
        <Select
          id="field-fruit"
          name="fruit"
          value={state.fruit}
          onChange={(value: string) => {
            state.fruit = value;
          }}
        >
          <SelectTrigger>
            <SelectValue>Select a fruit</SelectValue>
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="apple">Apple</SelectItem>
            <SelectItem value="banana">Banana</SelectItem>
            <SelectItem value="cherry">Cherry</SelectItem>
          </SelectContent>
        </Select>
      </Field>
    </div>
  );
}

function RangeDemo() {
  const state = reactive({ value: 35 });
  const sync = (event: Event) => {
    state.value = Number((event.target as HTMLInputElement).value);
  };

  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-opacity">Opacity</FieldLabel>
        <RangePicker
          id="field-opacity"
          value={state.value}
          min={0}
          max={100}
          step={1}
          onInput={sync}
          onChange={sync}
        />
        <FieldDescription>Applies to the selected block only.</FieldDescription>
      </Field>
    </div>
  );
}

function ErrorDemo() {
  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-invalid">Email</FieldLabel>
        <Input id="field-invalid" name="email" type="email" value="not-an-email" invalid={true} />
        <FieldError>Please enter a valid email address.</FieldError>
      </Field>
    </div>
  );
}

function TypographyDemo() {
  return (
    <div class="w-full max-w-sm">
      <Field>
        <FieldLabel htmlFor="field-title">
          <Text variant="body-md">Title</Text>
        </FieldLabel>
        <Input id="field-title" name="title" placeholder="Post title" />
        <FieldDescription>
          <Text variant="body-sm" tone="muted">
            Shown in search results and social previews.
          </Text>
        </FieldDescription>
      </Field>
    </div>
  );
}

const fieldNode = (children: DemoNode[]): DemoNode => ({
  component: "Field",
  props: {},
  children,
  wrapper: "w-full max-w-sm",
});

const inputNode = fieldNode([
  {
    component: "FieldLabel",
    props: { htmlFor: "field-email", children: "Email" },
  },
  {
    component: "Input",
    props: {
      id: "field-email",
      name: "email",
      type: "email",
      placeholder: "you@example.com",
    },
  },
  {
    component: "FieldDescription",
    props: { children: "We'll never share your email." },
  },
]);

const textareaNode = fieldNode([
  {
    component: "FieldLabel",
    props: { htmlFor: "field-bio", children: "Biography" },
  },
  {
    component: "Textarea",
    props: {
      id: "field-bio",
      name: "bio",
      placeholder: "Tell us about yourself",
    },
  },
  {
    component: "FieldDescription",
    props: { children: "Plain text, no formatting." },
  },
]);

const rangeNode = fieldNode([
  {
    component: "FieldLabel",
    props: { htmlFor: "field-opacity", children: "Opacity" },
  },
  {
    component: "RangePicker",
