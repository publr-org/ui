      id: "field-opacity",
      value: 35,
      min: 0,
      max: 100,
      step: 1,
    },
  },
  {
    component: "FieldDescription",
    props: { children: "Applies to the selected block only." },
  },
]);

const errorNode = fieldNode([
  {
    component: "FieldLabel",
    props: { htmlFor: "field-invalid", children: "Email" },
  },
  {
    component: "Input",
    props: {
      id: "field-invalid",
      name: "email",
      type: "email",
      value: "not-an-email",
      invalid: true,
    },
  },
  {
    component: "FieldError",
    props: { children: "Please enter a valid email address." },
  },
]);

const typographyNode = fieldNode([
  {
    component: "FieldLabel",
    props: { htmlFor: "field-title" },
    children: [{ component: "Text", props: { variant: "body-md", children: "Title" } }],
  },
  {
    component: "Input",
    props: { id: "field-title", name: "title", placeholder: "Post title" },
  },
  {
    component: "FieldDescription",
    props: {},
    children: [
      {
        component: "Text",
        props: {
          variant: "body-sm",
          tone: "muted",
          children: "Shown in search results and social previews.",
        },
      },
    ],
  },
]);

export const variants: ComponentDemoVariant[] = [
  {
    label: "With Input",
    description: "The canonical form row: label, control, and help text.",
    usage: `<Field>
  <FieldLabel htmlFor="email">Email</FieldLabel>
  <Input id="email" name="email" type="email" placeholder="you@example.com" />
  <FieldDescription>We'll never share your email.</FieldDescription>
</Field>`,
