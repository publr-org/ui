    rules: [
      {
        title: "Associate the label explicitly",
        description:
          "Pass FieldLabel htmlFor and the matching control id. Field adds no automatic wiring.",
      },
      {
        title: "Controls own their own invalid state",
        description:
          "FieldError renders the message; the control still needs its own invalid prop for the border and aria-invalid.",
      },
      {
        title: "Compose Text to change typography",
        description:
          "The parts carry bare-text defaults. Wrap children in Text for any other size or tone instead of reaching for classes.",
      },
    ],
    accessibility: [
      "FieldLabel renders a native label; htmlFor and the control id create the association.",
      'FieldError carries role="alert" so validation messages are announced when they appear.',
      "Field itself is a plain layout element and adds no ARIA of its own.",
    ],
    composition: [
      "Field accepts any control as a child, including Input, Textarea, Select, RangePicker, and RangeScalePicker.",
      "Wrap FieldLabel, FieldDescription, or FieldError children in Text to override the default typography.",
    ],
    agentNotes: [
      "There is no standalone Label component; form labels belong to FieldLabel.",
      "Do not add label, description, or error props to controls. Compose them through Field.",
      "FieldSet, FieldLegend, FieldGroup, FieldContent, and FieldSeparator were intentionally not migrated.",
    ],
    props: [
