export function Demo() {
  return (
    <div role="tablist" class="flex border-b border-border">
      <PanelTab selected label="Conversation" count={4} />
      <PanelTab selected={false} label="Site" count={7} />
      <PanelTab selected={false} label="Content" count={9} />
      <PanelTab selected={false} label="Structure" />
    </div>
  );
}
