  usage: `<SampleGrid><SampleCell name="sm" sample={…}>…</SampleCell></SampleGrid>`,
  preview: "demo",
  previewLabel: "A scale as a ruled grid of value cells",
  docs: {
    purpose: ["A ruled grid of value cells, each a drawing of the value, its name with a remove action and its editor."],
