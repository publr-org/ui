export const node = { component: "SampleGrid", props: {}, wrapper: "w-full max-w-xl" } satisfies DemoNode;

export function Demo() {
  return (
    <div class="w-full max-w-xl">
      <SampleGrid>
        <SampleCell name="sm" removeLabel="Remove radius-sm" onRemove={() => undefined} sample={<ValueSample kind="radius" value="4px" />}>
