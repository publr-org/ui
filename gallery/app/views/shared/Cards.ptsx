// The prose cards and lists the reading pages share.
export function GuidanceCard({ title, items, marker }: { title: string; items: string[]; marker: string }) {
  return (
    <article class="rounded-xl border border-border bg-background p-5">
      <h3 class="text-[13px] font-semibold">{title}</h3>
      <ul class="mt-4 space-y-3">
        {items.map((item) => (
          <li class="flex gap-2.5 text-[12px] leading-5 text-muted-foreground">
            <span class={"mt-2 size-1.5 shrink-0 rounded-full " + marker}></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>
  );
}

export function InformationCard({ title, items }: { title: string; items: string[] }) {
  return (
    <article class="rounded-xl border border-border bg-background p-5">
      <h2 class="text-[15px] font-semibold">{title}</h2>
      <ul class="mt-4 space-y-3">
        {items.map((item) => (
          <li class="border-l-2 border-ring/50 pl-3 text-[12px] leading-5 text-muted-foreground">{item}</li>
        ))}
      </ul>
    </article>
  );
}

export function NumberedList({ items }: { items: readonly string[] }) {
  return (
    <ol class="mt-6 space-y-5">
      {items.map((item, index) => (
        <li class="grid grid-cols-[30px_1fr] gap-3 text-[13px] leading-6">
          <span class="grid size-7 place-items-center rounded-full border border-border bg-background text-[10px] font-semibold">{index + 1}</span>
          <span>{item}</span>
        </li>
      ))}
    </ol>
  );
}

export function Bullet({ text }: { text: string }) {
  return (
    <li class="flex gap-2">
      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-ring"></span>
      <span>{text}</span>
    </li>
  );
}
