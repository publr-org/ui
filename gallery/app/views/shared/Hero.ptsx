// A component page's header: kind, group, page, title and description.
import { titleCase, type DemoEntry } from "../../state/gallery";

export function Hero({ entry, page, title }: { entry: DemoEntry; page: string; title?: string }) {
  return (
    <header class="max-w-4xl">
      <div class="mb-3 flex items-center gap-2">
        <span class="rounded-full border border-border bg-background px-2.5 py-1 text-[10px] font-semibold tracking-[0.05em] text-muted-foreground uppercase">
          {titleCase(entry.kind)}
        </span>
        <span class="text-[11px] text-muted-foreground">{entry.group}</span>
        <span class="text-border">·</span>
        <span class="text-[11px] text-muted-foreground">{page}</span>
      </div>
      <h1 class="text-[32px] leading-tight font-semibold tracking-[-0.03em]">{title ?? entry.label}</h1>
      <p class="mt-3 max-w-3xl text-[15px] leading-6 text-muted-foreground">{entry.description}</p>
    </header>
  );
}

export function SectionHeading({ title, description }: { title: string; description: string }) {
  return (
    <div class="border-b border-border pb-3">
      <h2 class="text-[20px] leading-7 font-semibold tracking-[-0.015em]">{title}</h2>
      <p class="mt-1 text-[12px] leading-5 text-muted-foreground">{description}</p>
    </div>
  );
}
