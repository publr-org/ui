// The preview page: every variant, light and dark side by side, each with
// its code.
import { CodePanel } from "./shared/Code.ptsx";
import { Frame } from "./shared/Frame.ptsx";
import { Hero, SectionHeading } from "./shared/Hero.ptsx";
import { Topbar } from "./shared/Topbar.ptsx";
import { PREVIEW_SURFACE_WIDTHS } from "../frames/surfaces";
import { KIND_LABELS, copyText, titleCase, type Appearance, type DemoEntry } from "../state/gallery";

type Story = { index: number; label: string; description?: string; usage: string };

function stories(entry: DemoEntry): Story[] {
  return entry.variants?.length
    ? entry.variants.map((variant, index) => ({ index, label: variant.label, description: variant.description, usage: variant.usage ?? entry.usage }))
    : [{ index: -1, label: "Default", usage: entry.usage }];
}

function StoryCard({ entry, story, appearance }: { entry: DemoEntry; story: Story; appearance: Appearance }) {
  return (
    <section class="mx-auto w-full max-w-[680px]" data-preview-story>
      <div class="mb-2.5 flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h3 class="text-[10px] font-semibold tracking-[0.08em] text-muted-foreground uppercase">{story.label}</h3>
          {story.description && <p class="mt-1 text-[11px] leading-4 text-muted-foreground">{story.description}</p>}
        </div>
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            aria-expanded="false"
            class="cursor-pointer rounded-md border border-border bg-background px-2 py-1 text-[10px] font-medium text-foreground shadow-sm hover:bg-muted"
            onClick={(event: MouseEvent) => {
              const button = event.currentTarget as HTMLButtonElement;
              const card = button.closest("[data-preview-story]")!;
              const preview = card.querySelector<HTMLElement>("[data-preview-surface]")!;
              const code = card.querySelector<HTMLElement>("[data-preview-code]")!;
              const showingCode = code.hidden;
              preview.hidden = showingCode;
              code.hidden = !showingCode;
              button.setAttribute("aria-expanded", String(showingCode));
              button.textContent = showingCode ? "Show preview" : "Show code";
            }}
          >
            Show code
          </button>
          <button
            type="button"
            class="cursor-pointer rounded-md border border-border bg-background px-2 py-1 text-[10px] font-medium text-foreground shadow-sm hover:bg-muted"
            onClick={(event: MouseEvent) => copyText(story.usage, event.currentTarget as HTMLButtonElement)}
          >
            Copy code
          </button>
        </div>
      </div>
      <div class={PREVIEW_SURFACE_WIDTHS[entry.preview] + " mx-auto w-full"} data-preview-surface>
        <Frame entry={entry} variant={story.index} appearance={appearance} title={entry.label + ": " + story.label + " (" + appearance + ")"} />
      </div>
      <div data-preview-code hidden class="mx-auto min-h-64 w-full max-w-[680px] overflow-auto rounded-lg border border-[#30363d] bg-[#0d1117] p-8 text-[#e6edf3] shadow-sm">
        <CodePanel source={story.usage} />
      </div>
    </section>
  );
}

function AppearanceColumn({ entry, items, appearance }: { entry: DemoEntry; items: Story[]; appearance: Appearance }) {
  return (
    <div class="min-w-0">
      <p class="mb-2 text-[10px] font-medium text-muted-foreground">{titleCase(appearance)}</p>
      <div class="flex min-h-[220px] flex-col justify-center gap-12 rounded-lg border border-border bg-muted/40 p-5">
        {items.map((story) => (
          <StoryCard entry={entry} story={story} appearance={appearance} />
        ))}
      </div>
    </div>
  );
}

export function PreviewPage({ entry }: { entry: DemoEntry }) {
  const items = stories(entry);
  return (
    <div>
      <Topbar parts={[KIND_LABELS[entry.kind], entry.label, "Preview"]} />
      <article class="mx-auto max-w-[1260px] px-8 py-10">
        <Hero entry={entry} page="Preview" title={entry.label + " preview"} />
        <section class="mt-9">
          <SectionHeading title="Examples" description={entry.previewLabel} />
          <div class="mt-4 grid grid-cols-2 gap-4 max-gallery-lg:grid-cols-1">
            <AppearanceColumn entry={entry} items={items} appearance="light" />
            <AppearanceColumn entry={entry} items={items} appearance="dark" />
          </div>
        </section>
      </article>
    </div>
  );
}
