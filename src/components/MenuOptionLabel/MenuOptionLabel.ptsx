// The title over a run of entries in a floating pick list ("Patterns", "Blocks").
import { Text } from "../Text/Text.ptsx";

export type MenuOptionLabelProps = {
  children: JSX.Element;
};

export function MenuOptionLabel({ children }: MenuOptionLabelProps) {
  return (
    <Text as="span" variant="label-md-strong" tone="muted" classes="block px-2 py-1.5">
      {children}
    </Text>
  );
}
