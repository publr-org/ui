import { DropdownMenu } from "../Dropdown/Dropdown.ptsx";
import { DropdownMenuContent } from "../Dropdown/DropdownMenuContent.ptsx";
import { DropdownMenuItem } from "../Dropdown/DropdownMenuItem.ptsx";
import { DropdownMenuTrigger } from "../Dropdown/DropdownMenuTrigger.ptsx";
import { FilterBar } from "../FilterBar/FilterBar.ptsx";
import { Icon } from "../Icon/Icon.ptsx";
import { Input } from "../Input/Input.ptsx";
import { DropdownMenuCheckboxItem } from "../Dropdown/DropdownMenuCheckboxItem.ptsx";
import { FilterPill } from "../FilterBar/FilterPill.ptsx";
import { FilterPillBody } from "../FilterBar/FilterPillBody.ptsx";
import { FilterPillLabel } from "../FilterBar/FilterPillLabel.ptsx";
import { FilterPillOperator } from "../FilterBar/FilterPillOperator.ptsx";
import { FilterPillRemove } from "../FilterBar/FilterPillRemove.ptsx";
import { FilterPillValue } from "../FilterBar/FilterPillValue.ptsx";
import { DropdownMenuSearch } from "../Dropdown/DropdownMenuSearch.ptsx";
import { DropdownMenuSeparator } from "../Dropdown/DropdownMenuSeparator.ptsx";
import { Table } from "../Table/Table.ptsx";
import { TableHeader } from "../Table/TableHeader.ptsx";
import { TableHead } from "../Table/TableHead.ptsx";
import { TableBody } from "../Table/TableBody.ptsx";
import { TableRow } from "../Table/TableRow.ptsx";
import { TableCell } from "../Table/TableCell.ptsx";
import { Link } from "../Link/Link.ptsx";
import { Empty } from "../Empty/Empty.ptsx";
import { EmptyTitle } from "../Empty/EmptyTitle.ptsx";
import { EmptyDescription } from "../Empty/EmptyDescription.ptsx";
import { Status } from "../Status/Status.ptsx";
import { Publr } from "publr-jsx";
import { awaited as awaitData } from "publr/runtime";
import { httpOperation } from "publr/transport";
import { Button } from "../Button/Button.ptsx";
import { Text } from "../Text/Text.ptsx";
import { DataTableSelectAll } from "./DataTableSelectAll.ptsx";
import { DataTableRowSelect } from "./DataTableRowSelect.ptsx";
import { Pagination } from "../Pagination/Pagination.ptsx";
import { PaginationContent } from "../Pagination/PaginationContent.ptsx";
import { PaginationItem } from "../Pagination/PaginationItem.ptsx";
import { PaginationLink } from "../Pagination/PaginationLink.ptsx";
import { PaginationPrevious } from "../Pagination/PaginationPrevious.ptsx";
import { PaginationNext } from "../Pagination/PaginationNext.ptsx";
import { PaginationEllipsis } from "../Pagination/PaginationEllipsis.ptsx";
import { DataTableOptions } from "./DataTableOptions.ptsx";
import { NativeSelect } from "../NativeSelect/NativeSelect.ptsx";

export type DataTableProps = {
  id?: string;
  classes?: string;
  search_name?: string;
  children?: JSX.Element;
  address?: string;
  /** A column's header: its label, the address that sorts by it (`active` while it does,
   * `sort` the direction), `end` alignment for numbers, and its menu: sort either way,
   * hide, move, filter by. */
  columns?: Array<{
    id: string;
    label: string;
    href: string;
    active: boolean;
    sort: string;
    align: string;
    menu: Array<{ id: string; label: string; icon: string; href: string }>;
  }>;
  rows?: Array<{
    id: string;
    cells: Array<{
      id: string;
      text: string;
      href: string;
      kind: string;
      tone: string;
      extra: string;
      extra_tone: string;
      /** `links`: records a field points at, by title; `thumbs`: its media files. */
      items: Array<{ id: string; label: string; href: string; thumb: string }>;
    }>;
  }>;
  filters?: Array<{
    id: string;
    name: string;
    label: string;
    operator: string;
    operator_id: string;
    operator_name: string;
    operators: Array<{ label: string; href: string; selected: boolean }>;
    value: string;
    /** What the value is chosen with: `options` (a menu), `day`, `text`, `number`, a range
     * (`number_range`, `day_range`: `low` and `high`), `span` (`count` and `unit`), or
     * `none`. */
    value_kind: string;
    day: string;
    low: string;
    high: string;
    low_name: string;
    high_name: string;
    count: string;
    unit: string;
    count_name: string;
    unit_name: string;
    options: Array<{ label: string; href: string; selected: boolean }>;
    carried: Array<{ id: string; name: string; value: string }>;
    remove_href: string;
    reset_href: string;
    searchable: boolean;
  }>;
  hidden?: Array<{ id: string; name: string; value: string }>;
  search?: string;
  add_filters?: Array<{ label: string; href: string; added: boolean }>;
  empty_text?: string;
  /** How many rows the filters match, every page together: past the page, selecting the
   * whole page offers to select them all. */
  total?: number;
  /** A checkbox column first, a row's own and the page's in the header. */
  selectable?: boolean;
  /** What to do with the selection: BulkActions, shown above the rows while any are
   * selected. */
  bulk?: JSX.Element;
  /** The page links under the rows, more than one page matching: the current one without
   * an href, a gap without a label. */
  pages?: Array<{ id: string; label: string; href: string; current: boolean }>;
  previous_href?: string;
  next_href?: string;
  /** Which rows of how many: "21–40 of 300". */
  range_text?: string;
  /** The view options behind the knob beside Filter, each choice an address: what to sort
   * by, which way, how many rows a page shows, and the properties: the columns shown, in
   * their order (dragged into another), then the rest. No properties, no knob. */
  sort_options?: Array<{ id: string; label: string; href: string; selected: boolean }>;
  /** Segmented choices: each `key` is the choice's address. */
  direction_options?: Array<{ key: string; label: string; icon: "arrow-up" | "arrow-down"; pressed: boolean }>;
  page_size_options?: Array<{ key: string; label: string; pressed: boolean }>;
  properties?: Array<{ id: string; label: string; shown: boolean; show_href: string }>;
};

export const state = Publr.reactive({
  address: "",
  columns: [] as NonNullable<DataTableProps["columns"]>,
  rows: [] as NonNullable<DataTableProps["rows"]>,
  filters: [] as NonNullable<DataTableProps["filters"]>,
  hidden: [] as NonNullable<DataTableProps["hidden"]>,
  search: "",
  add_filters: [] as NonNullable<DataTableProps["add_filters"]>,
  empty_text: "",
  total: 0,
  pages: [] as NonNullable<DataTableProps["pages"]>,
  previous_href: "",
  next_href: "",
  range_text: "",
  sort_options: [] as NonNullable<DataTableProps["sort_options"]>,
  direction_options: [] as NonNullable<DataTableProps["direction_options"]>,
  page_size_options: [] as NonNullable<DataTableProps["page_size_options"]>,
  properties: [] as NonNullable<DataTableProps["properties"]>,
  empty: true,
  request_url: "",
  busy: false,
  error: "",
  revision: 0,
  selectedRowIds: [] as string[],
  hiddenRowIds: [] as string[],
  hiddenColumns: [] as string[],
  allSelected: false,
  partiallySelected: false,
  anySelected: false,
  selectedCount: 0,
  /** Every row the filters match is selected, not just the page's. */
  allMatching: false,
  visibleCount: 0,
  selectionRevision: 0,
});

export const root_ref = Publr.ref<HTMLElement>((element) => {
  const reconcile = () => {
    const rows = page_rows();
    const ids = new Set(rows.map((row) => row.dataset.rowId!));
    const selected = state.selectedRowIds.filter((id) => ids.has(id));
    if (selected.length !== state.selectedRowIds.length) selection(selected);
    state.visibleCount = rows.filter(
      (row) => !state.hiddenRowIds.includes(row.dataset.rowId!),
    ).length;
    state.allSelected = selected.length > 0 && selected.length === rows.length;
    state.partiallySelected = selected.length > 0 && !state.allSelected;
  };
  const observer = new MutationObserver(reconcile);
  observer.observe(element, { childList: true, subtree: true });
  reconcile();
  return () => {
    clearTimeout(search_timer);
    observer.disconnect();
  };
});
export const search_ref = Publr.ref<HTMLInputElement>();
const triggers = new Map<string, HTMLElement>();
export const trigger_ref = Publr.ref<HTMLElement>((element) => {
  triggers.set(element.dataset.tableTrigger!, element);
  return () => {
    if (triggers.get(element.dataset.tableTrigger!) === element)
      triggers.delete(element.dataset.tableTrigger!);
  };
});
let search_timer: ReturnType<typeof setTimeout> | undefined = undefined;
let push_history = false;
let committed: unknown = null;
let open_filter = "";
let to_top = false;

const table_url = (href: string) => {
  const url = new URL(href, location.href);
  if (!state.address) return null;
  const address = new URL(state.address, location.href);
  return url.origin === address.origin && url.pathname === address.pathname ? url : null;
};

const result = awaitData(
  () => {
    if (!state.request_url) return null;
    return httpOperation<{
      data: Required<Omit<DataTableProps, "children" | "search_name" | "id" | "classes">>;
      context?: unknown;
    }>(state.request_url, {
      headers: { Accept: "application/json" },
    })();
  },
  {
    key: () => ["data-table", state.request_url],
    cache: { ttl: 15000 },
  },
);

const navigate = (url: URL, push: boolean) => {
  clearTimeout(search_timer);
  push_history = push;
  open_filter = url.hash.startsWith("#filter-") ? url.hash.slice(1) : "";
  url.hash = "";
  state.error = "";
  if (state.request_url === url.toString()) result.refresh();
  else state.request_url = url.toString();
};

export const onNavigate = (event: Event) => {
  if (!(event instanceof MouseEvent) || event.defaultPrevented || event.button !== 0) return;
  if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
  const anchor = event.currentTarget;
  if (
    !(anchor instanceof HTMLAnchorElement) ||
    anchor.hasAttribute("download") ||
    (anchor.target && anchor.target !== "_self")
  )
    return;
  const url = table_url(anchor.href);
  if (!url) return;
  event.preventDefault();
  to_top = anchor.closest('[data-part="pagination"]') !== null;
  navigate(url, true);
};

/** The table at an address the server wrote, kept in the history. */
export const goTo = (href: string) => {
  const url = table_url(href);
  if (url) navigate(url, true);
};

/** A view option picked: its address is its key. */
export const onChoose = (event: MouseEvent) => {
  const option = (event.currentTarget as HTMLElement).dataset.option;
  if (option) goTo(option);
};

// A shown property dragged onto another takes its place: the table loads with the columns
// in the new order.
let dragged = "";
export const onPropertyDragStart = (event: DragEvent) => {
  const row = event.currentTarget as HTMLElement;
  dragged = row.dataset.property ?? "";
  event.dataTransfer?.setData("text/plain", dragged);
  if (event.dataTransfer) event.dataTransfer.effectAllowed = "move";
};
export const onPropertyDragOver = (event: DragEvent) => {
  const row = event.currentTarget as HTMLElement;
  if (dragged && row.dataset.shown === "true") event.preventDefault();
};
export const onPropertyDrop = (event: DragEvent) => {
  const row = event.currentTarget as HTMLElement;
  const target = row.dataset.property ?? "";
  event.preventDefault();
  if (!dragged || !target || dragged === target || !state.address) return;
  const order = state.properties.filter((property) => property.shown).map((property) => property.id);
  const from = order.indexOf(dragged);
  const to = order.indexOf(target);
  dragged = "";
  if (from < 0 || to < 0) return;
  order.splice(to, 0, ...order.splice(from, 1));
  const url = new URL(state.address, location.href);
  url.searchParams.set("columns", order.join(","));
  url.searchParams.delete("page");
  navigate(url, true);
};
export const onPropertyDragEnd = () => {
  dragged = "";
};

/** A field picked to sort by: the option's value is its address. */
export const onSortField = (event: Event) => {
  const select = event.target;
  if (select instanceof HTMLSelectElement && select.value) goTo(select.value);
};

export const onSubmit = (event: Event) => {
  const form = event.target;
  if (!(form instanceof HTMLFormElement) || event.defaultPrevented || form.method !== "get") return;
  if (form.target && form.target !== "_self") return;
  const url = table_url(form.action);
  if (!url) return;
  event.preventDefault();
  const params = new URLSearchParams();
  for (const [name, value] of new FormData(form)) {
    if (typeof value === "string") params.append(name, value);
  }
  url.search = params.toString();
  navigate(url, true);
};

export const onSearch = (event: Event) => {
  const box = event.target;
  if (!(box instanceof HTMLInputElement)) return;
  clearTimeout(search_timer);
  state.request_url = "";
  state.busy = false;
  if (event instanceof InputEvent && event.isComposing) return;
  search_timer = setTimeout(() => {
    if (root_ref.current?.isConnected && box.isConnected) box.form?.requestSubmit();
  }, 300);
};

export const onPopState = () => {
  const url = table_url(location.href);
  if (url) navigate(url, false);
};

const page_rows = () =>
  [...(root_ref.current?.querySelectorAll<HTMLElement>("[data-row-id]") ?? [])].filter(
    (row) => row.closest('[data-part="data-table"]') === root_ref.current,
  );

const selection = (ids: string[]) => {
  state.selectedRowIds = ids;
  state.allMatching = false;
  state.selectedCount = ids.length;
  state.anySelected = ids.length > 0;
  state.allSelected = ids.length > 0 && ids.length === page_rows().length;
  state.partiallySelected = ids.length > 0 && !state.allSelected;
  state.selectionRevision++;
};

export const clearSelection = () => {
  anchor = "";
  selection([]);
};
// A shift-click ticks (or clears) every row from the last one clicked to this one. The
// click comes before the change, so it says whether shift was held.
let anchor = "";
let ranged = false;
export const rowSelectionClicked = (event: Event) => {
  ranged = event instanceof MouseEvent && event.shiftKey;
};
export const rowSelectionChanged = (event: Event) => {
  const input = event.target;
  if (!(input instanceof HTMLInputElement)) return;
  const id = input.closest<HTMLElement>("[data-row-id]")?.dataset.rowId;
  if (!id) return;
  const order = page_rows()
    .map((row) => row.dataset.rowId!)
    .filter((row) => !state.hiddenRowIds.includes(row));
  const from = ranged && anchor ? order.indexOf(anchor) : -1;
  const to = order.indexOf(id);
  const changed =
    from >= 0 && to >= 0 ? order.slice(Math.min(from, to), Math.max(from, to) + 1) : [id];
  if (from >= 0) document.getSelection()?.removeAllRanges();
  ranged = false;
  anchor = id;
  const kept = state.selectedRowIds.filter((value) => !changed.includes(value));
  selection(input.checked ? [...kept, ...changed] : kept);
};
export const selectMatching = () => {
  state.allMatching = true;
  state.selectedCount = state.total;
  state.selectionRevision++;
};
export const pageSelectionChanged = (event: Event) => {
  const input = event.target;
  if (!(input instanceof HTMLInputElement)) return;
  anchor = "";
  selection(input.checked ? page_rows().map((row) => row.dataset.rowId!) : []);
};
export const toggleColumn = (event: Event) => {
  const column = (event.currentTarget as HTMLElement).dataset.columnToggle!;
  state.hiddenColumns = state.hiddenColumns.includes(column)
    ? state.hiddenColumns.filter((value) => value !== column)
    : [...state.hiddenColumns, column];
};
export const filterRows = (event: Event) => {
  const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
  const rows = page_rows();
  state.hiddenRowIds = rows
    .filter((row) => row.dataset.search && !row.dataset.search.toLowerCase().includes(query))
    .map((row) => row.dataset.rowId!);
  state.visibleCount = rows.length - state.hiddenRowIds.length;
};
Publr.effect(() => {
  const revision = state.selectionRevision;
  if (!revision) return;
  root_ref.current?.dispatchEvent(
    new CustomEvent("datatableselectionchange", {
      bubbles: true,
      detail: { selectedRowIds: [...state.selectedRowIds], allMatching: state.allMatching },
    }),
  );
});

export const retry = () => result.refresh();
/** The rows again, from the server, after something changed them: a `datatablereload`
 * event from within the table asks for it. */
export const reload = () => {
  if (state.address) navigate(new URL(state.address, location.href), false);
};

Publr.effect(() => {
  state.busy = result.pending();
  const failed = result.isError();
  const next = result.peek();
  if (result.pending()) return;
  Publr.untrack(() => {
    const root = root_ref.current;
    if (!root?.isConnected || !state.request_url) return;
    if (failed) {
      state.error = Publr.t("Could not load results. Try again.");
      return;
    }
    if (!next || next === committed) return;
    if (!next.data || !Array.isArray(next.data.rows) || !table_url(next.data.address)) {
      state.error = Publr.t("Could not load results. Try again.");
      return;
    }
    committed = next;
    state.address = next.data.address;
    state.columns = next.data.columns;
    state.rows = next.data.rows;
    state.empty = next.data.rows.length === 0;
    state.total = next.data.total;
    state.pages = next.data.pages;
    state.previous_href = next.data.previous_href;
    state.next_href = next.data.next_href;
    state.range_text = next.data.range_text;
    state.sort_options = next.data.sort_options ?? [];
    state.direction_options = next.data.direction_options ?? [];
    state.page_size_options = next.data.page_size_options ?? [];
    state.properties = next.data.properties ?? [];
    clearSelection();
    state.filters = next.data.filters;
    state.hidden = next.data.hidden;
    state.search = next.data.search;
    state.add_filters = next.data.add_filters;
    state.empty_text = next.data.empty_text;
    state.error = "";
    root.dispatchEvent(new CustomEvent("datatableload", { bubbles: true, detail: next.context }));
    if (push_history && location.pathname + location.search !== next.data.address)
      history.pushState(null, "", next.data.address);
    if (to_top) root.scrollIntoView({ block: "start" });
    to_top = false;
    state.revision++;
  });
});

Publr.effect(() => {
  const revision = state.revision;
  if (!revision || !open_filter) return;
  const trigger = triggers.get(open_filter);
  open_filter = "";
  if (trigger?.isConnected && trigger.getAttribute("aria-expanded") !== "true") trigger.click();
});

export function DataTable({
  id,
  classes = "",
  address = "",
  columns = [],
  rows = [],
  filters = [],
  hidden = [],
  search = "",
  add_filters = [],
  empty_text = "",
  total = 0,
  selectable = false,
  bulk,
  pages = [],
  previous_href = "",
  next_href = "",
  range_text = "",
  sort_options = [],
  direction_options = [],
  page_size_options = [],
  properties = [],
  search_name = "q",
  children,
}: DataTableProps) {
  state.address = address;
  state.columns = columns;
  state.rows = rows;
  state.filters = filters;
  state.hidden = hidden;
  state.search = search;
  state.add_filters = add_filters;
  state.empty_text = empty_text;
  state.empty = rows.length === 0;
  state.total = total;
  state.pages = pages;
  state.previous_href = previous_href;
  state.next_href = next_href;
  state.range_text = range_text;
  state.sort_options = sort_options;
  state.direction_options = direction_options;
  state.page_size_options = page_size_options;
  state.properties = properties;

  return (
    <div
      id={id}
      class={["flex flex-1 flex-col", classes]}
      data-part="data-table"
      ref={root_ref}
      data-address={state.address}
      aria-busy={state.busy}
      onSubmit={onSubmit}
      onDatatablereload={reload}
      onWindowPopState={onPopState}
    >
      {children}
      {address && (
        <div>
          <FilterBar classes="px-5">
            {state.filters.map((filter) => (
              <FilterPill key={filter.id} id={filter.id}>
                <FilterPillLabel>{filter.label}</FilterPillLabel>
                {filter.operators.length > 1 ? (
                  <DropdownMenu classes="flex">
                    <DropdownMenuTrigger asChild>
                      <FilterPillOperator label={Publr.t("Change filter operator")}>
                        {filter.operator}
                      </FilterPillOperator>
                    </DropdownMenuTrigger>
                    <DropdownMenuContent>
                      {filter.operators.map((option) => (
                        <DropdownMenuCheckboxItem
                          key={option.label}
                          onClick={onNavigate}
                          href={option.href}
                          checked={option.selected}
                        >
                          {option.label}
                        </DropdownMenuCheckboxItem>
                      ))}
                    </DropdownMenuContent>
                  </DropdownMenu>
                ) : (
                  <FilterPillOperator fixed>{filter.operator}</FilterPillOperator>
                )}
                <FilterPillBody attached>
                  {filter.value_kind !== "none" && (
                    <DropdownMenu classes="flex">
                      <DropdownMenuTrigger asChild ref={trigger_ref} data-table-trigger={filter.id}>
                        <FilterPillValue attached>{filter.value}</FilterPillValue>
                      </DropdownMenuTrigger>
                      {(filter.value_kind === "day" ||
                        filter.value_kind === "text" ||
                        filter.value_kind === "number") && (
                        <DropdownMenuContent>
                          <form
                            onSubmit={onSubmit}
                            method="get"
                            action={state.address}
                            class="flex items-center gap-2 p-1"
                          >
                            {filter.carried.map((field) => (
                              <input
                                key={field.id}
                                type="hidden"
                                name={field.name}
                                value={field.value}
                              />
                            ))}
                            <input
                              type="hidden"
                              name={filter.operator_name}
                              value={filter.operator_id}
                            />
                            <Input
                              type={
                                filter.value_kind === "day"
                                  ? "date"
                                  : filter.value_kind === "number"
                                    ? "number"
                                    : "text"
                              }
                              size="sm"
                              name={filter.name}
                              value={filter.day}
                              aria-label={filter.label}
                              required
                              classes="w-40"
                            />
                            <Button type="submit" size="sm">
                              {Publr.t("Apply")}
                            </Button>
                          </form>
                        </DropdownMenuContent>
                      )}
                      {(filter.value_kind === "number_range" || filter.value_kind === "day_range") && (
                        <DropdownMenuContent>
                          <form
                            onSubmit={onSubmit}
                            method="get"
                            action={state.address}
                            class="flex items-center gap-2 p-1"
                          >
                            {filter.carried.map((field) => (
                              <input
                                key={field.id}
                                type="hidden"
                                name={field.name}
                                value={field.value}
                              />
                            ))}
                            <input
                              type="hidden"
                              name={filter.operator_name}
                              value={filter.operator_id}
                            />
                            <Input
                              type={filter.value_kind === "day_range" ? "date" : "number"}
                              size="sm"
                              name={filter.low_name}
                              value={filter.low}
                              aria-label={Publr.t("From")}
                              required
                              classes="w-36"
                            />
                            <Text as="span" variant="body-sm" tone="muted">
                              {Publr.t("and")}
                            </Text>
                            <Input
                              type={filter.value_kind === "day_range" ? "date" : "number"}
                              size="sm"
                              name={filter.high_name}
                              value={filter.high}
                              aria-label={Publr.t("To")}
                              required
                              classes="w-36"
                            />
                            <Button type="submit" size="sm">
                              {Publr.t("Apply")}
                            </Button>
                          </form>
                        </DropdownMenuContent>
                      )}
                      {filter.value_kind === "span" && (
                        <DropdownMenuContent>
                          <form
                            onSubmit={onSubmit}
                            method="get"
                            action={state.address}
                            class="flex items-center gap-2 p-1"
                          >
                            {filter.carried.map((field) => (
                              <input
                                key={field.id}
                                type="hidden"
                                name={field.name}
                                value={field.value}
                              />
                            ))}
                            <input
                              type="hidden"
                              name={filter.operator_name}
                              value={filter.operator_id}
                            />
                            <Input
                              type="number"
                              size="sm"
                              name={filter.count_name}
                              value={filter.count}
                              aria-label={Publr.t("How many")}
                              required
                              classes="w-20"
                            />
                            <NativeSelect size="sm" name={filter.unit_name} label={Publr.t("Unit")} classes="w-28">
                              <option value="d" selected={filter.unit === "d"}>
                                {Publr.t("days")}
                              </option>
                              <option value="w" selected={filter.unit === "w"}>
                                {Publr.t("weeks")}
                              </option>
                              <option value="m" selected={filter.unit === "m"}>
                                {Publr.t("months")}
                              </option>
                              <option value="y" selected={filter.unit === "y"}>
                                {Publr.t("years")}
                              </option>
                            </NativeSelect>
                            <Button type="submit" size="sm">
                              {Publr.t("Apply")}
                            </Button>
                          </form>
                        </DropdownMenuContent>
                      )}
                      {filter.value_kind === "choice" && (
                        <DropdownMenuContent>
                          {filter.searchable && <DropdownMenuSearch placeholder={Publr.t("Search options")} />}
                          {filter.options.map((option) => (
                            <DropdownMenuCheckboxItem
                              key={option.label}
                              onClick={onNavigate}
                              href={option.href}
                              checked={option.selected}
                            >
                              {option.label}
                            </DropdownMenuCheckboxItem>
                          ))}
                          {filter.reset_href && <DropdownMenuSeparator />}
                          {filter.reset_href && (
                            <DropdownMenuItem onClick={onNavigate} href={filter.reset_href}>
                              {Publr.t("Reset to Any")}
                            </DropdownMenuItem>
                          )}
                        </DropdownMenuContent>
                      )}
                    </DropdownMenu>
                  )}
                  {filter.remove_href && (
                    <FilterPillRemove
                      onClick={onNavigate}
                      href={filter.remove_href}
                      label={Publr.t("Remove filter")}
                    />
                  )}
                </FilterPillBody>
              </FilterPill>
            ))}
            <form method="get" action={state.address} class="flex min-w-40 flex-1 items-stretch">
              {state.hidden.map((field) => (
                <input key={field.id} type="hidden" name={field.name} value={field.value} />
              ))}
              <Input
                ref={search_ref}
                onInput={onSearch}
                onCompositionEnd={onSearch}
                inset
                size="sm"
                type="search"
                aria-label={Publr.t("Search table")}
                name={search_name}
                value={state.search}
                placeholder={Publr.t("Type to search")}
                classes="px-0"
              />
            </form>
            <DropdownMenu classes="flex items-center">
              <DropdownMenuTrigger asChild>
                <Button type="button" hierarchy="tertiary" size="sm">
                  <Icon name="filter-lines" size="sm" />
                  <span>{Publr.t("Filter")}</span>
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="right">
                {state.add_filters.map((item) => (
                  <span key={item.label} class="contents">
                    {item.added ? (
                      <DropdownMenuItem disabled>{item.label}</DropdownMenuItem>
                    ) : (
                      <DropdownMenuItem onClick={onNavigate} href={item.href}>
                        {item.label}
                      </DropdownMenuItem>
                    )}
                  </span>
                ))}
              </DropdownMenuContent>
            </DropdownMenu>
            {state.properties.length > 0 && <DataTableOptions />}
          </FilterBar>
        </div>
      )}
      {state.error && (
        <div role="alert" class="flex items-center gap-3 px-5 py-3">
          <Text variant="body-md">{state.error}</Text>
          <Button hierarchy="secondary" size="sm" onClick={retry}>
            {Publr.t("Retry")}
          </Button>
        </div>
      )}
      {selectable && bulk}
      {selectable && state.allSelected && state.total > state.rows.length && (
        <div
          data-part="select-matching"
          class="flex flex-wrap items-center justify-center gap-x-2 border-b border-border bg-muted/40 px-5 py-1.5"
        >
          {state.allMatching ? (
            <span class="contents">
              <Text as="span" variant="body-sm">
                {Publr.tn(
                  "All {count} matching are selected.",
                  "All {count} matching are selected.",
                  state.total,
                )}
              </Text>
              <Button type="button" hierarchy="link" size="sm" onClick={clearSelection}>
                {Publr.t("Clear selection")}
              </Button>
            </span>
          ) : (
            <span class="contents">
              <Text as="span" variant="body-sm">
                {Publr.tn(
                  "All {count} on this page are selected.",
                  "All {count} on this page are selected.",
                  state.rows.length,
                )}
              </Text>
              <Button type="button" hierarchy="link" size="sm" onClick={selectMatching}>
                {Publr.tn("Select all {count} matching", "Select all {count} matching", state.total)}
              </Button>
            </span>
          )}
        </div>
      )}
      {address && (
        <div class="flex flex-1 flex-col">
          <Table>
            <TableHeader>
              <TableRow>
                {selectable && (
                  <TableHead classes="w-0 pr-1">
                    <DataTableSelectAll classes="block" />
                  </TableHead>
                )}
                {state.columns.map((column) => (
                  <TableHead
                    key={column.id}
                    data-align={column.align}
                    classes="first-of-type:pl-5 data-[align=end]:text-right"
                  >
                    {column.menu.length > 0 ? (
                      <DropdownMenu classes="inline-flex">
                        <DropdownMenuTrigger asChild>
                          <button
                            type="button"
                            data-sort-active={column.active ? "true" : "false"}
                            class="inline-flex cursor-pointer items-center gap-1 rounded text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring data-[sort-active=true]:text-foreground"
                          >
                            <Text as="span" variant="body-sm" tone="default">
                              {column.label}
                            </Text>
                            {column.sort === "asc" && <Icon name="arrow-up" size="xs" />}
                            {column.sort === "desc" && <Icon name="arrow-down" size="xs" />}
                          </button>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent>
                          {column.menu.map((item) => (
                            <DropdownMenuItem key={item.id} onClick={onNavigate} href={item.href}>
                              {item.icon === "arrow-up" ? (
                                <Icon name="arrow-up" size="sm" />
                              ) : item.icon === "arrow-down" ? (
                                <Icon name="arrow-down" size="sm" />
                              ) : item.icon === "arrow-left" ? (
                                <Icon name="arrow-left" size="sm" />
                              ) : item.icon === "arrow-right" ? (
                                <Icon name="arrow-right" size="sm" />
                              ) : item.icon === "eye-off" ? (
                                <Icon name="eye-off" size="sm" />
                              ) : (
                                <Icon name="filter-lines" size="sm" />
                              )}
                              {item.label}
                            </DropdownMenuItem>
                          ))}
                        </DropdownMenuContent>
                      </DropdownMenu>
                    ) : column.href ? (
                      <Link
                        onClick={onNavigate}
                        href={column.href}
                        variant="body-sm"
                        tone="quiet"
                        data-sort-active={column.active ? "true" : "false"}
                        classes="data-[sort-active=true]:text-foreground"
                      >
                        {column.label}
                      </Link>
                    ) : (
                      column.label
                    )}
                  </TableHead>
                ))}
              </TableRow>
            </TableHeader>
            <TableBody>
              {state.rows.map((row) => (
                <TableRow key={row.id} data-row-id={row.id}>
                  {selectable && (
                    <TableCell classes="w-0 pr-1">
                      <DataTableRowSelect classes="block" />
                    </TableCell>
                  )}
                  {row.cells.map((cell) => (
                    <TableCell
                      key={cell.id}
                      data-cell-kind={cell.kind}
                      classes="first-of-type:pl-5 data-[cell-kind=numeric]:whitespace-nowrap data-[cell-kind=numeric]:tabular-nums data-[cell-kind=amount]:whitespace-nowrap data-[cell-kind=amount]:text-right data-[cell-kind=amount]:tabular-nums data-[cell-kind=action]:text-right"
                    >
                      {cell.kind === "thumbs" ? (
                        <span class="inline-flex items-center gap-1">
                          {cell.items.map((item) => (
                            <span key={item.id} class="contents">
                              {item.thumb ? (
                                <img
                                  src={item.thumb}
                                  alt={item.label}
                                  title={item.label}
                                  loading="lazy"
                                  class="size-8 rounded object-cover"
                                />
                              ) : (
                                <Text as="span" variant="body-sm" tone="muted">
                                  {item.label}
                                </Text>
                              )}
                            </span>
                          ))}
                          {cell.text && (
                            <Text as="span" variant="body-sm" tone="muted">
                              {cell.text}
                            </Text>
                          )}
                        </span>
                      ) : cell.kind === "links" ? (
                        <span class="inline-flex flex-wrap items-center gap-x-2">
                          {cell.items.map((item) => (
                            <Link key={item.id} href={item.href} variant="body-sm" tone="default">
                              {item.label}
                            </Link>
                          ))}
                          {cell.text && (
                            <Text as="span" variant="body-sm" tone="muted">
                              {cell.text}
                            </Text>
                          )}
                        </span>
                      ) : cell.kind === "action" ? (
                        <Link href={cell.href} label={cell.text} tone="quiet" classes="inline-flex">
                          <Icon name="chevron-right" size="sm" />
                        </Link>
                      ) : cell.kind === "status" ? (
                        <span>
                          {cell.tone === "success" ? (
                            <Status tone="success">{cell.text}</Status>
                          ) : cell.tone === "error" ? (
                            <Status tone="error">{cell.text}</Status>
                          ) : cell.tone === "warning" ? (
                            <Status tone="warning">{cell.text}</Status>
                          ) : cell.tone === "accent" ? (
                            <Status tone="accent">{cell.text}</Status>
                          ) : cell.tone === "review" ? (
                            <Status tone="review">{cell.text}</Status>
                          ) : (
                            <Status tone="neutral">{cell.text}</Status>
                          )}
                        </span>
                      ) : cell.href ? (
                        <Link href={cell.href} variant="body-md" tone="default">
                          {cell.text}
                        </Link>
                      ) : cell.kind === "mono" ? (
                        <Text as="span" variant="mono-xs" tone="muted">
                          {cell.text}
                        </Text>
                      ) : (
                        <Text as="span" variant="body-md" tone="muted">
                          {cell.text}
                        </Text>
                      )}
                      {cell.extra && (
                        <span class="ml-3">
                          {cell.extra_tone === "success" ? (
                            <Status tone="success">{cell.extra}</Status>
                          ) : cell.extra_tone === "error" ? (
                            <Status tone="error">{cell.extra}</Status>
                          ) : cell.extra_tone === "warning" ? (
                            <Status tone="warning">{cell.extra}</Status>
                          ) : cell.extra_tone === "accent" ? (
                            <Status tone="accent">{cell.extra}</Status>
                          ) : cell.extra_tone === "review" ? (
                            <Status tone="review">{cell.extra}</Status>
                          ) : (
                            <Status tone="neutral">{cell.extra}</Status>
                          )}
                        </span>
                      )}
                    </TableCell>
                  ))}
                </TableRow>
              ))}
            </TableBody>
          </Table>
          {state.empty && (
            <Empty>
              <EmptyTitle>{Publr.t("Nothing here")}</EmptyTitle>
              <EmptyDescription>{state.empty_text}</EmptyDescription>
            </Empty>
          )}
          {state.pages.length > 1 && (
            <div
              data-part="pagination"
              class="flex flex-wrap items-center gap-3 border-t border-border px-5 py-3"
            >
              <Text as="span" variant="body-sm" tone="muted" classes="whitespace-nowrap tabular-nums">
                {state.range_text}
              </Text>
              <Pagination classes="flex-1 sm:justify-end">
                <PaginationContent>
                  <PaginationItem>
                    {state.previous_href ? (
                      <PaginationPrevious href={state.previous_href} onClick={onNavigate} />
                    ) : (
                      <PaginationPrevious />
                    )}
                  </PaginationItem>
                  {state.pages.map((link) => (
                    <PaginationItem key={link.id}>
                      {link.current ? (
                        <PaginationLink isActive>{link.label}</PaginationLink>
                      ) : link.href ? (
                        <PaginationLink href={link.href} onClick={onNavigate}>
                          {link.label}
                        </PaginationLink>
                      ) : (
                        <PaginationEllipsis />
                      )}
                    </PaginationItem>
                  ))}
                  <PaginationItem>
                    {state.next_href ? (
                      <PaginationNext href={state.next_href} onClick={onNavigate} />
                    ) : (
                      <PaginationNext />
                    )}
                  </PaginationItem>
                </PaginationContent>
              </Pagination>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
