import { Publr } from "publr-jsx";
import { filterRows } from "./DataTable.ptsx";
import { Input } from "../Input/Input.ptsx";
export type DataTableFilterProps = {
  id?: string;
  classes?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  label?: string;
};
export function DataTableFilter({
  id,
  classes = "",
  name,
  value = "",
  placeholder = "",
  label = "",
}: DataTableFilterProps) {
  return (
    <Input
      id={id}
      type="search"
      name={name}
      value={value}
      placeholder={placeholder !== "" ? placeholder : Publr.t("Filter rows…")}
      aria-label={label !== "" ? label : Publr.t("Filter rows")}
      classes={classes}
      onInput={filterRows}
    />
  );
}
