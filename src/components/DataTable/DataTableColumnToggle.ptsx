// Column-visibility menu item for the DataTable's columns dropdown: the
// DropdownMenuCheckboxItem anatomy (kept verbatim — the column key and the
// store action must land on the real menuitemcheckbox element in both
// targets) driven by the data-table store instead of a static checked prop.
// Checked means visible; toggling does not dismiss the menu, so several
// columns can be adjusted in one open.
import { Publr } from "publr-jsx";
import { state, toggleColumn } from "./DataTable.ptsx";
import { Icon } from "../Icon/Icon.ptsx";

export type DataTableColumnToggleProps = {
  id?: string;
  classes?: string;
  column: string;
  children: JSX.Element;
};

export function DataTableColumnToggle({
  id,
  classes = "",
  column,
  children,
}: DataTableColumnToggleProps) {
  return (
    <button
      type="button"
      id={id}
      role="menuitemcheckbox"
      aria-checked={
        state.hiddenColumns.includes(Publr.dataset("columnToggle")) ? "false" : "true"
      }
      tabindex={-1}
      data-part="item"
      data-column-toggle={column}
      class={[
        "flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-foreground outline-none transition-colors hover:bg-ui-accent focus-visible:bg-ui-accent focus-visible:text-foreground",
        classes,
      ]}
      onClick={toggleColumn}
    >
      <span
        class={[
          "inline-flex",
          state.hiddenColumns.includes(Publr.dataset("columnToggle")) ? "invisible" : "",
        ]}
      >
        <Icon name="check" size="xs" />
      </span>
      {children}
    </button>
  );
}
