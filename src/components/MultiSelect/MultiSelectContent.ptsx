import { state, content, keepFocus, dismiss } from "./MultiSelect.ptsx";

export type MultiSelectContentProps = {
  id?: string;
  children: JSX.Element;
  align?: "left" | "right";
  classes?: string;
};

export function MultiSelectContent({
  id,
  children,
  align = "left",
  classes = "",
}: MultiSelectContentProps) {
  return (
    <div
      id={id}
      role="listbox"
      aria-multiselectable="true"
      data-part="content"
      data-publr-position-offset="2"
      ref={content}
      onMouseDown={keepFocus}
      onDismiss={dismiss}
      portal
      position={align}
      hidden={!state.open}
      class={[
        "hidden fixed z-50 max-h-[var(--publr-available-height)] w-max max-w-[calc(100vw-1rem)] flex-col gap-[1px] overflow-auto rounded-lg border border-border bg-popover p-1 text-popover-foreground shadow-lg",
        state.open ? "flex" : "",
        "min-w-[var(--publr-anchor-width)]",
        classes,
      ]}
    >
      {children}
    </div>
  );
}
