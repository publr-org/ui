// One step: its number in a ring, the title beside it, and the details (a line of
// text, a command) under the title. The rule to the next marker ends at the last step.
import { Text } from "../Text/Text.ptsx";

export type StepProps = {
  number: number;
  title: string;
  children?: JSX.Element;
  classes?: string;
  id?: string;
};

export function Step({ number, title, children, classes = "", id }: StepProps) {
  return (
    <li id={id} class={["group/step relative flex gap-4 pb-7 last:pb-0", classes]} data-part="step">
      <span
        aria-hidden="true"
        class="absolute top-9 bottom-1 left-3.5 w-px bg-border group-last/step:hidden"
      ></span>
      <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-border bg-muted">
        <Text as="span" variant="heading-xs">
          {number}
        </Text>
      </span>
      <div class="flex min-w-0 flex-1 flex-col gap-2 pt-0.5">
        <Text as="span" variant="heading-xs">
          {title}
        </Text>
        {children}
      </div>
    </li>
  );
}
