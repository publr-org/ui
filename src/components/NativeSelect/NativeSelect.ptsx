import { Icon } from "../Icon/Icon.ptsx";

// Styled native <select> for plain form submits (GET filters, POST forms).
// The compound Select remains the rich listbox; NativeSelect exists for the
// cases where native form semantics — submit-on-change, no-JS fallback,
// form= association — are the point. The browser's arrow is replaced by the design
// system's chevron; `classes` lays out the whole control. Selection is authored natively via
// `selected` on option children; there is no options-array or value API.

export type NativeSelectProps = {
  children?: JSX.Element;
  label?: string;
  classes?: string;
  disabled?: boolean;
  form?: string;
  id?: string;
  invalid?: boolean;
  name?: string;
  onChange?: (event: Event) => void;
  onInput?: (event: Event) => void;
  required?: boolean;
  /** Drawn without its own border and shadow: inside an InputGroup, which owns them. */
  inset?: boolean;
  /** The text size, as Input's: `md` the form default, `sm` beside small inputs. */
  size?: "sm" | "md";
};

const SIZE_CLASSES: Record<"sm" | "md", string> = {
  sm: "text-body-sm",
  md: "text-base leading-6",
};

export function NativeSelect({
  children,
  label,
  classes = "",
  disabled = false,
  form,
  id,
  invalid = false,
  name,
  onChange,
  onInput,
  required = false,
  inset = false,
  size = "md",
}: NativeSelectProps) {
  return (
    <span
      class={["relative flex min-w-0", inset ? "shrink-0" : "w-full", classes]}
      data-part="native-select"
    >
      <select
        aria-label={label}
        id={id}
        name={name}
        form={form}
        disabled={disabled}
        required={required}
        aria-invalid={invalid}
        onInput={onInput}
        onChange={onChange}
        class={[
          "flex w-full min-w-0 cursor-pointer appearance-none py-2 pl-3.5 pr-9 font-normal text-foreground transition duration-150 placeholder:text-muted-foreground focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50",
          SIZE_CLASSES[size],
          inset
            ? "border-0 border-l border-input bg-muted/40 rounded-none shadow-none"
            : "rounded-lg border bg-card shadow-xs hover:border-muted-foreground/40 focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/15",
          inset ? "" : invalid ? "border-destructive" : "border-input",
        ]}
      >
        {children}
      </select>
      <Icon
        name="chevron-down"
        size="sm"
        classes="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground"
      />
    </span>
  );
}
