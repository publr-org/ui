// A conversation in a corner of the window, over whatever page is open: a title row with its
// status and buttons, the conversation scrolling under it, and a foot to reply from. The
// caller places it; on a phone it takes the width.
import { Text } from "../Text/Text.ptsx";

export type ChatPanelProps = {
  /** What the conversation is about: its first words. */
  title: string;
  /** Beside the title: where the conversation is (a Status). */
  status?: JSX.Element;
  /** Buttons at the title row's end: open elsewhere, make small, close. */
  actions?: JSX.Element;
  /** The conversation; the caller's element scrolls it. */
  children?: JSX.Element;
  /** Under the conversation: the reply box, or Stop while it works. */
  footer?: JSX.Element;
  classes?: string;
};

export function ChatPanel({ title, status, actions, children, footer, classes = "" }: ChatPanelProps) {
  return (
    <section
      aria-label={title}
      class={["flex max-h-[min(42rem,calc(100dvh-3rem))] w-full flex-col overflow-hidden rounded-2xl border border-border bg-card text-card-foreground shadow-[0_16px_40px_rgb(0_0_0/0.18)] sm:w-96", classes]}
      data-part="chat-panel"
    >
      <div class="flex shrink-0 items-center gap-2 border-b border-border py-2 pr-2 pl-4">
        <div class="flex min-w-0 flex-1 flex-col">
          <Text as="span" variant="label-sm-strong" classes="truncate">
            {title}
          </Text>
          {status}
        </div>
        {actions && <div class="flex shrink-0 items-center gap-0.5">{actions}</div>}
      </div>
      <div class="flex min-h-0 flex-1 flex-col">{children}</div>
      {footer && <div class="shrink-0 border-t border-border p-3">{footer}</div>}
    </section>
  );
}
