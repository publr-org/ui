import { state, content, contentKeydown, activate, dismiss } from "./Dropdown.ptsx";

export type DropdownMenuContentProps = {
  id?: string;
  classes?: string;
  align?: "left" | "right";
  /** `sm`: a compact actions menu (inspector sections); `lg`: the block toolbar's menus. */
  size?: "sm" | "md" | "lg";
  children?: JSX.Element;
};

const SIZE_CLASSES = { sm: "min-w-36 p-1", md: "p-1", lg: "min-w-56 p-1.5" } as const;

export function DropdownMenuContent({
  id,
  classes = "",
  align = "left",
  size = "md",
  children,
}: DropdownMenuContentProps) {
  return (
    <div
      id={id}
      class={[
        "hidden fixed z-50 max-h-[var(--publr-available-height)] min-w-[var(--publr-anchor-width)] max-w-[calc(100vw-1rem)] overflow-auto rounded-lg border border-border bg-popover text-sm text-popover-foreground shadow-lg",
        SIZE_CLASSES[size],
        classes,
      ]}
      role="menu"
      data-part="content"
      data-publr-position-offset="2"
      ref={content}
      onKeyDown={contentKeydown}
      onClick={activate}
      onDismiss={dismiss}
      portal
      position={align}
      hidden={!state.open}
    >
      {children}
    </div>
  );
}
