// Multi-select menu item: a menuitemcheckbox with a leading check that shows
// while checked. Unlike DropdownMenuItem, activating it does NOT dismiss the
// menu (the dropdown behavior only closes on plain menuitems), so several
// choices can be toggled in one open. Links (href) still navigate — a
// server-side filter toggle closes with the navigation itself.

import { Dynamic } from "publr-jsx";
import { Icon } from "../Icon/Icon.ptsx";

export type DropdownMenuCheckboxItemBaseProps = {
  id?: string;
  classes?: string;
  checked?: boolean;
  children: JSX.Element;
};

export type DropdownMenuCheckboxItemProps = DropdownMenuCheckboxItemBaseProps &
  ({ href: string; disabled?: never } | { href?: undefined; disabled?: boolean });

export function DropdownMenuCheckboxItem({
  id,
  classes = "",
  checked = false,
  href,
  disabled = false,
  children,
}: DropdownMenuCheckboxItemProps) {
  return (
    <Dynamic
      as={href === undefined ? "button" : "a"}
      id={id}
      href={href}
      type={href === undefined ? "button" : undefined}
      disabled={href === undefined ? disabled : undefined}
      role="menuitemcheckbox"
      aria-checked={checked}
      tabindex={-1}
      data-part="item"
      class={[
        "group/checkitem flex w-full cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-left text-foreground outline-none transition-colors hover:bg-ui-accent focus-visible:bg-ui-accent focus-visible:text-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
        classes,
      ]}
    >
      <Icon name="check" size="xs" classes="group-aria-[checked=false]/checkitem:invisible" />
      {children}
    </Dynamic>
  );
}
