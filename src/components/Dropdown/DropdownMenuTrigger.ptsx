import { Slot } from "publr-jsx";
import { state, toggle, trigger, triggerKeydown } from "./Dropdown.ptsx";

export type DropdownMenuTriggerProps = {
  id?: string;
  classes?: string;
  asChild?: boolean;
  /** The accessible name, when the children are only a picture: "Account". */
  label?: string;
  children: JSX.Element;
};

export function DropdownMenuTrigger({
  id,
  classes = "",
  asChild = false,
  label,
  children,
}: DropdownMenuTriggerProps) {
  return (
    <>
      {asChild ? (
        <Slot
          id={id}
          class={classes}
          data-part="trigger"
          anchor
          ref={trigger}
          onClick={toggle}
          onKeyDown={triggerKeydown}
          aria-haspopup="menu"
          aria-expanded={state.open}
          aria-label={label}
        >
          {children}
        </Slot>
      ) : (
        <button
          id={id}
          class={classes}
          type="button"
          data-part="trigger"
          anchor
          ref={trigger}
          onClick={toggle}
          onKeyDown={triggerKeydown}
          aria-haspopup="menu"
          aria-expanded={state.open}
          aria-label={label}
        >
          {children}
        </button>
      )}
    </>
  );
}
