import { Publr, Slot } from "publr-jsx";
import { opener, state, toggle, trigger, triggerKeydown } from "./Dropdown.ptsx";

export type DropdownMenuTriggerProps = {
  id?: string;
  classes?: string;
  asChild?: boolean;
  /** The accessible name, when the children are only a picture: "Account". */
  label?: string;
  /** A key that opens the menu from anywhere on the page (a search box in it takes the
   * focus): `(event) => event.metaKey && event.code === "KeyK"`. */
  openOn?: (event: KeyboardEvent) => boolean;
  children: JSX.Element;
};

export function DropdownMenuTrigger({
  id,
  classes = "",
  asChild = false,
  label,
  openOn,
  children,
}: DropdownMenuTriggerProps) {
  if (openOn) {
    const open = opener();
    Publr.effect(() => {
      const onKey = (event: KeyboardEvent) => {
        if (event.defaultPrevented || !openOn(event)) return;
        event.preventDefault();
        open();
      };
      window.addEventListener("keydown", onKey);
      return () => window.removeEventListener("keydown", onKey);
    });
  }
  return (
    <>
      {asChild ? (
        <Slot
          id={id}
          class={classes}
          data-part="trigger"
          anchor
          ref={trigger}
          onClick={toggle}
          onKeyDown={triggerKeydown}
          aria-haspopup="menu"
          aria-expanded={state.open}
          aria-label={label}
        >
          {children}
        </Slot>
      ) : (
        <button
          id={id}
          class={classes}
          type="button"
          data-part="trigger"
          anchor
          ref={trigger}
          onClick={toggle}
          onKeyDown={triggerKeydown}
          aria-haspopup="menu"
          aria-expanded={state.open}
          aria-label={label}
        >
          {children}
        </button>
      )}
    </>
  );
}
