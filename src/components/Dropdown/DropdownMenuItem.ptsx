import { Dynamic } from "publr-jsx";
import { Text } from "../Text/Text.ptsx";

export type DropdownMenuItemVariant = "default" | "destructive";
export type DropdownMenuItemType = "button" | "submit" | "reset";

type DropdownMenuItemSharedProps = {
  id?: string;
  classes?: string;
  variant?: DropdownMenuItemVariant;
  /** `xs`: an editor's dense menu's item; `sm`: a compact actions menu's item; `lg`: a
   * block toolbar menu's item. */
  size?: "xs" | "sm" | "md" | "lg";
  /** The current choice in a menu of choices: ringed. */
  active?: boolean;
  children?: JSX.Element;
  onClick?: (event: MouseEvent) => void;
};

export type DropdownMenuItemProps = DropdownMenuItemSharedProps &
  (
    | { href: string; disabled?: never; type?: never }
    | { href?: never; disabled?: boolean; type?: DropdownMenuItemType }
  );

const SIZE_CLASSES = {
  xs: "h-6 rounded-[5px] px-2",
  sm: "rounded-[calc(var(--radius)-2px)] px-2.5 py-2",
  md: "rounded-md px-2 py-1.5",
  lg: "min-h-9 gap-2.5 rounded-md px-2.5 py-2",
} as const;

const TEXT_SIZES = { xs: "label-sm", sm: "label-md", md: "body-md", lg: "label-lg" } as const;

const VARIANT_CLASSES: Record<DropdownMenuItemVariant, string> = {
  default: "text-foreground hover:bg-ui-accent",
  destructive: "text-destructive hover:bg-destructive/10",
};

export function DropdownMenuItem({
  id,
  classes = "",
  variant = "default",
  size = "md",
  active = false,
  href,
  disabled,
  type,
  children,
  onClick,
}: DropdownMenuItemProps) {
  const hasButtonProps = type !== undefined || disabled !== undefined;
  if (href !== undefined && hasButtonProps) {
    throw new TypeError(
      "[publr-design-system] DropdownMenuItem type and disabled cannot be used with href",
    );
  }

  return (
    <Dynamic
      as={href === undefined ? "button" : "a"}
      id={id}
      class={[
        "flex w-full cursor-pointer items-center gap-2 text-left outline-none disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
        // A dense menu is drawn on the popover's colour, its highlight the accent.
        size === "xs" ? "text-popover-foreground hover:bg-ui-accent focus-visible:bg-ui-accent" : "transition-colors focus-visible:bg-ui-accent focus-visible:text-foreground",
        SIZE_CLASSES[size],
        active ? "shadow-[inset_0_0_0_1.5px_var(--primary)]" : "",
        size === "xs" && variant === "default" ? "" : VARIANT_CLASSES[variant],
        classes,
      ]}
      href={href}
      type={href === undefined ? (type ?? "button") : undefined}
      disabled={disabled}
      role="menuitem"
      aria-disabled={disabled ? "true" : undefined}
      tabindex={-1}
      data-part="item"
      data-dropdown-menu-variant={variant}
      data-publr-state={disabled ? "disabled" : "default"}
      onClick={onClick}
    >
      <Text variant={TEXT_SIZES[size]} classes={size === "lg" ? "flex min-w-0 flex-1 items-center gap-2.5" : "flex min-w-0 flex-1 items-center gap-2"}>
        {children}
      </Text>
    </Dynamic>
  );
}
