// Dumb action primitive. The parent owns state; PTSX declares the render and
// PublrJS supplies fine-grained bindings generated by the compiler.
import { Dynamic } from "publr-jsx";
import { Icon } from "../Icon/Icon.ptsx";
import type { IconSize } from "../Icon/Icon.ptsx";

export const BUTTON_HIERARCHIES = ["primary", "secondary", "tertiary", "link"] as const;
export const BUTTON_INTENTS = ["default", "destructive"] as const;
export const BUTTON_SIZES = ["xs", "sm", "md", "lg"] as const;
export const BUTTON_ATTACHMENTS = ["none", "start", "end"] as const;

export type ButtonHierarchy = (typeof BUTTON_HIERARCHIES)[number];
export type ButtonIntent = (typeof BUTTON_INTENTS)[number];
export type ButtonSize = (typeof BUTTON_SIZES)[number];
export type ButtonAttachment = (typeof BUTTON_ATTACHMENTS)[number];
export type ButtonType = "button" | "submit" | "reset";

type SharedButtonProps = {
  id?: string;
  label?: string;
  hierarchy?: ButtonHierarchy;
  intent?: ButtonIntent;
  size?: ButtonSize;
  /** One half of a SplitButton: `start` is the face, `end` the arrow; the group draws the
   * outline they share. */
  attach?: ButtonAttachment;
  children: JSX.Element;
  title?: string;
  role?: "menuitem";
  classes?: string;
  pressed?: boolean;
  /** A dot at the corner: something here is unsaved, or new, and wants a look. */
  marked?: boolean;
  /** The id of the form a submit button outside it submits. */
  form?: string;
  /** A submit button's own form pair, so one form can tell its submit buttons apart. */
  name?: string;
  value?: string;
  onClick?: (event: MouseEvent) => void;
};

export type ButtonProps = SharedButtonProps &
  (
    | {
        href: string;
        disabled?: never;
        loading?: never;
        type?: never;
      }
    | {
        href?: undefined;
        disabled?: boolean;
        loading?: boolean;
        type?: ButtonType;
      }
  );

const DEFAULT_HIERARCHY_CLASSES: Record<ButtonHierarchy, string> = {
  primary:
    "border-primary bg-primary text-primary-foreground shadow-xs outline-ring hover:border-primary/85 hover:bg-primary/85 aria-[pressed=true]:bg-primary/85 aria-expanded:bg-primary/85",
  secondary:
    "border-border bg-card text-foreground shadow-xs outline-ring hover:border-input hover:bg-muted/50 aria-[pressed=true]:border-ring aria-[pressed=true]:bg-ui-accent aria-expanded:border-ring aria-expanded:bg-ui-accent",
  tertiary:
    "border-transparent bg-transparent text-muted-foreground outline-ring hover:bg-ui-accent hover:text-foreground aria-[pressed=true]:border-ring aria-[pressed=true]:bg-ui-accent aria-[pressed=true]:text-foreground aria-expanded:border-ring aria-expanded:bg-ui-accent aria-expanded:text-foreground",
  link: "border-transparent bg-transparent text-primary outline-ring underline decoration-transparent underline-offset-4 hover:text-primary/80 hover:decoration-current",
};

const DESTRUCTIVE_HIERARCHY_CLASSES: Record<ButtonHierarchy, string> = {
  primary:
    "border-destructive bg-destructive text-destructive-foreground shadow-xs outline-destructive hover:border-destructive/90 hover:bg-destructive/90 aria-[pressed=true]:bg-destructive/90 aria-expanded:bg-destructive/90",
  secondary:
    "border-border bg-card text-destructive shadow-xs outline-destructive hover:border-destructive/30 hover:bg-destructive/5 aria-[pressed=true]:border-destructive/30 aria-[pressed=true]:bg-destructive/10 aria-expanded:border-destructive/30 aria-expanded:bg-destructive/10",
  tertiary:
    "border-transparent bg-transparent text-destructive outline-destructive hover:bg-destructive/10 aria-[pressed=true]:bg-destructive/10 aria-expanded:bg-destructive/10",
  link: "border-transparent bg-transparent text-destructive outline-destructive underline decoration-transparent underline-offset-4 hover:text-destructive/80 hover:decoration-current",
};

const ROOT_SIZE_CLASSES: Record<ButtonSize, string> = {
  xs: "h-6 rounded-md px-2",
  sm: "h-8 rounded-lg px-3",
  md: "h-9 rounded-lg px-3.5",
  lg: "h-10 rounded-lg px-4",
};

const ICON_ONLY_SIZE_CLASSES: Record<ButtonSize, string> = {
  xs: "has-[>[data-part=button-content]>[data-part=icon]:only-child]:w-6 has-[>[data-part=button-content]>[data-part=icon]:only-child]:px-0",
  sm: "has-[>[data-part=button-content]>[data-part=icon]:only-child]:w-8 has-[>[data-part=button-content]>[data-part=icon]:only-child]:px-0",
  md: "has-[>[data-part=button-content]>[data-part=icon]:only-child]:w-9 has-[>[data-part=button-content]>[data-part=icon]:only-child]:px-0",
  lg: "has-[>[data-part=button-content]>[data-part=icon]:only-child]:w-10 has-[>[data-part=button-content]>[data-part=icon]:only-child]:px-0",
};

/// Inside a SplitButton the halves carry no outline of their own: the group draws the
/// border, the corners and the shadow, and the end half draws the seam.
const ATTACH_CLASSES: Record<ButtonAttachment, string> = {
  none: "",
  start: "h-full rounded-none border-0 shadow-none",
  end: "h-full rounded-none border-0 border-l shadow-none",
};

const ATTACH_DIVIDER_CLASSES: Record<ButtonAttachment, string> = {
  none: "",
  start: "",
  end: "border-l-primary-foreground/25",
};

const ATTACH_LIGHT_DIVIDER_CLASSES: Record<ButtonAttachment, string> = {
  none: "",
  start: "",
  end: "border-l-border",
};

const CONTENT_SIZE_CLASSES: Record<ButtonSize, string> = {
  xs: "gap-1",
  sm: "gap-1.5",
  md: "gap-2",
  lg: "gap-2",
};

const CONTENT_TYPOGRAPHY_CLASSES: Record<ButtonSize, string> = {
  xs: "text-body-sm font-medium",
  sm: "text-body-sm font-medium",
  md: "text-sm leading-5 font-medium",
  lg: "text-sm leading-5 font-medium",
};

const SPINNER_SIZES: Record<ButtonSize, IconSize> = {
  xs: "xs",
  sm: "sm",
  md: "sm",
  lg: "md",
};

export function Button({
  classes = "",
  id,
  label,
  hierarchy = "primary",
  intent = "default",
  size = "md",
  attach = "none",
  children,
  title,
  disabled,
  loading,
  role,
  type,
  href,
  pressed,
  marked = false,
  form,
  name,
  value,
  onClick,
}: ButtonProps) {
  const hasButtonProps = type !== undefined || disabled !== undefined || loading !== undefined;

  if (href !== undefined && hasButtonProps) {
    throw new TypeError(
      "[publr-design-system] Button type, disabled, and loading cannot be used with href",
    );
  }

  return (
    <Dynamic
      as={href === undefined ? "button" : "a"}
      id={id}
      href={href}
      form={form}
      name={name}
      value={value}
      type={href === undefined ? (type ?? "button") : undefined}
      class={[
        "group/button relative inline-flex shrink-0 cursor-pointer appearance-none items-center justify-center whitespace-nowrap border transition duration-150 ease-out active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
        intent === "destructive"
          ? DESTRUCTIVE_HIERARCHY_CLASSES[hierarchy]
          : DEFAULT_HIERARCHY_CLASSES[hierarchy],
        ROOT_SIZE_CLASSES[size],
        ICON_ONLY_SIZE_CLASSES[size],
        ATTACH_CLASSES[attach],
        hierarchy === "primary"
          ? ATTACH_DIVIDER_CLASSES[attach]
          : ATTACH_LIGHT_DIVIDER_CLASSES[attach],
        classes,
      ]}
      title={title}
      role={role}
      aria-label={label}
      aria-busy={loading ? "true" : undefined}
      aria-pressed={pressed}
      disabled={loading ? true : disabled}
      data-button-hierarchy={hierarchy}
      data-button-intent={intent}
      data-button-size={size}
      data-publr-state={loading ? "loading" : "idle"}
      data-loading={loading ? "true" : undefined}
      data-marked={marked ? "true" : undefined}
      onClick={onClick}
    >
      {marked && (
        <span
          aria-hidden="true"
          class="absolute -top-1 -right-1 size-2.5 rounded-full border-2 border-card bg-primary"
          data-part="button-mark"
        ></span>
      )}
      {href === undefined && (
        <Icon
          name="sync"
          size={SPINNER_SIZES[size]}
          classes={`absolute shrink-0 animate-spin ${loading ? "" : "hidden"}`}
        />
      )}
      <span
        class={[
          "inline-flex items-center justify-center",
          CONTENT_SIZE_CLASSES[size],
          CONTENT_TYPOGRAPHY_CLASSES[size],
          loading ? "opacity-0" : "",
        ]}
        data-part="button-content"
      >
        {children}
      </span>
    </Dynamic>
  );
}
