// A button whose face is a state: its label and icon in a tinted outline of the state's
// tone, with a stripe down the left edge, solid when the state is the live one and hatched
// when it is not (which site this is, opening the switcher). The tone is semantic,
// as Status's is. A muted prefix can name what the state is (`App`), set off as an input's
// leading text is; several can sit side by side as one control (`attach`); and one with an
// address is a link (opening an app's site).
import { Dynamic } from "publr-jsx";
import { Icon } from "../Icon/Icon.ptsx";
import type { IconName } from "../Icon/Icon.ptsx";
import type { StatusTone } from "../Status/Status.ptsx";
import { Text } from "../Text/Text.ptsx";

export const STATUS_BUTTON_ATTACHMENTS = ["none", "start", "middle", "end"] as const;
export const STATUS_BUTTON_MERGES = ["none", "next", "previous"] as const;

export type StatusButtonAttachment = (typeof STATUS_BUTTON_ATTACHMENTS)[number];
export type StatusButtonMerge = (typeof STATUS_BUTTON_MERGES)[number];

export type StatusButtonProps = {
  id?: string;
  classes?: string;
  tone?: StatusTone;
  /** The live one: a solid stripe; otherwise hatched. */
  live?: boolean;
  /** The stripe down the left edge; off for a picker that is not a state. */
  stripe?: boolean;
  /** Muted text before the label, set off like an input's leading text: what it picks. */
  prefix?: string;
  /** An icon after the label, saying what kind of thing the state is. */
  icon_name?: IconName;
  /** The accessible name when the visible state alone does not say what the button does. */
  label?: string;
  /** Joined to the ones beside it: the start, a middle or the end of one control. */
  attach?: StatusButtonAttachment;
  /** Made one with the neighbour: `next` drops this one's right border, `previous` its left
   * one, so a name and the icon that opens it read as one label, not two boxes. */
  merge?: StatusButtonMerge;
  /** A link instead of a button: where it goes. */
  href?: string;
  target?: "_blank";
  children?: JSX.Element;
  onClick?: (event: MouseEvent) => void;
};

const TONE_CLASSES: Record<StatusTone, string> = {
  neutral: "border-border bg-muted/40 text-muted-foreground hover:bg-muted",
  success: "border-success/40 bg-success/10 text-success hover:bg-success/15",
  warning: "border-warning/40 bg-warning/10 text-warning hover:bg-warning/15",
  error: "border-destructive/40 bg-destructive/10 text-destructive hover:bg-destructive/15",
  accent: "border-primary/40 bg-primary/10 text-primary hover:bg-primary/15",
  review: "border-review/40 bg-review/10 text-review hover:bg-review/15",
  info: "border-info/40 bg-info/10 text-info hover:bg-info/15",
};

const STRIPE_CLASSES: Record<StatusTone, string> = {
  neutral: "bg-muted-foreground/50",
  success: "bg-success/60",
  warning: "bg-warning/60",
  error: "bg-destructive/60",
  accent: "bg-primary/60",
  review: "bg-review/60",
  info: "bg-info/60",
};

const ATTACH_CLASSES: Record<StatusButtonAttachment, string> = {
  none: "rounded-md",
  start: "rounded-l-md",
  middle: "-ml-px",
  end: "-ml-px rounded-r-md",
};

const MERGE_CLASSES: Record<StatusButtonMerge, string> = {
  none: "",
  next: "border-r-0",
  previous: "border-l-0",
};

const MERGED_ATTACH_CLASSES: Record<StatusButtonAttachment, string> = {
  none: "rounded-md",
  start: "rounded-l-md",
  middle: "",
  end: "rounded-r-md",
};

const HATCH = "background-image: repeating-linear-gradient(135deg, currentColor 0 2px, transparent 2px 5px); opacity: 0.5";

export function StatusButton({
  id,
  classes = "",
  tone = "neutral",
  live = false,
  stripe = true,
  prefix,
  icon_name,
  label,
  attach = "none",
  merge = "none",
  href,
  target,
  children,
  onClick,
}: StatusButtonProps) {
  return (
    <Dynamic
      as={href === undefined ? "button" : "a"}
      id={id}
      type={href === undefined ? "button" : undefined}
      href={href}
      target={target}
      rel={href === undefined ? undefined : "noopener"}
      class={[
        "relative inline-flex h-8 shrink-0 items-center gap-2 overflow-hidden border no-underline outline-ring transition-colors hover:no-underline focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-2",
        merge === "previous"
          ? "pl-1"
          : stripe
            ? "pl-4"
            : prefix !== undefined
              ? "pl-0"
              : "pl-2.5",
        merge === "next" ? "pr-1" : children === undefined ? "pr-2" : "pr-2.5",
        TONE_CLASSES[tone],
        merge === "previous" ? MERGED_ATTACH_CLASSES[attach] : ATTACH_CLASSES[attach],
        MERGE_CLASSES[merge],
        classes,
      ]}
      aria-label={label}
      onClick={onClick}
    >
      {stripe && live && (
        <span aria-hidden="true" class={["absolute inset-y-0 left-0 w-1.5", STRIPE_CLASSES[tone]]}></span>
      )}
      {stripe && !live && (
        <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1.5" style={HATCH}></span>
      )}
      {prefix !== undefined && (
        <Text
          as="span"
          variant="body-sm"
          tone="muted"
          classes="flex h-full items-center border-r border-border bg-muted/60 px-2.5"
        >
          {prefix}
        </Text>
      )}
      {children !== undefined && (
        <Text as="span" variant="heading-xs" classes="whitespace-nowrap">{children}</Text>
      )}
      {icon_name && <Icon name={icon_name} size="sm" />}
    </Dynamic>
  );
}
