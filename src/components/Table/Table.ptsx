export type { TableHeaderProps } from "./TableHeader.ptsx";
export type { TableBodyProps } from "./TableBody.ptsx";
export type { TableFooterProps } from "./TableFooter.ptsx";
export type { TableRowProps } from "./TableRow.ptsx";
export type { TableHeadProps } from "./TableHead.ptsx";
export type { TableCellProps } from "./TableCell.ptsx";
