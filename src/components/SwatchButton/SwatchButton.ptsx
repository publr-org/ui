// One color to pick: a round swatch in a grid of choices. The picked one is ringed.

export type SwatchButtonProps = {
  color: string;
  label: string;
  selected?: boolean;
  classes?: string;
  onClick?: (event: MouseEvent) => void;
};

export function SwatchButton({ color, label, selected = false, classes = "", onClick }: SwatchButtonProps) {
  return (
    <button
      type="button"
      aria-label={label}
      title={label}
      aria-pressed={selected ? "true" : "false"}
      class={[
        "aspect-square w-full cursor-pointer rounded-full border-2 border-card p-0 shadow-[0_0_0_1px_var(--color-border)] transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-pressed:shadow-[0_0_0_2px_var(--color-card),0_0_0_4px_var(--color-ring)]",
        classes,
      ]}
      style={{ backgroundColor: color }}
      data-part="swatch-button"
      onClick={onClick}
    ></button>
  );
}
