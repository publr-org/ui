// How far along a task is: a bar filled to `value` of `max`, with its label above it
// (`Resolved 1 / 4`). `width` is the filled share as CSS (`25%`), worked out by the caller.
// `size="lg"` is the bar a long task is watched on; `marks` divide it into the task's parts,
// a tick where each starts and its name under it (`Database`, `Media`).
export type ProgressMark = {
  label: string;
  /** Where the part starts, as a CSS share of the bar (`40%`). */
  at: string;
  /** Its share of the bar, as CSS (`35%`), for its name to sit in. */
  span: string;
};

export type ProgressProps = {
  value: number;
  max: number;
  width: string;
  label: string;
  size?: "sm" | "lg";
  marks?: ProgressMark[];
  classes?: string;
};

export function Progress({ value, max, width, label, size = "sm", marks = [], classes = "" }: ProgressProps) {
  const large = size === "lg";
  return (
    <div class={["flex flex-col", large ? "gap-2" : "gap-1.5", classes]} data-part="progress">
      {label !== "" && (
        <span class={large ? "text-sm leading-5 font-medium text-foreground" : "text-xs leading-4 font-medium text-muted-foreground"}>
          {label}
        </span>
      )}
      <div
        class={["w-full overflow-hidden bg-muted", large ? "h-3 rounded-sm" : "h-1.5 rounded-full"]}
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax={`${max}`}
        aria-valuenow={`${value}`}
        aria-label={label}
      >
        <div
          class={["h-full transition-[width] duration-200", large ? "rounded-sm bg-primary" : "rounded-full bg-success"]}
          style={`width: ${width}`}
        ></div>
      </div>
      {large && (
        <div
          class={["relative h-9 w-full border-t border-border", marks.length > 0 ? "" : "invisible"]}
          data-part="progress-marks"
        >
          {marks.map((mark) => (
            <div class="absolute top-0 flex h-full flex-col" style={`left: ${mark.at}; width: ${mark.span}`}>
              <span class="h-1.5 w-px bg-border"></span>
              <span class="truncate pt-1 text-center text-xs leading-4 text-muted-foreground">{mark.label}</span>
            </div>
          ))}
          <span class="absolute top-0 right-0 h-1.5 w-px bg-border"></span>
        </div>
      )}
    </div>
  );
}
