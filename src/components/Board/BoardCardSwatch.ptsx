// A card's color across its top, with the color's value in a badge at its corner.
// Clicking it opens the system color picker; `pick` is the picker's starting value (a
// six-digit hex: the picker takes no other form).
import { Publr } from "publr-jsx";

export type BoardCardSwatchProps = {
  color: string;
  height: number;
  pick: string;
  label?: string;
  classes?: string;
  onChange?: (event: Event) => void;
};

export function BoardCardSwatch({ color, height, pick, label = "", classes = "", onChange }: BoardCardSwatchProps) {
  return (
    <label
      class={["relative block cursor-pointer rounded-t-lg", classes]}
      style={`background: ${color}; height: ${height}px`}
      data-part="board-card-swatch"
    >
      <input
        type="color"
        class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
        aria-label={label !== "" ? label : Publr.t("Change color")}
        value={pick}
        onChange={onChange}
      />
      <span class="absolute right-2.5 bottom-2 rounded-md bg-background/85 px-1.5 py-0.5 font-mono text-[11px] leading-4 text-foreground backdrop-blur">
        {color}
      </span>
    </label>
  );
}
