// Backdrop + centered modal panel in one part — every demonstrated call
// site pairs them 1:1, so there is no separate overlay part. The backdrop
// root owns pointer dismissal (clicks that land on it, not the panel) and
// the keyboard handler (focus is trapped inside the panel, so every key in
// the dialog bubbles here), and a form submitted inside closes it. SSR renders closed: the static `hidden` class
// is the initial state and `hidden={!state.open}` is the live gate.
import { backdrop, backdropDismiss, closeOnSubmit, dialogKeydown, panel, state } from "./Dialog.ptsx";

export type DialogContentProps = {
  id?: string;
  classes?: string;
  /** `full`: the panel fills the screen but a 1rem margin (a comparison, a long table);
   * `default` sits a little below the top, as wide as its content asks. */
  size?: "default" | "full";
  children?: JSX.Element;
};

export function DialogContent({ id, classes = "", size = "default", children }: DialogContentProps) {
  return (
    <div
      class={["hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 p-4", size === "full" ? "" : "pt-[12vh]"]}
      data-part="backdrop"
      ref={backdrop}
      onClick={backdropDismiss}
      onKeyDown={dialogKeydown}
      onSubmit={closeOnSubmit}
      portal
      hidden={!state.open}
    >
      <div
        id={id}
        class={[
          "relative mx-auto w-full rounded-lg border border-border bg-popover text-popover-foreground shadow-2xl outline-none",
          size === "full" ? "flex h-full max-w-none flex-col overflow-hidden" : "max-w-md p-5",
          classes,
        ]}
        role="dialog"
        aria-modal="true"
        tabindex="-1"
        data-part="panel"
        ref={panel}
      >
        {children}
      </div>
    </div>
  );
}
