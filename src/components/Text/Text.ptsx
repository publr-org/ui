// Closed typography primitive. One declarative PTSX tree covers the finite
// semantic roots supported by both the DOM and ZSX/Zig targets.
import { Dynamic } from "publr-jsx";

export const TEXT_ELEMENTS = [
  "span",
  "p",
  "strong",
  "label",
  "output",
  "h1",
  "h2",
  "h3",
  "h4",
  "h5",
  "h6",
  "dt",
  "dd",
] as const;

export const TEXT_VARIANTS = {
  "heading-2xl": "text-3xl leading-9 font-semibold tracking-tight",
  "heading-xl": "text-[28px] leading-8 font-semibold tracking-heading-xl",
  "heading-lg": "text-xl leading-7 font-semibold tracking-heading-lg",
  "heading-md": "text-lg leading-6 font-semibold",
  "heading-sm": "text-heading-sm font-semibold",
  "heading-xs": "text-sm leading-5 font-semibold",
  "body-xl": "text-lg leading-7 font-normal",
  "body-lg": "text-base leading-6 font-normal",
  "body-md": "text-sm leading-5 font-normal",
  "body-sm": "text-body-sm font-normal",
  "body-xs": "text-2xs leading-4 font-normal",
  "mono-sm": "font-mono text-body-sm",
  "mono-xs": "font-mono text-2xs leading-4",
  eyebrow: "text-xs leading-4 font-semibold uppercase tracking-eyebrow",
  "eyebrow-xs": "text-3xs leading-4 font-semibold uppercase tracking-widest",
} as const;

export const TEXT_TONES = {
  default: "",
  muted: "text-muted-foreground",
  accent: "text-primary",
  success: "text-success",
  warning: "text-warning",
  error: "text-destructive",
} as const;

export type TextVariant = keyof typeof TEXT_VARIANTS;
export type TextTone = keyof typeof TEXT_TONES;
export type TextElement = (typeof TEXT_ELEMENTS)[number];
export type TextStyleValue =
  string | number | null | undefined | false | (() => string | number | null | undefined | false);
export type TextStyle = string | Record<string, TextStyleValue>;

export type TextProps = {
  as?: TextElement;
  children?: JSX.Element;
  classes?: string;
  id?: string;
  style?: TextStyle;
  tone?: TextTone;
  variant: TextVariant;
};

export function Text({
  as = "span",
  children,
  classes = "",
  id,
  style,
  tone = "default",
  variant,
}: TextProps) {
  return (
    <Dynamic
      as={as}
      id={id}
      class={[TEXT_VARIANTS[variant], TEXT_TONES[tone], classes]}
      data-text-variant={variant}
      data-text-tone={tone}
      style={style}
    >
      {children}
    </Dynamic>
  );
}
