// One field made of an Input and the fixed text around it: a leading part such as
// `https://` or the site's address, and a trailing part such as the rest of a URL
// pattern. The group draws the border, the shadow and the focus ring; the Input inside
// is `inset` so it draws none of its own. Plain layout: no state, no script.
import { Code } from "../Code/Code.ptsx";
import { Text } from "../Text/Text.ptsx";

export type InputGroupProps = {
  children?: JSX.Element;
  classes?: string;
  id?: string;
  invalid?: boolean;
  /** Fixed text before the input, in the muted tone: a scheme, an address. */
  leading?: string;
  /** Fixed text after the input, set as code: the rest of a pattern, `/{slug}`. */
  trailing?: string;
  /** Fixed text after the input, in the muted tone like `leading`: a unit, `kg`. */
  trailing_text?: string;
};

export function InputGroup({
  children,
  classes = "",
  id,
  invalid = false,
  leading,
  trailing,
  trailing_text,
}: InputGroupProps) {
  return (
    <div
      id={id}
      class={[
        "flex w-full items-stretch overflow-hidden rounded-lg border bg-card shadow-xs transition duration-150 hover:border-muted-foreground/40 focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/15",
        invalid ? "border-destructive" : "border-input",
        classes,
      ]}
      data-part="input-group"
    >
      {leading && (
        <Text
          as="span"
          variant="body-lg"
          tone="muted"
          classes="flex shrink-0 items-center border-r border-input bg-muted/40 px-3.5"
        >
          {leading}
        </Text>
      )}
      {children}
      {trailing && (
        <span class="flex shrink-0 items-center pr-2">
          <Code>{trailing}</Code>
        </span>
      )}
      {trailing_text && (
        <Text
          as="span"
          variant="body-lg"
          tone="muted"
          classes="flex shrink-0 items-center border-l border-input bg-muted/40 px-3.5"
        >
          {trailing_text}
        </Text>
      )}
    </div>
  );
}
