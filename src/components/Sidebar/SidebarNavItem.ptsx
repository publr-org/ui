// Dense h-7 context-nav row: a real anchor (APG link pattern) with the
// active link announced via aria-current="page". No menu or tree roles —
// site navigation is a labeled landmark of links. Children compose an
// optional leading Icon before the label. Rows live on the sidebar surface,
// so they colour themselves from the sidebar tokens only. An app that
// navigates by state (the design builder) gives `onClick` and no `href`: the
// row is a button then, the same row, its current one aria-current="true". A
// row inside a form (picking which app the admin shows) is its submit button.
import { Dynamic } from "publr-jsx";

export type SidebarNavItemProps = {
  active?: boolean;
  children?: JSX.Element;
  classes?: string;
  href?: string;
  id?: string;
  onClick?: (event: MouseEvent) => void;
  /** Without `href`: `submit` sends the form the row is in. */
  type?: "button" | "submit";
  /** With `href`: `_blank` for a row that leaves the admin, like a site. */
  target?: "_blank";
};

export function SidebarNavItem({
  active = false,
  children,
  classes = "",
  href,
  id,
  onClick,
  type = "button",
  target,
}: SidebarNavItemProps) {
  return (
    <Dynamic
      as={href === undefined ? "button" : "a"}
      id={id}
      href={href}
      target={href === undefined ? undefined : target}
      type={href === undefined ? type : undefined}
      onClick={onClick}
      aria-current={active ? (href === undefined ? "true" : "page") : undefined}
      class={[
        "my-px flex h-7 w-full cursor-pointer items-center gap-2.5 rounded-lg border-0 px-2.5 text-left text-body-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sidebar-ring",
        active
          ? "bg-sidebar-accent text-sidebar-accent-foreground"
          : "bg-transparent text-sidebar-foreground hover:bg-sidebar-accent/50",
        classes,
      ]}
    >
      {children}
    </Dynamic>
  );
}
