// A small icon button at the end of a context-nav row: hidden until the row (a `group`)
// is hovered or the button focused, always shown while `on` (a toggle that is set, such
// as a pin). A real button, named by `label`, its state announced with aria-pressed.
import { Icon } from "../Icon/Icon.ptsx";
import type { IconName } from "../Icon/Icon.ptsx";

export type SidebarNavActionProps = {
  label: string;
  icon: IconName;
  on?: boolean;
  type?: "button" | "submit";
  classes?: string;
};

export function SidebarNavAction({
  label,
  icon,
  on = false,
  type = "submit",
  classes = "",
}: SidebarNavActionProps) {
  return (
    <button
      type={type}
      aria-label={label}
      title={label}
      aria-pressed={on ? "true" : "false"}
      class={[
        "inline-flex size-6 shrink-0 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent p-0 transition focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-sidebar-ring hover:bg-sidebar-accent/50",
        on
          ? "text-sidebar-accent-foreground opacity-100"
          : "text-sidebar-foreground/60 opacity-0 group-hover:opacity-100 hover:text-sidebar-foreground",
        classes,
      ]}
    >
      <Icon name={icon} size="xs" />
    </button>
  );
}
