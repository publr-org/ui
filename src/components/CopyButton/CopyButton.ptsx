// A button that copies text it does not show, such as a prompt to paste elsewhere. Where the
// clipboard API is refused (a plain-http address), the text is selected from a hidden copy
// and copied.
import { Publr } from "publr-jsx";
import { Button } from "../Button/Button.ptsx";
import { Icon } from "../Icon/Icon.ptsx";

export const state = Publr.reactive({
  text: "",
  copied: false,
});

const hidden = Publr.ref();

const copy_selected = () => {
  const element = hidden.current as HTMLElement | null;
  const selection = window.getSelection();
  if (!element || !selection) return;
  selection.selectAllChildren(element);
  state.copied = document.execCommand("copy");
  selection.removeAllRanges();
};

export const copy = () => {
  if (!navigator.clipboard || !window.isSecureContext) {
    copy_selected();
    return;
  }
  navigator.clipboard.writeText(state.text).then(
    () => {
      state.copied = true;
    },
    copy_selected,
  );
};

Publr.effect(() => {
  if (!state.copied) return;
  const timer = window.setTimeout(() => {
    state.copied = false;
  }, 2000);
  return () => window.clearTimeout(timer);
});

export type CopyButtonProps = {
  /** What is copied, exactly. */
  text: string;
  /** What the button says before it is pressed. */
  children: string;
  hierarchy?: "primary" | "secondary" | "tertiary";
  size?: "sm" | "md";
  classes?: string;
};

export function CopyButton({
  text,
  children,
  hierarchy = "secondary",
  size = "md",
  classes = "",
}: CopyButtonProps) {
  state.text = text;

  return (
    <span class={["inline-flex", classes]} data-part="copy-button">
      <Button type="button" hierarchy={hierarchy} size={size} onClick={copy}>
        {state.copied ? <Icon name="check" size="sm" /> : <Icon name="copy" size="sm" />}
        {state.copied ? Publr.t("Copied") : children}
      </Button>
      <span ref={hidden} class="sr-only whitespace-pre-wrap" aria-hidden="true">
        {state.text}
      </span>
    </span>
  );
}
