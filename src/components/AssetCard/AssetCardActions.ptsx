// Buttons in a card's top-right corner over its preview: taking a file out of a field,
// replacing it. Hidden until the card is hovered or one of them holds focus, so keyboard
// use never depends on hover. Compose small Buttons as the children.

export type AssetCardActionsProps = {
  children?: JSX.Element;
  classes?: string;
  id?: string;
};

export function AssetCardActions({ children, classes = "", id }: AssetCardActionsProps) {
  return (
    <span
      id={id}
      class={[
        "absolute right-2 top-2 z-20 flex gap-1 opacity-0 transition-opacity focus-within:opacity-100 group-hover/asset-card:opacity-100",
        classes,
      ]}
    >
      {children}
    </span>
  );
}
