// The card's primary line — a truncated filename. Deliberately dense
// bare-text treatment (12px medium) so tight grids stay one line.

export type AssetCardTitleProps = {
  children?: JSX.Element;
  classes?: string;
  id?: string;
  /** `overlay` sits on the preview, inside an AssetCardCaption. */
  tone?: "default" | "overlay";
};

export function AssetCardTitle({ children, classes = "", id, tone = "default" }: AssetCardTitleProps) {
  return (
    <span
      id={id}
      class={[
        "block truncate text-xs font-medium",
        tone === "overlay" ? "text-white" : "text-foreground",
        classes,
      ]}
    >
      {children}
    </span>
  );
}
