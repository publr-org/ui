// The lines of a tree in the indent before a row, drawn as git graphs draw branches: one
// 20px column per level, its lane 8px in, under the icon of the row the level belongs to.
// Each column is `none`; `pass` (an ancestor's line runs through); `tee` (a line runs through
// and turns into this row: more siblings follow); `elbow` (the last child: the line turns
// into this row and ends); or `stem` (this row's own lane: a dot below its icon where its
// children's line starts). A line arriving at a row ends in a dot. Grey, never coloured.
// The parent positions it: it fills the parent's height from its left edge, so the parent is
// `relative`, and its content is indented 20px per level with the icon first.

export const TREE_GUIDE_KINDS = ["none", "pass", "tee", "elbow", "stem"] as const;
export const TREE_GUIDE_EXTENDS = ["none", "table-cell", "list"] as const;

export type TreeGuideKind = (typeof TREE_GUIDE_KINDS)[number];
export type TreeGuideExtend = (typeof TREE_GUIDE_EXTENDS)[number];

export type TreeGuidesProps = {
  level_1?: TreeGuideKind;
  level_2?: TreeGuideKind;
  level_3?: TreeGuideKind;
  level_4?: TreeGuideKind;
  /** Reach past the parent's own padding to meet the rows around it: `table-cell` for the
   * content of a TableCell, `list` for a list whose items have a small gap between them. */
  extend?: TreeGuideExtend;
  classes?: string;
};

const EXTEND_CLASSES: Record<TreeGuideExtend, string> = {
  none: "inset-y-0",
  "table-cell": "-top-3.5 -bottom-3.5",
  list: "-top-0.5 bottom-0",
};

// The vertical part: through the whole row; from the top into the row for the last child;
// from below the row's icon to the bottom for its own children.
const VERTICAL_CLASSES: Record<TreeGuideKind, string> = {
  none: "hidden",
  pass: "top-0 bottom-0",
  tee: "top-0 bottom-0",
  elbow: "top-0 h-1/2 right-1 rounded-bl-md border-b",
  stem: "top-1/2 bottom-0 mt-3",
};

const TICK_CLASSES: Record<TreeGuideKind, string> = {
  none: "hidden",
  pass: "hidden",
  tee: "",
  elbow: "hidden",
  stem: "hidden",
};

const ARRIVAL_CLASSES: Record<TreeGuideKind, string> = {
  none: "hidden",
  pass: "hidden",
  tee: "",
  elbow: "",
  stem: "hidden",
};

const FORK_CLASSES: Record<TreeGuideKind, string> = {
  none: "hidden",
  pass: "hidden",
  tee: "hidden",
  elbow: "hidden",
  stem: "",
};

export function TreeGuides({
  level_1 = "none",
  level_2 = "none",
  level_3 = "none",
  level_4 = "none",
  extend = "none",
  classes = "",
}: TreeGuidesProps) {
  return (
    <span
      aria-hidden="true"
      class={["pointer-events-none absolute left-0 flex", EXTEND_CLASSES[extend], classes]}
      data-part="tree-guides"
    >
      <span class="relative h-full w-5 shrink-0">
        <span class={["absolute left-2 border-l border-input", VERTICAL_CLASSES[level_1]]}></span>
        <span class={["absolute left-2 right-1 top-1/2 border-t border-input", TICK_CLASSES[level_1]]}></span>
        <span class={["absolute right-0.5 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-input", ARRIVAL_CLASSES[level_1]]}></span>
        <span class={["absolute left-2 top-1/2 mt-3 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-input", FORK_CLASSES[level_1]]}></span>
      </span>
      <span class="relative h-full w-5 shrink-0">
        <span class={["absolute left-2 border-l border-input", VERTICAL_CLASSES[level_2]]}></span>
        <span class={["absolute left-2 right-1 top-1/2 border-t border-input", TICK_CLASSES[level_2]]}></span>
        <span class={["absolute right-0.5 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-input", ARRIVAL_CLASSES[level_2]]}></span>
        <span class={["absolute left-2 top-1/2 mt-3 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-input", FORK_CLASSES[level_2]]}></span>
      </span>
      <span class="relative h-full w-5 shrink-0">
        <span class={["absolute left-2 border-l border-input", VERTICAL_CLASSES[level_3]]}></span>
        <span class={["absolute left-2 right-1 top-1/2 border-t border-input", TICK_CLASSES[level_3]]}></span>
        <span class={["absolute right-0.5 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-input", ARRIVAL_CLASSES[level_3]]}></span>
        <span class={["absolute left-2 top-1/2 mt-3 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-input", FORK_CLASSES[level_3]]}></span>
      </span>
      <span class="relative h-full w-5 shrink-0">
        <span class={["absolute left-2 border-l border-input", VERTICAL_CLASSES[level_4]]}></span>
        <span class={["absolute left-2 right-1 top-1/2 border-t border-input", TICK_CLASSES[level_4]]}></span>
        <span class={["absolute right-0.5 top-1/2 size-1.5 -translate-y-1/2 rounded-full bg-input", ARRIVAL_CLASSES[level_4]]}></span>
        <span class={["absolute left-2 top-1/2 mt-3 size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-input", FORK_CLASSES[level_4]]}></span>
      </span>
    </span>
  );
}
