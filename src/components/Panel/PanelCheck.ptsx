// A setting that is on or off, as a full-width outlined row: its label, and a check square
// at the end. The row is tinted while on.
import { Icon } from "../Icon/Icon.ptsx";

export type PanelCheckProps = {
  id?: string;
  label: string;
  checked: boolean;
  classes?: string;
  onClick?: (event: MouseEvent) => void;
};

export function PanelCheck({ id, label, checked, classes = "", onClick }: PanelCheckProps) {
  return (
    <button
      id={id}
      type="button"
      class={[
        "group/check flex w-full cursor-pointer items-center justify-between rounded-xs border border-input bg-card px-3 py-2.5 text-left text-body-sm font-medium text-foreground outline-ring transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 aria-[pressed=true]:border-ring/45 aria-[pressed=true]:bg-ui-accent",
        classes,
      ]}
      aria-pressed={checked}
      onClick={onClick}
    >
      {label}
      <span
        aria-hidden="true"
        class="flex size-5 items-center justify-center rounded-xs border border-input text-primary group-aria-[pressed=true]/check:border-transparent"
      >
        {checked && <Icon name="check" size="sm" />}
      </span>
    </button>
  );
}
