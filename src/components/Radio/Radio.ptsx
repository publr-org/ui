// Native radio control with the shared form treatment, drawn round. Deliberately dumb
// like Checkbox: a label or Field owns the labeling, siblings share a name, and the
// form posts the checked one's value as any radio does.
import { Dynamic } from "publr-jsx";

export type RadioProps = {
  id?: string;
  name: string;
  value: string;
  checked?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  required?: boolean;
  classes?: string;
  onChange?: (event: Event) => void;
};

export function Radio({
  id,
  name,
  value,
  checked = false,
  disabled = false,
  invalid = false,
  required = false,
  classes = "",
  onChange,
}: RadioProps) {
  return (
    <Dynamic
      as="input"
      type="radio"
      id={id}
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      required={required}
      aria-invalid={invalid}
      class={[
        "size-4 shrink-0 cursor-pointer rounded-full border bg-card text-primary accent-primary shadow-xs transition duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/15 disabled:cursor-not-allowed disabled:opacity-50",
        invalid ? "border-destructive" : "border-input",
        classes,
      ]}
      onChange={onChange}
    />
  );
}
