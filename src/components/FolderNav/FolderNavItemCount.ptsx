// The row's trailing count. By default it yields to the row's revealed
// actions (hidden on row hover/focus-within); `persistent` keeps it visible
// for rows without actions.

export type FolderNavItemCountProps = {
  children?: JSX.Element;
  classes?: string;
  id?: string;
  persistent?: boolean;
};

export function FolderNavItemCount({
  children,
  classes = "",
  id,
  persistent = false,
}: FolderNavItemCountProps) {
  return (
    <span
      id={id}
      class={[
        "ml-auto shrink-0 text-body-sm font-normal tabular-nums text-muted-foreground",
        persistent ? "" : "group-hover/folder-row:hidden group-focus-within/folder-row:hidden group-has-[[aria-expanded=true]]/folder-row:hidden",
        classes,
      ]}
    >
      {children}
    </span>
  );
}
