// The row's navigation link — the single source of the item's current
// state via aria-current="page". A disabled entry (for example a
// depth-capped folder) omits href and renders a static span with the same
// anatomy, so it is truly inert rather than merely unclickable.
import { Dynamic } from "publr-jsx";
import { Icon } from "../Icon/Icon.ptsx";

export type FolderNavItemLinkProps = {
  children?: JSX.Element;
  classes?: string;
  current?: boolean;
  disabled?: boolean;
  href?: string;
  id?: string;
  /** Acts in the page instead of, or before, following `href`. */
  onClick?: (event: MouseEvent) => void;
  /** What it goes to, as a colour: `success` for the live one. */
  tone?: "default" | "success";
  /** Going there now: a spinner at the row's end, and the link busy. */
  busy?: boolean;
};

export function FolderNavItemLink({
  children,
  classes = "",
  current = false,
  disabled = false,
  href,
  id,
  onClick,
  tone = "default",
  busy = false,
}: FolderNavItemLinkProps) {
  return (
    <Dynamic
      as={href === undefined || disabled ? "span" : "a"}
      id={id}
      href={disabled ? undefined : href}
      aria-current={current ? "page" : undefined}
      aria-busy={busy ? "true" : undefined}
      onClick={onClick}
      class={[
        "flex min-w-0 flex-1 items-center gap-2 no-underline hover:no-underline",
        disabled
          ? "text-muted-foreground opacity-50"
          : tone === "success"
            ? current
              ? "font-medium text-success"
              : "text-success hover:text-success/80"
            : current
              ? "font-medium text-foreground"
              : "text-muted-foreground hover:text-foreground",
        classes,
      ]}
    >
      {children}
      <Icon name="loader" size="sm" classes={busy ? "ml-auto shrink-0 animate-spin" : "hidden"} />
    </Dynamic>
  );
}
