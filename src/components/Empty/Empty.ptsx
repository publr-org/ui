// Zero-data placeholder root. One centered native column; the part margins
// (description mt-2, content mt-6) own the vertical rhythm so any omitted part
// collapses cleanly. The default carries the dot mark and room to breathe; `compact`
// is for small spots (a drawer, a panel) and drops the mark.
import { EmptyMark } from "./EmptyMark.ptsx";
import { EmptyGrid } from "./EmptyGrid.ptsx";

export type EmptyProps = {
  children?: JSX.Element;
  classes?: string;
  id?: string;
  compact?: boolean;
};

export function Empty({ children, classes = "", id, compact = false }: EmptyProps) {
  return (
    <div
      id={id}
      class={[
        "relative flex flex-1 flex-col items-center justify-center px-4 text-center",
        compact ? "rounded-xl border border-dashed border-input py-10" : "overflow-hidden py-20",
        classes,
      ]}
    >
      {!compact && (
        <div class="relative mb-8">
          <EmptyGrid />
          <EmptyMark classes="relative" />
        </div>
      )}
      <div class="relative flex flex-col items-center">{children}</div>
    </div>
  );
}

export { EmptyGrid } from "./EmptyGrid.ptsx";
export { EmptyMark } from "./EmptyMark.ptsx";
export { EmptyMedia } from "./EmptyMedia.ptsx";
export { EmptyTitle } from "./EmptyTitle.ptsx";
export { EmptyDescription } from "./EmptyDescription.ptsx";
export { EmptyContent } from "./EmptyContent.ptsx";
export type { EmptyMarkProps } from "./EmptyMark.ptsx";
export type { EmptyMediaProps } from "./EmptyMedia.ptsx";
export type { EmptyTitleProps } from "./EmptyTitle.ptsx";
export type { EmptyDescriptionProps } from "./EmptyDescription.ptsx";
export type { EmptyContentProps } from "./EmptyContent.ptsx";
