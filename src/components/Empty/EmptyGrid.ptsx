// The isometric lattice behind an empty state. Its cell is the mark's slab (179.2 by
// 102.4 px: the slab's 280 by 160 units at the mark's h-32 scale). The grid is centred on the
// mark and lowered by the slab's thickness (7.68 px), so the slab's base is the tile it
// stands on: wherever the mark lands, the slab's bottom edges are grid lines that run on
// across the page. The cells around it are filled with grey that is strongest next to the
// slab and fades with distance, with a fixed per-cell variation, down to a faint floor that
// reaches the edges of the space; the lines thin away the same way, never to nothing. The
// parent is the mark's own box (relative); the root of the empty state clips what overflows.

export type EmptyGridProps = {
  classes?: string;
  id?: string;
};

export function EmptyGrid({ classes = "", id }: EmptyGridProps) {
